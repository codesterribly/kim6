[Desktop Entry]
Type=Service
Icon=preferences-system
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;video/*;
X-KDE-Protocol=file
Actions=01Settings;02About;03License;04Manual;
_X-KDE-Submenu=KIM6 — Settings/About
X-KIM6-Managed=true

[Desktop Action 02About]
Icon=help-about
_Name=About KIM6
Exec=kim_all about

[Desktop Action 03License]
Icon=text-x-generic
_Name=License
Exec=kim_all license

[Desktop Action 04Manual]
Icon=help-contents
_Name=KIM6 User Guide
Exec=kim_all manual

[Desktop Action 01Settings]
Icon=configure
_Name=Settings…
Exec=kim_all settings
