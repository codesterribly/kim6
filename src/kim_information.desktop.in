[Desktop Entry]
Type=Service
Icon=preferences-system
Name=KIMng
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;video/*;
X-KDE-Protocol=file
Actions=01Settings;02About;03License;04Manual;
_X-KDE-Submenu=KIMng - Settings/About
X-KIMng-Managed=true

[Desktop Action 02About]
Icon=help-about
_Name=About KIMng
Exec=kim_all about -- %F

[Desktop Action 03License]
Icon=text-x-generic
_Name=License
Exec=kim_all license -- %F

[Desktop Action 04Manual]
Icon=help-contents
_Name=KIMng User Guide
Exec=kim_all manual -- %F

[Desktop Action 01Settings]
Icon=configure
_Name=Settings…
Exec=kim_all settings -- %F
