[Desktop Entry]
Type=Service
Icon=mark-location
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;image/vnd.adobe.photoshop;application/x-photoshop;
X-KDE-Protocol=file
Actions=04Report;03Apply;05Reduce;07StripGPS;
_X-KDE-Submenu=KIM6 — Location/GPS
X-KIM6-Managed=true

[Desktop Action 03Apply]
Icon=mark-location
_Name=Modify GPS on Images…
Exec=kim_all location-apply -- %F

[Desktop Action 04Report]
Icon=document-properties
_Name=Inspect Location Metadata…
Exec=kim_all location-report -- %F

[Desktop Action 05Reduce]
Icon=mark-location
_Name=Approximate GPS Location…
Exec=kim_all location-reduce -- %F

[Desktop Action 07StripGPS]
Icon=document-properties
_Name=Remove GPS Metadata…
Exec=kim_all stripmeta --mode gps --interactive -- %F
