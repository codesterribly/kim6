[Desktop Entry]
Type=Service
Icon=mark-location
Name=KIMng
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;image/vnd.adobe.photoshop;application/x-photoshop;application/pdf;
X-KDE-Protocol=file
Actions=01Edit;02View;03Remove;04Reduce;
_X-KDE-Submenu=KIMng - Location/GPS
X-KIMng-Managed=true

[Desktop Action 01Edit]
Icon=document-properties
_Name=View GPS metadata
Exec=kim_all location-report -- %F

[Desktop Action 02View]
Icon=mark-location
_Name=Edit GPS metadata…
Exec=kim_all location-apply -- %F

[Desktop Action 03Remove]
Icon=document-properties
_Name=Remove GPS metadata…
Exec=kim_all stripmeta --mode gps --interactive -- %F

[Desktop Action 04Reduce]
Icon=mark-location
_Name=Reduce exact GPS location…
Exec=kim_all location-reduce -- %F
