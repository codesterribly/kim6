[
  {
    "schema": 4,
    "id": "web-export",
    "name": "Web Export",
    "media": "image",
    "steps": [
      {
        "op": "image.auto_orient"
      },
      {
        "op": "image.resize",
        "max_width": 1600,
        "max_height": 1600,
        "upscale": false
      },
      {
        "op": "image.color",
        "mode": "srgb"
      },
      {
        "op": "image.convert",
        "format": "jpeg",
        "quality": 95
      },
      {
        "op": "metadata.strip_all"
      },
      {
        "op": "metadata.creator",
        "enabled": false
      },
      {
        "op": "metadata.copyright_notice",
        "enabled": false
      },
      {
        "op": "metadata.usage_rights",
        "enabled": false
      },
      {
        "op": "file.rename_output",
        "pattern": "{filename}_web"
      }
    ],
    "destination": {
      "mode": "subfolder",
      "folder": "Web"
    },
    "description": "Prepare images for web publishing. Auto-orient, resize to fit within 1600 × 1600 pixels, convert to sRGB JPEG, remove metadata, and create renamed copies in a Web subfolder.",
    "category": "Common"
  },
  {
    "schema": 4,
    "id": "share-privately",
    "name": "Share Privately",
    "media": "image",
    "steps": [
      {
        "op": "image.auto_orient"
      },
      {
        "op": "image.resize",
        "max_width": 2048,
        "max_height": 2048,
        "upscale": false
      },
      {
        "op": "image.color",
        "mode": "srgb"
      },
      {
        "op": "image.convert",
        "format": "jpeg",
        "quality": 95
      },
      {
        "op": "metadata.strip_all"
      },
      {
        "op": "file.rename_output",
        "pattern": "{filename}_private"
      }
    ],
    "destination": {
      "mode": "subfolder",
      "folder": "Private"
    },
    "description": "Create sharing copies sized within 2048 × 2048 pixels in sRGB JPEG (quality 95) with all supported EXIF, IPTC, XMP, GPS and camera metadata removed. Does not remove information visible in the image pixels.",
    "category": "Common"
  },
  {
    "schema": 4,
    "id": "protect-sensitive-locations",
    "name": "Protect Sensitive Locations",
    "media": "image",
    "parameters": [
      {
        "id": "protection_mode",
        "label": "Location protection",
        "type": "choice",
        "required": true,
        "default": "remove",
        "choices": [
          {
            "value": "remove",
            "label": "Remove GPS coordinates"
          },
          {
            "value": "reduce",
            "label": "Reduce GPS precision"
          }
        ]
      },
      {
        "id": "precision_grid",
        "label": "Approximate location grid",
        "type": "choice",
        "required": true,
        "default": "1000",
        "choices": [
          {
            "value": "100",
            "label": "About 100 m across"
          },
          {
            "value": "1000",
            "label": "About 1 km across"
          },
          {
            "value": "5000",
            "label": "About 5 km across"
          },
          {
            "value": "10000",
            "label": "About 10 km across"
          }
        ],
        "visible_when": {
          "param": "protection_mode",
          "equals": "reduce"
        },
        "help": "Replaces exact coordinates with the grid cell center and clears altitude, direction, destination coordinates and place-name tags."
      }
    ],
    "steps": [
      {
        "op": "metadata.strip_gps",
        "enabled_when": {
          "param": "protection_mode",
          "equals": "remove"
        }
      },
      {
        "op": "metadata.reduce_gps",
        "grid": "1000",
        "bindings": {
          "grid": "precision_grid"
        },
        "enabled_when": {
          "param": "protection_mode",
          "equals": "reduce"
        }
      },
      {
        "op": "file.rename_output",
        "pattern": "{filename}_protected"
      }
    ],
    "destination": {
      "mode": "subfolder",
      "folder": "Protected Locations"
    },
    "description": "Create copies that remove GPS coordinates or reduce coordinate precision without re-encoding image pixels, while preserving unrelated photographic metadata. Does not remove identifying landmarks or location text in captions.",
    "category": "Adventure"
  },
  {
    "schema": 4,
    "id": "create-client-proofs",
    "name": "Create Client Proofs",
    "media": "image",
    "parameters": [
      {
        "id": "project_name",
        "label": "Client or project name",
        "type": "text",
        "required": false,
        "default": "",
        "help": "Optional subfolder inside Proofs (for example, Proofs/Acme). Leave blank to save directly in Proofs."
      },
      {
        "id": "max_dimension",
        "label": "Maximum image dimension",
        "type": "integer",
        "required": true,
        "default": 1600,
        "minimum": 1,
        "maximum": 20000,
        "help": "Fits both width and height within this pixel limit without enlarging smaller images."
      },
      {
        "id": "jpeg_quality",
        "label": "JPEG quality",
        "type": "integer",
        "required": true,
        "default": 95,
        "minimum": 1,
        "maximum": 100,
        "advanced": true
      },
      {
        "id": "remove_gps",
        "label": "Remove GPS metadata",
        "type": "boolean",
        "required": true,
        "default": true,
        "advanced": true,
        "help": "Removes GPS coordinates and location tags while keeping other camera and descriptive metadata."
      },
      {
        "id": "apply_attribution",
        "label": "Apply photographer attribution",
        "type": "boolean",
        "required": true,
        "default": false,
        "advanced": true,
        "help": "Turn on to write creator, copyright notice or usage rights onto the proof copies."
      },
      {
        "id": "creator",
        "label": "Creator or artist",
        "type": "text",
        "required": false,
        "default_source": "copyright.creator",
        "advanced": true,
        "visible_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "id": "copyright_notice",
        "label": "Copyright notice",
        "type": "text",
        "required": false,
        "default_source": "copyright.notice",
        "advanced": true,
        "visible_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "id": "usage_rights",
        "label": "Usage rights",
        "type": "text",
        "required": false,
        "default_source": "copyright.rights",
        "advanced": true,
        "visible_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "id": "add_watermark",
        "label": "Add watermark",
        "type": "boolean",
        "required": true,
        "default": false,
        "advanced": true,
        "help": "Turn on to add a visible text or image watermark to proof copies."
      },
      {
        "id": "watermark_type",
        "label": "Watermark type",
        "type": "choice",
        "required": true,
        "default": "text",
        "advanced": true,
        "choices": [
          {
            "value": "text",
            "label": "Text watermark"
          },
          {
            "value": "image",
            "label": "Image / logo watermark"
          }
        ],
        "visible_when": {
          "param": "add_watermark",
          "equals": true
        }
      },
      {
        "id": "watermark_text",
        "label": "Watermark text",
        "type": "text",
        "required": true,
        "default": "PROOF",
        "advanced": true,
        "visible_when": {
          "all": [
            {
              "param": "add_watermark",
              "equals": true
            },
            {
              "param": "watermark_type",
              "equals": "text"
            }
          ]
        },
        "help": "Visible text placed on each proof copy."
      },
      {
        "id": "watermark_image",
        "label": "Watermark image",
        "type": "watermark_image",
        "required": true,
        "default": "",
        "advanced": true,
        "visible_when": {
          "all": [
            {
              "param": "add_watermark",
              "equals": true
            },
            {
              "param": "watermark_type",
              "equals": "image"
            }
          ]
        },
        "help": "Choose a local PNG or other supported watermark image file."
      },
      {
        "id": "watermark_position",
        "label": "Watermark position",
        "type": "choice",
        "required": true,
        "default": "bottom_right",
        "advanced": true,
        "choices": [
          {
            "value": "top_left",
            "label": "Top left"
          },
          {
            "value": "top",
            "label": "Top center"
          },
          {
            "value": "top_right",
            "label": "Top right"
          },
          {
            "value": "left",
            "label": "Middle left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Middle right"
          },
          {
            "value": "bottom_left",
            "label": "Bottom left"
          },
          {
            "value": "bottom",
            "label": "Bottom center"
          },
          {
            "value": "bottom_right",
            "label": "Bottom right"
          }
        ],
        "visible_when": {
          "param": "add_watermark",
          "equals": true
        }
      },
      {
        "id": "watermark_opacity",
        "label": "Watermark opacity",
        "type": "integer",
        "required": true,
        "default": 65,
        "minimum": 1,
        "maximum": 100,
        "advanced": true,
        "visible_when": {
          "param": "add_watermark",
          "equals": true
        }
      },
      {
        "id": "watermark_size",
        "label": "Watermark size",
        "type": "number",
        "required": true,
        "default": 5.0,
        "minimum": 1.0,
        "maximum": 50.0,
        "advanced": true,
        "visible_when": {
          "param": "add_watermark",
          "equals": true
        },
        "help": "Percentage of the shorter image edge (font height for text, bounding box for image)."
      }
    ],
    "steps": [
      {
        "op": "image.auto_orient"
      },
      {
        "op": "image.resize",
        "max_width": 1600,
        "max_height": 1600,
        "upscale": false,
        "bindings": {
          "max_width": "max_dimension",
          "max_height": "max_dimension"
        }
      },
      {
        "op": "image.color",
        "mode": "srgb"
      },
      {
        "op": "image.overlay",
        "version": 1,
        "kind": "text",
        "source": "custom",
        "value": "PROOF",
        "logo": "",
        "anchor": "bottom_right",
        "margin": 3.0,
        "size": 5.0,
        "opacity": 65,
        "font": "DejaVu Sans",
        "color": "#ffffff",
        "bold": false,
        "italic": false,
        "assistance": "outline",
        "text_fields": null,
        "camera_fields": null,
        "bindings": {
          "value": "watermark_text",
          "anchor": "watermark_position",
          "opacity": "watermark_opacity",
          "size": "watermark_size"
        },
        "enabled_when": {
          "all": [
            {
              "param": "add_watermark",
              "equals": true
            },
            {
              "param": "watermark_type",
              "equals": "text"
            }
          ]
        }
      },
      {
        "op": "image.overlay",
        "version": 1,
        "kind": "image",
        "source": "custom",
        "value": "",
        "logo": "",
        "anchor": "bottom_right",
        "margin": 3.0,
        "size": 12.0,
        "opacity": 65,
        "font": "DejaVu Sans",
        "color": "#ffffff",
        "bold": false,
        "italic": false,
        "assistance": "outline",
        "text_fields": null,
        "camera_fields": null,
        "bindings": {
          "logo": "watermark_image",
          "anchor": "watermark_position",
          "opacity": "watermark_opacity",
          "size": "watermark_size"
        },
        "enabled_when": {
          "all": [
            {
              "param": "add_watermark",
              "equals": true
            },
            {
              "param": "watermark_type",
              "equals": "image"
            }
          ]
        }
      },
      {
        "op": "image.convert",
        "format": "jpeg",
        "quality": 95,
        "bindings": {
          "quality": "jpeg_quality"
        }
      },
      {
        "op": "metadata.strip_gps",
        "enabled_when": {
          "param": "remove_gps",
          "equals": true
        }
      },
      {
        "op": "metadata.creator",
        "value": "",
        "bindings": {
          "value": "creator"
        },
        "enabled_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "op": "metadata.copyright_notice",
        "value": "",
        "bindings": {
          "value": "copyright_notice"
        },
        "enabled_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "op": "metadata.usage_rights",
        "value": "",
        "bindings": {
          "value": "usage_rights"
        },
        "enabled_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "op": "file.rename_output",
        "pattern": "{filename}_proof"
      }
    ],
    "destination": {
      "mode": "subfolder",
      "folder": "Proofs/{param:project_name}"
    },
    "description": "Create smaller sRGB JPEG proof copies for client review, removing GPS location by default while preserving photographic and rights metadata. Optional text or image watermarking is available under Advanced settings.",
    "category": "Asset Management"
  },
