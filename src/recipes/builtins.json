  {
    "schema": 4,
    "id": "prepare-editorial-submission",
    "name": "Prepare Editorial Submission",
    "media": "image",
    "parameters": [
      {
        "id": "project_name",
        "label": "Publication or project name",
        "type": "text",
        "required": false,
        "default": "",
        "help": "Optional subfolder inside Editorial (for example, Editorial/Magazine). Leave blank to save directly in Editorial."
      },
      {
        "id": "max_dimension",
        "label": "Maximum image dimension",
        "type": "choice",
        "required": true,
        "default": "full",
        "choices": [
          {
            "value": "full",
            "label": "Full resolution (no resize)"
          },
          {
            "value": "4000",
            "label": "4000 px"
          },
          {
            "value": "3000",
            "label": "3000 px"
          },
          {
            "value": "2400",
            "label": "2400 px"
          },
          {
            "value": "2048",
            "label": "2048 px"
          },
          {
            "value": "custom",
            "label": "Custom pixel limit"
          }
        ],
        "help": "Keep full resolution or fit within a maximum pixel limit without enlarging smaller images."
      },
      {
        "id": "custom_max_dimension",
        "label": "Custom maximum dimension",
        "type": "integer",
        "required": true,
        "default": 3000,
        "minimum": 1,
        "maximum": 100000,
        "visible_when": {
          "param": "max_dimension",
          "equals": "custom"
        },
        "help": "Fits both width and height within this pixel limit without enlarging smaller images."
      },
      {
        "id": "jpeg_quality",
        "label": "JPEG quality",
        "type": "integer",
        "required": true,
        "default": 95,
        "minimum": 1,
        "maximum": 100,
        "advanced": true
      },
      {
        "id": "apply_attribution",
        "label": "Apply photographer attribution",
        "type": "boolean",
        "required": true,
        "default": false,
        "advanced": true,
        "help": "Turn on to write creator, copyright notice or usage rights. Existing attribution is preserved when left off."
      },
      {
        "id": "creator",
        "label": "Creator or artist",
        "type": "text",
        "required": false,
        "default_source": "copyright.creator",
        "advanced": true,
        "visible_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "id": "copyright_notice",
        "label": "Copyright notice",
        "type": "text",
        "required": false,
        "default_source": "copyright.notice",
        "advanced": true,
        "visible_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "id": "usage_rights",
        "label": "Usage rights",
        "type": "text",
        "required": false,
        "default_source": "copyright.rights",
        "advanced": true,
        "visible_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "id": "caption",
        "label": "Caption or description",
        "type": "text",
        "required": false,
        "default": "",
        "advanced": true,
        "help": "Optional caption or description (XMP-dc:Description and IPTC:Caption-Abstract). Leave blank to preserve existing descriptions."
      },
      {
        "id": "keyword_mode",
        "label": "Keyword handling",
        "type": "choice",
        "required": true,
        "default": "unchanged",
        "advanced": true,
        "choices": [
          {
            "value": "unchanged",
            "label": "Leave unchanged"
          },
          {
            "value": "append",
            "label": "Append keywords"
          },
          {
            "value": "replace",
            "label": "Replace keywords"
          }
        ]
      },
      {
        "id": "keywords",
        "label": "Keywords",
        "type": "text",
        "required": false,
        "default": "",
        "advanced": true,
        "visible_when": {
          "param": "keyword_mode",
          "in": [
            "append",
            "replace"
          ]
        },
        "help": "Separate multiple keywords with commas or semicolons (for example, travel, malta, editorial)."
      }
    ],
    "steps": [
      {
        "op": "image.auto_orient"
      },
      {
        "op": "image.resize",
        "max_width": 4000,
        "max_height": 4000,
        "upscale": false,
        "enabled_when": {
          "param": "max_dimension",
          "equals": "4000"
        }
      },
      {
        "op": "image.resize",
        "max_width": 3000,
        "max_height": 3000,
        "upscale": false,
        "enabled_when": {
          "param": "max_dimension",
          "equals": "3000"
        }
      },
      {
        "op": "image.resize",
        "max_width": 2400,
        "max_height": 2400,
        "upscale": false,
        "enabled_when": {
          "param": "max_dimension",
          "equals": "2400"
        }
      },
      {
        "op": "image.resize",
        "max_width": 2048,
        "max_height": 2048,
        "upscale": false,
        "enabled_when": {
          "param": "max_dimension",
          "equals": "2048"
        }
      },
      {
        "op": "image.resize",
        "max_width": 3000,
        "max_height": 3000,
        "upscale": false,
        "bindings": {
          "max_width": "custom_max_dimension",
          "max_height": "custom_max_dimension"
        },
        "enabled_when": {
          "param": "max_dimension",
          "equals": "custom"
        }
      },
      {
        "op": "image.color",
        "mode": "srgb"
      },
      {
        "op": "image.convert",
        "format": "jpeg",
        "quality": 95,
        "bindings": {
          "quality": "jpeg_quality"
        }
      },
      {
        "op": "metadata.creator",
        "value": "",
        "bindings": {
          "value": "creator"
        },
        "enabled_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "op": "metadata.copyright_notice",
        "value": "",
        "bindings": {
          "value": "copyright_notice"
        },
        "enabled_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "op": "metadata.usage_rights",
        "value": "",
        "bindings": {
          "value": "usage_rights"
        },
        "enabled_when": {
          "param": "apply_attribution",
          "equals": true
        }
      },
      {
        "op": "metadata.set_description",
        "value": "",
        "bindings": {
          "value": "caption"
        }
      },
      {
        "op": "metadata.set_keywords",
        "mode": "unchanged",
        "keywords": "",
        "bindings": {
          "mode": "keyword_mode",
          "keywords": "keywords"
