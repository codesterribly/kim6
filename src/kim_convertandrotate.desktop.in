[Desktop Entry]
Type=Service
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;
X-KDE-Protocol=file
Actions=ConvertJPG;ConvertPNG;ConvertGIF;ConvertBMP;ConvertTIFF;ConvertPDF;ConvertWEBP;ConvertAVIF;ConvertCustom;Rotateexif;Rotate90;Rotate180;Rotate270;RotateCustom;FlipVertical;FlipHorizontal;
_X-KDE-Submenu=KIM6 — Convert and transform
X-KIM6-Managed=true

[Desktop Action ConvertJPG]
_Name=Convert to JPEG
Exec=kim_all convert --format jpg -- %F

[Desktop Action ConvertPNG]
_Name=Convert to PNG
Exec=kim_all convert --format png -- %F

[Desktop Action ConvertGIF]
_Name=Convert to GIF
Exec=kim_all convert --format gif -- %F

[Desktop Action ConvertBMP]
_Name=Convert to BMP5 bitmap
Exec=kim_all convert --format bmp --bmp5 -- %F

[Desktop Action ConvertTIFF]
_Name=Convert to TIFF
Exec=kim_all convert --format tiff -- %F

[Desktop Action ConvertPDF]
_Name=Convert to PDF
Exec=kim_all convert --format pdf -- %F

[Desktop Action ConvertWEBP]
_Name=Convert to WebP
Exec=kim_all convert --format webp -- %F

[Desktop Action ConvertAVIF]
_Name=Convert to AVIF
Exec=kim_all convert --format avif -- %F

[Desktop Action ConvertCustom]
_Name=Convert to custom format…
Exec=kim_all convert --custom-format -- %F

[Desktop Action Rotateexif]
_Name=Auto-rotate using EXIF
Exec=kim_all rotate --exif -- %F

[Desktop Action Rotate90]
_Name=Rotate 90°
Exec=kim_all rotate --angle 90 -- %F

[Desktop Action Rotate180]
_Name=Rotate 180°
Exec=kim_all rotate --angle 180 -- %F

[Desktop Action Rotate270]
_Name=Rotate 270°
Exec=kim_all rotate --angle 270 -- %F

[Desktop Action RotateCustom]
_Name=Rotate custom angle…
Exec=kim_all rotate --custom -- %F

[Desktop Action FlipVertical]
_Name=Flip vertically
Exec=kim_all flipflop flip -- %F

[Desktop Action FlipHorizontal]
_Name=Flip horizontally
Exec=kim_all flipflop flop -- %F
