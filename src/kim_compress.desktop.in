[Desktop Entry]
Type=Service
Name=KIM6 JPEG compression
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/jpeg;
X-KDE-Protocol=file
Actions=Compress10;Compress30;Compress50;Compress70;Compress90;CompressCustom;
_X-KDE-Submenu=KIM6 — JPEG compression
X-KIM6-Managed=true

[Desktop Action Compress10]
_Name=Compress at 10 %
Exec=kim_all compress --quality 10 -- %F

[Desktop Action Compress30]
_Name=Compress at 30 %
Exec=kim_all compress --quality 30 -- %F

[Desktop Action Compress50]
_Name=Compress at 50 %
Exec=kim_all compress --quality 50 -- %F

[Desktop Action Compress70]
_Name=Compress at 70 %
Exec=kim_all compress --quality 70 -- %F

[Desktop Action Compress90]
_Name=Compress at 90 %
Exec=kim_all compress --quality 90 -- %F

[Desktop Action CompressCustom]
_Name=Compress at custom quality…
Exec=kim_all compress --custom -- %F
