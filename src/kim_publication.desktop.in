[Desktop Entry]
Type=Service
Icon=document-new
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;
X-KDE-Protocol=file
Actions=Album;Animation;Collage;ContactSheet;Gallery;Print;Slideshow;TiffJoin;Emailfull;
_X-KDE-Submenu=KIM6 — Create/Publish
X-KIM6-Managed=true

[Desktop Action Album]
_Name=Create a PDF album…
Exec=kim_all album -- %F

[Desktop Action Animation]
_Name=Create an animated GIF…
Exec=kim_all animate -- %F

[Desktop Action Collage]
_Name=Create a photo collage…
Exec=kim_all pelemele -- %F

[Desktop Action ContactSheet]
_Name=Create a photo contact sheet…
Exec=kim_all contactsheet -- %F

[Desktop Action Gallery]
_Name=Create an HTML gallery…
Exec=kim_all gallery -- %F

[Desktop Action Print]
_Name=Create a print-layout PDF…
Exec=kim_all print -- %F

[Desktop Action Slideshow]
_Name=Create a video slideshow…
Exec=kim_all slideshow --interactive -- %F

[Desktop Action TiffJoin]
_Name=Create a multi-page TIFF…
Exec=kim_all tiffjoin -- %F

[Desktop Action Emailfull]
_Name=Send via email…
Exec=kim_all resizeandsend --size full -- %F
