[Desktop Entry]
Type=Service
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;
X-KDE-Protocol=file
Actions=Gallery;Collage;Rename;SortByDate;StripMetadata;Album;Print;TiffJoin;Animation;Manual;License;About;
_X-KDE-Submenu=KIM6 — Publish and organize
X-KIM6-Managed=true

[Desktop Action Gallery]
_Name=Create an HTML gallery…
Exec=kim_all gallery -- %F

[Desktop Action Collage]
_Name=Create a photo collage…
Exec=kim_all pelemele -- %F

[Desktop Action Rename]
_Name=Rename images…
Exec=kim_all rename interactive -- %F

[Desktop Action SortByDate]
_Name=Rename by EXIF date…
Exec=kim_all rename exifdate -- %F

[Desktop Action StripMetadata]
_Name=Strip metadata…
Exec=kim_all stripmeta -- %F

[Desktop Action Album]
_Name=Create a PDF album…
Exec=kim_all album -- %F

[Desktop Action Print]
_Name=Create a print-layout PDF…
Exec=kim_all print -- %F

[Desktop Action TiffJoin]
_Name=Join images into a multi-page TIFF…
Exec=kim_all tiffjoin -- %F

[Desktop Action Animation]
_Name=Create an animated GIF…
Exec=kim_all animate -- %F

[Desktop Action Manual]
_Name=KIM6 Manual
Exec=kim_all manual

[Desktop Action License]
_Name=License
Exec=kim_all license

[Desktop Action About]
_Name=About KIM6
Exec=kim_all about
