# ---------------------------------------------------------------------------
# Project intent
# ---------------------------------------------------------------------------
# The goal of this script is to consolidate the useful kim_* scripts into
# a single, unified entry point. This allows the design to evolve and
# modernize while sharing common helper functions for tasks that every
# script needs, such as:
#   - counting files and directories
#   - validating inputs
#   - creating and cleaning up temporary work directories
#
# Centralizing this logic also makes the codebase easier to hack on and
# develop, without having to duplicate or synchronize changes across
# many separate scripts.

# ---------------------------------------------------------------------------
# Planned work
# ---------------------------------------------------------------------------
# 1) Integrate with krename for advanced renaming workflows.
#    krename is already extremely powerful, so the intent is to either:
#      - pre-load a few common krename presets, or
#      - simply launch krename directly when appropriate.
#
# 2) Improve how rename operations mark modified files.
#    For example, controlling whether tags like "_stripped" or "_web"
#    are prepended or appended, which is useful for workflows that
#    prefer prefixes over suffixes (or vice versa).

# ---------------------------------------------------------------------------
# Work-in-progress notes
# ---------------------------------------------------------------------------
# THIS IS A WORK IN PROGRESS.
# Suggestions are welcome, but expect rapid iteration and change.

# Some scripts are intentionally not integrated at this time, either
# because they appear unused or because their functionality is better
# handled elsewhere:
#
# - kim_rotatewithexif
#   Despite the name, this script does not actually rotate based on EXIF.
#   It simply applies a custom rotation angle, which is already handled
#   by action_rotate. EXIF-based auto-orientation is implemented instead
#   in action_rotatewithexif.
#
# - kim_multiburst
#   Handles legacy Sony multi-shot images by converting them into an
#   animated GIF. This is a niche feature and is being deferred.
#
# - kim_sortbydate
#   A rename script with a hard-coded EXIF date pattern. This behavior
#   is better handled as part of action_rename (or via krename), and
#   equivalent EXIF-based rename options have been integrated there.
#
# - kim_treatment
#   Provides very basic image treatments (for example sepia) that are
#   easily achievable, and often better handled, in dedicated graphics
#   applications.

# TODO re-enable when ready for testing
#SOURCE_TRANSLATION_TTT

set -euo pipefail

PROG="kim_all"

# Print an error and exit.
die() { echo "ERROR: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Temp workspace
# ---------------------------------------------------------------------------

# One temp folder per run, always cleaned up on exit.
mk_workdir() {
  KIMDIR="$(mktemp -d /tmp/kim.XXXXXXXX)" || die "mktemp failed"
  trap 'progress_cleanup; cleanup_stages; rm -rf -- "$KIMDIR"' EXIT
}

# ---------------------------------------------------------------------------
# Configuration (KConfig file, env overrides)
# ---------------------------------------------------------------------------

# KIM uses a shared config file
#   ${XDG_CONFIG_HOME:-~/.config}/kim_kdeimagemenu   group "<default>"
#
# Env vars always win over config values.

KIM_CONFIG_FILE="${KIM_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/kim_kdeimagemenu}"

_cfg_get() {
  local key="$1"
  command -v kreadconfig6 >/dev/null 2>&1 || return 0
  [ -f "$KIM_CONFIG_FILE" ] || return 0
  kreadconfig6 --file "$KIM_CONFIG_FILE" --group "<default>" --key "$key" 2>/dev/null || true
}

load_kim_config() {
  local v

  # Naming: prefix or suffix for web/compressed/resized/stripped outputs.
  # Env: KIM_NAME_AFFIX_POSITION=prefix|suffix
  if [ -z "${KIM_NAME_AFFIX_POSITION:-}" ]; then
    v="$(_cfg_get NAME_AFFIX_POSITION)"
    case "$v" in
      prefix|suffix) KIM_NAME_AFFIX_POSITION="$v" ;;
    esac
  fi
  : "${KIM_NAME_AFFIX_POSITION:=suffix}"

  # Webexport quality default (only used as the default value in the prompt here).
  # Env: KIM_WEB_QUALITY=1..100
  if [ -z "${KIM_WEB_QUALITY:-}" ]; then
    v="$(_cfg_get WEB_EXPORT_QUALITY)"
    if [[ "$v" =~ ^[0-9]{1,3}$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 100 ]; then
      KIM_WEB_QUALITY="$v"
    fi
  fi

  : "${KIM_WEB_QUALITY:=75}"

  # Webexport output format (create mode).
  # Env: KIM_WEB_FORMAT=jpg|webp|avif|keep
  if [ -z "${KIM_WEB_FORMAT:-}" ]; then
    v="$(_cfg_get WEB_EXPORT_FORMAT)"
    case "$v" in
      jpg|jpeg|webp|avif|keep) KIM_WEB_FORMAT="$v" ;;
    esac
  fi
  : "${KIM_WEB_FORMAT:=jpg}"

  # Policy mode from config (optional), only used if no env override exists.
  # Env: KIM_POLICY
  if [ -z "${KIM_POLICY:-}" ]; then
    v="$(_cfg_get KIM_POLICY)"
    case "$v" in
      create|overwrite) KIM_CFG_POLICY="$v" ;;
    esac
  fi
}

# ---------------------------------------------------------------------------
# Policy handling
# ---------------------------------------------------------------------------

# KIM_POLICY=create skips the overwrite dialog (always create new files).
# KIM_POLICY=overwrite skips the dialog and overwrites originals.
# Anything else keeps the default prompt.
policy_mode() {
  local p="${KIM_POLICY:-${KIM_CFG_POLICY:-}}"

  case "$p" in
    create) echo "create" ;;
    overwrite) echo "overwrite" ;;
    *) echo "prompt" ;;
  esac
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Count only real files from Dolphin selection.
count_valid_files() {
  local n=0 i
  for i in "$@"; do
    [ -f "$i" ] && n=$((n + 1))
  done
  echo "$n"
}

# Build an array of only real files from the Dolphin selection.
# Usage: collect_valid_files <arrayname> <args...>
collect_valid_files() {
  local outvar="$1"
  shift || true

  # Bash nameref to fill caller-provided array
  local -n out_arr="$outvar"
  out_arr=()

  local i
  for i in "$@"; do
    [ -f "$i" ] && out_arr+=("$i")
  done
}


# ---------------------------------------------------------------------------
# Extra helpers (mode selection, path parsing, metadata, reporting)
# ---------------------------------------------------------------------------

# Choose how to output results: create or overwrite.
# Echoes: create | overwrite | cancel
# Respects KIM_POLICY=create|overwrite.
choose_output_mode() {
  local title="$1"
  local prompt="$2"

  case "$(policy_mode)" in
    create)  echo "create"; return 0 ;;
    overwrite) echo "overwrite"; return 0 ;;
  esac

  kdialog --title "$title" \
    --yesnocancel "$prompt" \
    --yes-label "$(gettext 'Create new')" \
    --no-label  "$(gettext 'Overwrite existing')"

  case $? in
    0) echo "create" ;;
    1) echo "overwrite" ;;
    *) echo "cancel" ;;
  esac
}

# Split a path into dir/base/stem/ext.
# Prints 4 lines: dir, base, stem, ext (ext without dot, empty if none)
split_path() {
  local p="$1"
  local dir base stem ext

  dir="$(dirname -- "$p")"
  base="$(basename -- "$p")"

  # Leading dotfile with no other dots has no extension (e.g. ".bashrc").
  if [[ "$base" == .* && "$base" != *.*.* ]]; then
    stem="$base"
    ext=""
  elif [[ "$base" == *.* ]]; then
    stem="${base%.*}"
    ext="${base##*.}"
  else
    stem="$base"
    ext=""
  fi

  printf '%s\n%s\n%s\n%s\n' "$dir" "$base" "$stem" "$ext"
}

# Place an action tag around the complete stem; keep numbering before the extension.
affixed_filename() {
  local stem="$1" tag="$2" ext="$3" number="${4:-}" separator="${5:-_}" name
  if [ "$KIM_NAME_AFFIX_POSITION" = "prefix" ]; then
    name="${tag}_${stem}"
  else
    name="${stem}_${tag}"
  fi
  [ -z "$number" ] || name="${name}${separator}${number}"
  [ -z "$ext" ] || name="${name}.${ext}"
  printf '%s\n' "$name"
}

# Normalize ImageMagick's common coder aliases so a file's extension can be
# checked against its encoded format without trusting the original suffix.
image_format_class() {
  case "${1^^}" in
    JPG|JPE|JFIF|JPS|PJPEG|JPEG) printf 'JPEG\n' ;;
    TIF|TIFF64|PTIF|TIFF) printf 'TIFF\n' ;;
    PNG[0-9]*|APNG|PNG) printf 'PNG\n' ;;
    BMP2|BMP3|BMP) printf 'BMP\n' ;;
    GIF87|GIF) printf 'GIF\n' ;;
    J2C|J2K|JPC|JPM|JPT|JP2) printf 'JP2\n' ;;
    *) printf '%s\n' "${1^^}" ;;
  esac
}

image_format_extension() {
  case "$(image_format_class "$1")" in
    JPEG) printf 'jpg\n' ;; TIFF) printf 'tiff\n' ;; PNG) printf 'png\n' ;;
    BMP) printf 'bmp\n' ;; GIF) printf 'gif\n' ;; JP2) printf 'jp2\n' ;;
    AVIF) printf 'avif\n' ;; HEIC) printf 'heic\n' ;; HEIF) printf 'heif\n' ;;
    PPM) printf 'ppm\n' ;; PGM) printf 'pgm\n' ;; PBM) printf 'pbm\n' ;;
    PAM) printf 'pam\n' ;; PNM) printf 'pnm\n' ;; MIFF) printf 'miff\n' ;;
    PDF) printf 'pdf\n' ;; *) printf '%s\n' "${1,,}" ;;
  esac
}

image_extension_matches_format() {
  [ -n "$1" ] && [ "$(image_format_class "$1")" = "$(image_format_class "$2")" ]
}

# Return the dimensions ImageMagick's plain `-resize WIDTHxHEIGHT` fit geometry
# should produce, without allocating a synthetic image. ImageMagick rounds the
# unconstrained dimension to the nearest integer; clamp extreme aspect ratios
# to one pixel, as its resize operation does.
resize_fit_dimensions() {
  local source_dimensions="$1" max_width="$2" max_height="$3"
  local source_width="${source_dimensions%x*}" source_height="${source_dimensions#*x}"
  local result_width result_height
  if (( max_width * source_height <= max_height * source_width )); then
    result_width="$max_width"
    result_height="$(( (source_height * max_width + source_width / 2) / source_width ))"
  else
    result_height="$max_height"
    result_width="$(( (source_width * max_height + source_height / 2) / source_height ))"
  fi
  [ "$result_width" -gt 0 ] || result_width=1
  [ "$result_height" -gt 0 ] || result_height=1
  printf '%sx%s\n' "$result_width" "$result_height"
}

oriented_image_dimensions() {
  local width="$1" height="$2" orientation="$3"
  if image_orientation_swaps_dimensions "$orientation"; then
    printf '%sx%s\n' "$height" "$width"
  else
    printf '%sx%s\n' "$width" "$height"
  fi
}

image_orientation_swaps_dimensions() {
  case "$1" in
    LeftTop|RightTop|RightBottom|LeftBottom) return 0 ;;
    *) return 1 ;;
  esac
}

# Best-effort: copy timestamps and permissions (mode) from src to dst.
preserve_meta_from() {
  local src="$1"
  local dst="$2"

  touch -r "$src" "$dst" >/dev/null 2>&1 || true
  chmod --reference="$src" "$dst" >/dev/null 2>&1 || true
}


# Allocations may occur in command substitutions: persist ownership in KIMDIR.
# The token also prevents cleanup of a later directory reusing the same inode.
register_stage_dir() {
  local stage="$1" identity
  identity="$(stat -c '%d:%i' -- "$stage")" || return 1
  printf '%s' "$KIMDIR" > "$stage/.kim6-owner" || return 1
  printf '%s\0%s\0' "$stage" "$identity" >> "$KIMDIR/stages"
}

owned_stage_dir() {
  local stage="$1" registered identity
  [ ! -L "$stage" ] && [ -d "$stage" ] || return 1
  [ ! -L "$stage/.kim6-owner" ] && [ -f "$stage/.kim6-owner" ] || return 1
  [ "$(< "$stage/.kim6-owner")" = "$KIMDIR" ] || return 1
  [ -f "$KIMDIR/stages" ] || return 1
  while IFS= read -r -d '' registered && IFS= read -r -d '' identity; do
    if [ "$stage" = "$registered" ] &&
       [ "$(stat -c '%d:%i' -- "$stage" 2>/dev/null)" = "$identity" ]; then
      return 0
    fi
  done < "$KIMDIR/stages"
  return 1
}

cleanup_stages() {
  local stage identity
  [ -f "$KIMDIR/stages" ] || return 0
  while IFS= read -r -d '' stage && IFS= read -r -d '' identity; do
    if owned_stage_dir "$stage"; then
      rm -rf -- "$stage" || true
    fi
  done < "$KIMDIR/stages"
}

# Return an unused filename in a private directory on the target filesystem.
# Resolve parent symlinks, never the final destination entry.
tmp_for_target() {
  local target="$1" parent stage base ext=""
  parent="$(cd -P -- "$(dirname -- "$target")" && pwd -P)" || return 1
  stage="$(mktemp -d "$parent/.kim6-stage.XXXXXX")" || return 1
  if ! register_stage_dir "$stage"; then
    rm -rf -- "$stage"
    return 1
  fi
  base="${target##*/}"
  if [[ "$base" == *.* && ! ( "$base" == .* && "$base" != *.*.* ) ]]; then
    ext=".${base##*.}"
  fi
  printf '%s/output%s\n' "$stage" "$ext"
}

# Accept registered stages and the private scratch files of unmigrated callers.
owned_stage_file() {
  local tmp="$1" parent workspace
  [ ! -L "$tmp" ] && [ -f "$tmp" ] || return 1
  parent="$(cd -P -- "$(dirname -- "$tmp")" && pwd -P)" || return 1
  workspace="$(cd -P -- "$KIMDIR" && pwd -P)" || return 1
  [ "$parent" = "$workspace" ] || owned_stage_dir "$parent"
}

# Two arguments retain create-only publication. Overwrite must be explicit.
# Atomic visibility only; no crash-durability or hostile-writer guarantee.
commit_tmp_to_target() {
  local tmp="$1" target="$2" mode="${3:-create}" parent lock source_device target_device
  case "$mode" in create|overwrite) : ;; *) return 1 ;; esac
  owned_stage_file "$tmp" || return 1
  parent="$(cd -P -- "$(dirname -- "$target")" && pwd -P)" || return 1
  target="$parent/${target##*/}"
  source_device="$(stat -c '%d' -- "$tmp")" || return 1
  target_device="$(stat -c '%d' -- "$parent")" || return 1
  [ "$source_device" = "$target_device" ] || return 1
  # Retain the directory check for existing failure-injection contracts.
  mkdir -p -- "$parent" || return 1

  if [ "$mode" = "create" ]; then
    # No check-then-move: link itself refuses ANY occupied directory entry.
    ln -T -- "$tmp" "$target" || return 1
    rm -f -- "$tmp" || true
    return 0
  fi

  # Directory locks serialize cooperative KIM publishers, not arbitrary writers.
  lock="$parent/.kim6-publish.lock"
  if (umask 077; mkdir -- "$lock") 2>/dev/null; then
    if ! register_stage_dir "$lock"; then
      rm -rf -- "$lock"
      return 1
    fi
  else
    owned_stage_dir "$lock" || return 1
  fi
  [ ! -L "$target" ] && [ -f "$target" ] || return 1
  [ "$(stat -c '%h' -- "$target")" = "1" ] || return 1
  # Prefer a rename-only move when available. Never use ordinary mv -f.
  case "$(mv --help 2>/dev/null)" in
    *--no-copy*) mv --no-copy -fT -- "$tmp" "$target"; return $? ;;
  esac
  # Audited uutils 0.12.0 dispatches --exchange directly to renameat2(EXCHANGE)
  # and returns its error without entering the move/copy code path. Restrict
  # this fallback to that verified implementation, not arbitrary future tools.
  case "$(mv --version 2>/dev/null)" in
    'mv (uutils coreutils) 0.12.0')
      if mv --exchange -T -- "$tmp" "$target"; then
        # Publication is complete. The old authorized destination now occupies
        # our private staging entry; remove it without touching the new target.
        rm -f -- "$tmp" || true
        return 0
      fi
      return 1
      ;;
    *) return 1 ;;
  esac
}

# Keep the existing metadata policy and explicit dst,tmp argument order.
atomic_overwrite_file() {
  local dst="$1" tmp="$2" parent source_device target_device
  owned_stage_file "$tmp" || return 1
  [ ! -L "$dst" ] && [ -f "$dst" ] || return 1
  parent="$(cd -P -- "$(dirname -- "$dst")" && pwd -P)" || return 1
  source_device="$(stat -c '%d' -- "$tmp")" || return 1
  target_device="$(stat -c '%d' -- "$parent")" || return 1
  if [ "$source_device" != "$target_device" ]; then
    # Unmigrated callers still produce in KIMDIR. Prepare an owned destination-
    # local copy BEFORE attempting publication; never copy into dst or recover
    # from a failed publication by copying. The original scratch file remains
    # owned by the existing workspace trap.
    local local_tmp
    local_tmp="$(tmp_for_target "$dst")" || return 1
    cp -- "$tmp" "$local_tmp" || return 1
    tmp="$local_tmp"
  fi
  preserve_meta_from "$dst" "$tmp"
  commit_tmp_to_target "$tmp" "$dst" overwrite
}

# When creating a new output from src, preserve metadata best-effort.
finalize_created_file() {
  local src="$1"
  local out_file="$2"
  preserve_meta_from "$src" "$out_file"
}

# Simple per-action reporting helpers.
report_init() {
  REPORT_OK=0
  REPORT_FAIL=0
  REPORT_FAIL_LIST=()
}

report_ok() {
  REPORT_OK=$((REPORT_OK + 1))
}

report_fail() {
  local f="$1"
  REPORT_FAIL=$((REPORT_FAIL + 1))

  # Keep list small so dialogs stay readable.
  if [ "${#REPORT_FAIL_LIST[@]}" -lt 10 ]; then
    REPORT_FAIL_LIST+=("$f")
  fi
}

# Show a summary dialog only if something failed.
report_finish_dialog() {
  local title="$1"

  if [ "${REPORT_FAIL:-0}" -le 0 ]; then
    return 0
  fi

  local msg
  msg="$(printf '%s\n\n%s %d\n%s %d' \
    "$(gettext 'Some files could not be processed.')" \
    "$(gettext 'Succeeded:')" "${REPORT_OK:-0}" \
    "$(gettext 'Failed:')" "${REPORT_FAIL:-0}")"

  if [ "${#REPORT_FAIL_LIST[@]}" -gt 0 ]; then
    msg="$msg\n\n$(gettext 'Failed files (first 10):')\n$(printf '%s\n' "${REPORT_FAIL_LIST[@]}")"
  fi

  kdialog --title "$title" --error "$(printf '%b' "$msg")"

}

# ---------------------------------------------------------------------------
# Progress dialog helpers
# ---------------------------------------------------------------------------

# Canonical internal reference: "service /object/path" on one line.
# Only horizontal separator/surrounding whitespace is accepted; D-Bus names
# and object paths cannot contain whitespace. Keep callers' scalar contract.
progress_parse_ref() {
  local ref="$1" service object
  local -n parsed_parts="$2"
  parsed_parts=()
  [[ "$ref" =~ ^[[:blank:]]*([^[:space:]]+)[[:blank:]]+([^[:space:]]+)[[:blank:]]*$ ]] || return 1
  service="${BASH_REMATCH[1]}"
  object="${BASH_REMATCH[2]}"
  [ "${#service}" -le 255 ] || return 1
  [[ "$service" =~ ^(:[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+|[A-Za-z_-][A-Za-z0-9_-]*(\.[A-Za-z_-][A-Za-z0-9_-]*)+)$ ]] || return 1
  [[ "$object" =~ ^(/|(/[A-Za-z0-9_]+)+)$ ]] || return 1
  # Output is read by the caller through this nameref.
  # shellcheck disable=SC2034
  parsed_parts=("$service" "$object")
}

progress_call() {
  local ref="$1"
  shift
  local -a parts=()
  progress_parse_ref "$ref" parts || return 1
  qdbus "${parts[@]}" "$@"
}

# 0 = service present, 1 = confirmed absent, 2 = unknown/failed ownership query.
# Absence is an interruption, not proof that the user pressed Cancel (KDE 507443).
progress_service_present() {
  local owner
  local -a parts=()
  progress_parse_ref "$1" parts || return 2
  owner="$(qdbus org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus.NameHasOwner "${parts[0]}" 2>/dev/null)" || return 2
  case "$owner" in
    true) return 0 ;;
    false) return 1 ;;
    *) return 2 ;;
  esac
}

progress_error() {
  local message="$1"
  kdialog --title "$(gettext 'Kim')" --error "$message" 2>/dev/null || printf '%s\n' "$message" >&2
}

progress_registered() {
  local ref="$1" registered
  [ -n "${KIMDIR:-}" ] && [ -f "$KIMDIR/progress.refs" ] || return 1
  while IFS= read -r registered; do
    [ "$registered" != "$ref" ] || return 0
  done < "$KIMDIR/progress.refs"
  return 1
}

# Close only a dialog opened by this invocation. Successful closes unregister
# it; failed closes stay registered for one final EXIT-cleanup retry.
progress_close() {
  local ref="$1" registered
  [ -n "$ref" ] || return 0
  local -a parts=() references=()
  progress_parse_ref "$ref" parts || return 1
  ref="${parts[0]} ${parts[1]}"
  progress_registered "$ref" || return 0
  if ! progress_call "$ref" close >/dev/null 2>&1; then
    local owner_rc=0
    progress_service_present "$ref" || owner_rc=$?
    # A vanished owned service already has no dialog to close.
    [ "$owner_rc" -eq 1 ] || return 1
  fi
  mapfile -t references < "$KIMDIR/progress.refs" || return 1
  : > "$KIMDIR/progress.refs" || return 1
  for registered in "${references[@]}"; do
    if [ "$registered" != "$ref" ]; then
      printf '%s\n' "$registered" >> "$KIMDIR/progress.refs" || return 1
    fi
  done
}

progress_cleanup() {
  local ref
  local -a references=()
  [ -n "${KIMDIR:-}" ] && [ -f "$KIMDIR/progress.refs" ] || return 0
  if ! mapfile -t references < "$KIMDIR/progress.refs"; then
    printf 'Kim: cannot read owned progress dialog registry\n' >&2
    return 0
  fi
  for ref in "${references[@]}"; do
    progress_close "$ref" || printf 'Kim: could not close owned progress dialog %s\n' "$ref" >&2
  done
}

progress_abort() {
  local ref="$1" message="$2"
  progress_error "$message"
  progress_close "$ref" || true
  return 1
}

# A failed method on a vanished service is a quiet interruption. A live
# service or unconfirmable ownership remains a distinct communication error.
progress_bus_failure() {
  local ref="$1" message="$2" owner_rc=0
  progress_service_present "$ref" || owner_rc=$?
  if [ "$owner_rc" -eq 1 ]; then
    progress_close "$ref" || true
    return 1
  fi
  progress_abort "$ref" "$message"
}

# Open, register, and initialize a cancellable dialog. Failure is fatal to the
# caller under set -e; never silently substitute a console-only workflow.
progress_open() {
  local max="$1" text="$2" ref rc=0
  local -a parts=()
  if ! command -v kdialog >/dev/null 2>&1 || ! command -v qdbus >/dev/null 2>&1; then
    progress_error "$(gettext 'KDialog or qdbus is unavailable. Processing stopped.')"
    return 1
  fi
  if [ -z "${KIMDIR:-}" ] || [ ! -d "$KIMDIR" ] ||
     ! [[ "$max" =~ ^[0-9]+$ ]] || [ "${#max}" -gt 10 ] || ((10#$max > 2147483647)); then
    progress_error "$(gettext 'Cannot initialize the progress dialog. Processing stopped.')"
    return 1
  fi
  ref="$(kdialog --progressbar "$text" "$((10#$max))" 2>/dev/null)" || rc=$?
  if ! progress_parse_ref "$ref" parts; then
    progress_error "$(gettext 'KDialog returned an invalid progress reference. Processing stopped.')"
    return 1
  fi
  ref="${parts[0]} ${parts[1]}"
  # Persist across command substitution; the parent invocation owns cleanup.
  if ! (umask 077; printf '%s\n' "$ref" >> "$KIMDIR/progress.refs"); then
    progress_call "$ref" close >/dev/null 2>&1 || true
    progress_error "$(gettext 'Cannot register the progress dialog. Processing stopped.')"
    return 1
  fi
  if [ "$rc" -ne 0 ] ||
     ! progress_call "$ref" showCancelButton true >/dev/null 2>&1 ||
     ! progress_call "$ref" org.freedesktop.DBus.Properties.Set org.kde.kdialog.ProgressDialog autoClose false >/dev/null 2>&1 ||
     ! progress_call "$ref" org.freedesktop.DBus.Properties.Set org.kde.kdialog.ProgressDialog value 0 >/dev/null 2>&1; then
    progress_bus_failure "$ref" "$(gettext 'Cannot initialize the progress dialog. Processing stopped.')"
    return 1
  fi
  printf '%s\n' "$ref"
}

# Stop-policy predicate, retaining all existing callers' boolean contract:
# 1 = confirmed false (continue); 0 = true OR unconfirmable (stop).
# A failed query checks ownership: confirmed disappearance stops quietly; a
# present service, unknown ownership or malformed reply reports an error. None
# of these failures proves user cancellation. K14 will
# consolidate the separate action-local cancellation queries.
progress_cancelled() {
  local ref="$1" cancelled
  if ! cancelled="$(progress_call "$ref" wasCancelled 2>/dev/null)"; then
    progress_bus_failure "$ref" "$(gettext 'Cannot check progress cancellation. Processing stopped.')" || true
    return 0
  fi
  case "$cancelled" in
    true) return 0 ;;
    false) return 1 ;;
    *) progress_abort "$ref" "$(gettext 'Unexpected progress cancellation reply. Processing stopped.')" || true
       return 0 ;;
  esac
}

progress_begin_item() {
  local ref="$1" text="$2"
  if progress_cancelled "$ref"; then
    progress_close "$ref" || true
    return 1
  fi
  progress_label "$ref" "$text" || return 1
}

progress_label() {
  local ref="$1" text="$2"
  if ! progress_call "$ref" setLabelText "$text" >/dev/null 2>&1; then
    progress_bus_failure "$ref" "$(gettext 'Cannot update the progress label. Processing stopped.')"
    return 1
  fi
}

progress_value() {
  local ref="$1" value="$2"
  if ! [[ "$value" =~ ^[0-9]+$ ]] || [ "${#value}" -gt 10 ] || ((10#$value > 2147483647)); then
    progress_abort "$ref" "$(gettext 'Cannot update the progress value. Processing stopped.')"
    return 1
  fi
  if ! progress_call "$ref" org.freedesktop.DBus.Properties.Set \
       org.kde.kdialog.ProgressDialog value "$((10#$value))" >/dev/null 2>&1; then
    progress_bus_failure "$ref" "$(gettext 'Cannot update the progress value. Processing stopped.')"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Actions
# ---------------------------------------------------------------------------

# Check and canonicalize one ordered image selection for a derived artifact.
# Symlinked and hardlinked selected inputs are ambiguous and are refused.
collect_publication_inputs() {
  local -n result_ref="$1"
  shift
  local raw path parent identity
  local -A seen=()
  result_ref=()
  for raw in "$@"; do
    [[ "$raw" != *$'\n'* && "$raw" != *$'\r'* ]] || return 1
    [[ "$raw" = /* ]] || raw="$PWD/$raw"
    parent="$(cd -P -- "$(dirname -- "$raw")" && printf '%s/.' "$PWD")" || return 1
    parent="${parent%/.}"
    path="$parent/${raw##*/}"
    [ ! -L "$path" ] && [ -f "$path" ] || return 1
    [ "$(stat -c '%h' -- "$path")" = 1 ] || return 1
    identity="$(stat -c '%d:%i' -- "$path")" || return 1
    [[ -z "${seen[$identity]:-}" ]] || return 1
    seen[$identity]=1
    result_ref+=("$path")
  done
  [ "${#result_ref[@]}" -gt 0 ]
}

# Resolve one explicitly selected output and choose a no-clobber destination.
# Existing targets are replaceable only with explicit overwrite policy, and
# never if they alias a selected source or have multiple hard links.
prepare_derived_target() {
  local requested="$1" extension="$2" mode="$3"
  shift 3
  local parent base stem target numbered identity source
  [[ "$requested" != *$'\n'* && "$requested" != *$'\r'* ]] || return 1
  [[ "$requested" = /* ]] || requested="$PWD/$requested"
  parent="$(cd -P -- "$(dirname -- "$requested")" && printf '%s/.' "$PWD")" || return 1
  parent="${parent%/.}"
  [[ "$parent" != *$'\n'* && "$parent" != *$'\r'* ]] || return 1
  [ -d "$parent" ] && [ -w "$parent" ] && [ -x "$parent" ] || return 1
  base="${requested##*/}"
  [ -n "$base" ] && [ "$base" != . ] && [ "$base" != .. ] || return 1
  case "${base,,}" in *."$extension") ;; *) base="$base.$extension" ;; esac
  target="$parent/$base"
  if [ -e "$target" ] || [ -L "$target" ]; then
    identity="$(stat -c '%d:%i' -- "$target" 2>/dev/null || true)"
    for source in "$@"; do
      [ -n "$identity" ] || continue
      [ "$(stat -c '%d:%i' -- "$source" 2>/dev/null || true)" != "$identity" ] || return 1
    done
    if [ "$mode" = overwrite ]; then
      [ ! -L "$target" ] && [ -f "$target" ] && [ "$(stat -c '%h' -- "$target")" = 1 ] || return 1
      DERIVED_TARGET="$target"
      DERIVED_MODE=overwrite
      return 0
    fi
    stem="${base%.*}"
    numbered=1
    while [ -e "$target" ] || [ -L "$target" ]; do
      target="$parent/${stem}_${numbered}.${extension}"
      numbered=$((numbered + 1))
    done
  fi
  DERIVED_TARGET="$target"
  DERIVED_MODE=create
}

publication_fail() {
  local ref="$1" tmp="$2" message="$3"
  [ -z "$tmp" ] || rm -f -- "$tmp" || true
  [ -z "$ref" ] || progress_close "$ref" || true
  kdialog --title "$(gettext 'Kim')" --error "$message" || true
  return 1
}

# Full image decoding and image-header inspection without a second resize.
publication_image_records() {
  identify -regard-warnings -format '%m|%w|%h|%T|%n|%#\n' -- "$1"
}

publication_input_frames() {
  local file="$1" records count=0 record format width height scenes
  records="$(identify -ping -format '%m|%w|%h|%n\n' -- "$file" 2>/dev/null)" || return 1
  while IFS= read -r record; do
    IFS='|' read -r format width height scenes <<< "$record"
    [[ "$format" =~ ^[A-Za-z0-9]+$ && "$width" =~ ^[1-9][0-9]*$ &&
       "$height" =~ ^[1-9][0-9]*$ && "$scenes" =~ ^[1-9][0-9]*$ ]] || return 1
    count=$((count + 1))
  done <<< "$records"
  [ "$count" -gt 0 ] || return 1
  printf '%s\n' "$count"
}

# Validate PDF page count, format and page geometry after a complete decoder
# pass at ImageMagick's normal 72-DPI PDF resolution.
validate_publication_pdf() {
  local file="$1" expected_pages="$2" expected_width="$3" expected_height="$4"
  local records record format width height pages=0
  records="$(publication_image_records "$file" 2>/dev/null)" || return 1
  while IFS= read -r record; do
    IFS='|' read -r format width height _ <<< "$record"
    [ "$format" = PDF ] && [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || return 1
    [ "$width" = "$expected_width" ] && [ "$height" = "$expected_height" ] || return 1
    pages=$((pages + 1))
  done <<< "$records"
  [ "$pages" -eq "$expected_pages" ] && [ -s "$file" ]
}

# One verbose decode provides GIF frame geometry, delay and loop metadata.
validate_publication_gif() {
  local file="$1" expected_delay="$2" expected_loops="$3" expected_name="$4" expected_frames="$5"
  local -n expected_ref="$expected_name"
  local verbose detail format='' geometry='' frame_delay=0 iterations='' index=0 expected_width expected_height width height
  verbose="$(identify -regard-warnings -verbose -- "$file" 2>/dev/null)" || return 1
  while IFS= read -r detail; do
    case "$detail" in
      'Image:'*)
        if [ "$index" -gt 0 ]; then
          [[ "$format" = GIF && "$geometry" =~ ^[1-9][0-9]*x[1-9][0-9]* ]] || return 1
          IFS='x' read -r width height <<< "${geometry%%+*}"
          IFS='|' read -r expected_width expected_height <<< "${expected_ref[$((index - 1))]:-}"
          [ "$width" = "$expected_width" ] && [ "$height" = "$expected_height" ] && [ "$frame_delay" = "$expected_delay" ] || return 1
          if [ -n "$iterations" ]; then [ "$iterations" = "$expected_loops" ] || return 1
          elif [ "$expected_loops" -ne 1 ]; then return 1
          fi
        fi
        index=$((index + 1)); format=''; geometry=''; frame_delay=0; iterations=''
        ;;
      '  Format: '*) format="${detail#*: }"; format="${format%% *}" ;;
      '  Geometry: '*) geometry="${detail#*: }" ;;
      '  Delay: '*) frame_delay="${detail#*: }"; frame_delay="${frame_delay%%x*}" ;;
      '  Iterations: '*) iterations="${detail#*: }"; iterations="${iterations//[[:space:]]/}" ;;
    esac
  done <<< "$verbose"
  [ "$index" -eq "$expected_frames" ] || return 1
  [[ "$format" = GIF && "$geometry" =~ ^[1-9][0-9]*x[1-9][0-9]* ]] || return 1
  IFS='x' read -r width height <<< "${geometry%%+*}"
  IFS='|' read -r expected_width expected_height <<< "${expected_ref[$((index - 1))]:-}"
  [ "$width" = "$expected_width" ] && [ "$height" = "$expected_height" ] && [ "$frame_delay" = "$expected_delay" ] || return 1
  if [ -n "$iterations" ]; then [ "$iterations" = "$expected_loops" ]
  else [ "$expected_loops" -eq 1 ]
  fi
}

# Escape all five HTML-sensitive characters without interpreting user text.
html_escape() {
  local value="$1" escaped='' character index
  for ((index = 0; index < ${#value}; index++)); do
    character="${value:index:1}"
    case "$character" in
      '&') escaped+='&amp;' ;;
      '<') escaped+='&lt;' ;;
      '>') escaped+='&gt;' ;;
      '"') escaped+='&quot;' ;;
      "'") escaped+='&#39;' ;;
      *) escaped+="$character" ;;
    esac
  done
  printf '%s' "$escaped"
}

# Publish a completely staged gallery as one directory rename. The cooperative
# lock serializes KIM6 publishers; mv's no-clobber option refuses an occupied
# target. This is atomic visibility on a local filesystem, not crash durability.
publish_gallery_directory() {
  local staged_directory="$1" target_directory="$2" parent lock
  parent="$(cd -P -- "$(dirname -- "$target_directory")" && pwd -P)" || return 1
  target_directory="$parent/${target_directory##*/}"
  lock="$parent/.kim6-publish.lock"
  if (umask 077; mkdir -- "$lock") 2>/dev/null; then
    if ! register_stage_dir "$lock"; then
      rm -rf -- "$lock"
      return 1
    fi
  else
    owned_stage_dir "$lock" || return 1
  fi
  mv --no-clobber -T -- "$staged_directory" "$target_directory" || return 1
  [ ! -e "$staged_directory" ] && [ -d "$target_directory" ] && [ ! -L "$target_directory" ]
}

# Build a photo album PDF from selected images using ImageMagick montage.
#
# Usage: album <dir> <files...>
#
# Behavior:
# - Prompts for an album layout (tile/page geometry presets).
# - Asks where to save the output PDF (save dialog starts in <dir>).
# - Uses destination-local staging and validates every generated PDF page.
#
# Notes:
# - Expects montage to be available.
# - Output is a single PDF at the user-selected path.

action_album() {
  local dir nb outpdf mode tile geometry page width height capacity frames expected_pages ref tmp='' rc=0
  local file frame_count
  local -a files=() image_assets=() thumb_assets=()
  dir="${1:-}"
  shift || true
  if ! collect_publication_inputs files "$@"; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Album: select regular, unambiguous image files.')"
    return 1
  fi
  case "$dir" in
    ''|--*) dir="${files[0]%/*}" ;;
  esac
  [ -d "$dir" ] || dir="${files[0]%/*}"
  nb="$(kdialog --radiolist "$(gettext 'Kim - Select album type:')" \
    1 "$(gettext '1x1 portrait album')" off \
    2 "$(gettext '1x1 landscape album')" off \
    3 "$(gettext '1x2 landscape album')" off \
    4 "$(gettext '2x1 portrait album')" off \
    5 "$(gettext '2x2 landscape album')" on \
    6 "$(gettext '3x2 portrait album')" off \
    7 "$(gettext '3x4 landscape album')" off \
    8 "$(gettext '4x4 landscape album')" off)" || return 1
  case "$nb" in
    1) tile=1x1; geometry=575x820+5+5; page=595x842; width=595; height=842 ;;
    2) tile=1x1; geometry=820x575+5+5; page=842x595; width=842; height=595 ;;
    3) tile=1x2; geometry=380x285+5+5; page=842x595; width=842; height=595 ;;
    4) tile=2x1; geometry=285x427+5+5; page=595x842; width=595; height=842 ;;
    5) tile=2x2; geometry=410x280+5+5; page=842x595; width=842; height=595 ;;
    6) tile=3x2; geometry=185x277+5+5; page=595x842; width=595; height=842 ;;
    7) tile=3x4; geometry=270x135+5+5; page=842x595; width=842; height=595 ;;
    8) tile=4x4; geometry=200x135+5+5; page=842x595; width=842; height=595 ;;
    *) return 1 ;;
  esac
  capacity=$(( ${tile%x*} * ${tile#*x} ))
  frames=0
  for file in "${files[@]}"; do
    frame_count="$(publication_input_frames "$file")" || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Album: an input image could not be inspected.')"; return 1; }
    frames=$((frames + frame_count))
  done
  expected_pages=$(( (frames + capacity - 1) / capacity ))
  mode="$(choose_output_mode "$(gettext 'Kim')" "$(gettext 'Do you want to create a new PDF?')")"
  [ "$mode" != cancel ] || return 1
  outpdf="$(kdialog --getsavefilename "$dir" "album.pdf")" || return 1
  [ -n "$outpdf" ] || return 1
  prepare_derived_target "$outpdf" pdf "$mode" "${files[@]}" || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Album: invalid or unsafe output destination.')"
    return 1
  }
  outpdf="$DERIVED_TARGET"
  mode="$DERIVED_MODE"
  ref="$(progress_open 2 "$(gettext 'Kim - Creating album ...')")"
  if progress_cancelled "$ref"; then progress_close "$ref"; return 1; fi
  tmp="$(tmp_for_target "$outpdf")" || { publication_fail "$ref" '' "$(gettext 'Album: cannot create destination-local staging.')"; return 1; }
  if ! magick montage -tile "$tile" -geometry "$geometry" -page "$page" -density 72 \
      -background white -- "${files[@]}" "$tmp" >/dev/null 2>&1; then rc=1; fi
  if [ "$rc" -eq 0 ] && ! validate_publication_pdf "$tmp" "$expected_pages" "$width" "$height"; then rc=1; fi
  if [ "$rc" -ne 0 ]; then publication_fail "$ref" "$tmp" "$(gettext 'Album: ImageMagick failed or produced an invalid PDF.')"; return 1; fi
  if progress_cancelled "$ref"; then publication_fail "$ref" "$tmp" "$(gettext 'Album: publication interrupted; no output was written.')"; return 1; fi
  if ! commit_tmp_to_target "$tmp" "$outpdf" "$mode"; then publication_fail "$ref" "$tmp" "$(gettext 'Album: PDF publication failed; existing files were preserved.')"; return 1; fi
  progress_value "$ref" 2
  progress_close "$ref"
  return 0
}


####################
# Compress images to a specified JPEG quality using ImageMagick.
#
# Usage: compress <quality> <dir> <files...>
#
# Behavior:
# - Prompts for Create vs overwrite (unless KIM_POLICY forces a mode).
# - Create mode: writes new files into <dir> using (suffix default):
#     <name>_compressed.<ext>   (or <name>_compressed if no extension)
#   NAME_AFFIX_POSITION=prefix places compressed before the complete stem.
#   Never overwrites: adds _1, _2, ... if needed.
# - Overwrite mode: overwrites the original files in place.
# - Changed image content receives a fresh modification timestamp.
#
# Policy:
# - KIM_POLICY=create    forces Create mode
# - KIM_POLICY=overwrite   forces Overwrite mode

action_compress() {
  local QUALITY="${1:-}"
  local outdir="${2:-}"
  shift 2 || true

  [[ -n "$QUALITY" ]] || die "compress: missing quality"
  [[ "$QUALITY" =~ ^[0-9]+$ ]] || die "compress: quality must be a number"
  while [[ "$QUALITY" == 0* ]] && [ "${#QUALITY}" -gt 1 ]; do QUALITY="${QUALITY#0}"; done
  [ "${#QUALITY}" -le 3 ] || die "compress: quality must be between 1 and 100"
  QUALITY=$((10#$QUALITY))
  (( QUALITY >= 1 && QUALITY <= 100 )) || die "compress: quality must be between 1 and 100"

  local -a files=()
  collect_valid_files files "$@"
  local nbfiles="${#files[@]}"
  [ "$nbfiles" -le 0 ] && return 0

  local mode
  mode="$(choose_output_mode \
    "$(gettext 'Kim')" \
    "$(gettext 'Do you want to create new files?')")"

  if [ "$mode" = "cancel" ]; then
    kdialog --title "$(gettext 'Kim')" --msgbox "$(gettext 'The action was cancelled by the user!')"
    return 1
  fi

  # Only required in create mode.
  if [ "$mode" = "create" ]; then
    [[ -n "$outdir" ]] || die "compress: missing output dir"
    [[ -d "$outdir" ]] || die "compress: output dir does not exist: $outdir"
  fi

  report_init

  local dbusRef
  dbusRef="$(progress_open "$nbfiles" "$(gettext 'Kim - Compressing images ...')")"

  local counter=0
  local f dir base stem ext
  local OUTFILE OUTTMP n rc actual input_info
  local interrupted

  for f in "${files[@]}"; do
    counter=$((counter + 1))

    {
      IFS= read -r dir
      IFS= read -r base
      IFS= read -r stem
      IFS= read -r ext
    } < <(split_path "$f")

    if ! progress_begin_item "$dbusRef" "$(gettext 'Kim - Compressing file: ')$base"; then
      report_fail "$f"
      progress_close "$dbusRef"
      report_finish_dialog "$(gettext 'Kim')"
      return 1
    fi

    if progress_cancelled "$dbusRef"; then
      report_fail "$f"
      break
    fi

    input_info=""
    if [[ "$f" != *$'\n'* ]] &&
       input_info="$(identify -regard-warnings +ping -format '%m %w %h\n' - < "$f" 2>/dev/null)" &&
       [[ "$input_info" =~ ^JPEG\ ([1-9][0-9]*)\ ([1-9][0-9]*)$ ]]; then
      :
    else
      report_fail "$f"
      progress_value "$dbusRef" "$counter"
      continue
    fi

    if [ "$mode" = "overwrite" ]; then
      OUTFILE="$f"
    else
      OUTFILE="$outdir/$(affixed_filename "$stem" compressed "$ext")"
      n=1
      while [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; do
        OUTFILE="$outdir/$(affixed_filename "$stem" compressed "$ext" "$n")"
        n=$((n + 1))
      done
    fi
    if ! OUTTMP="$(tmp_for_target "$OUTFILE")"; then
      report_fail "$f"
      progress_value "$dbusRef" "$counter"
      continue
    fi
    if progress_cancelled "$dbusRef"; then
      report_fail "$f"
      break
    fi
    rc=0
    # Retain EXIF orientation and ICC interpretation without rotating pixels.
    # EXIF is a container: finer-grained EXIF removal remains a policy decision.
    magick -- "$f" +profile '!{icc,exif}' +set comment -interlace Plane -quality "$QUALITY" "JPEG:$OUTTMP" >/dev/null 2>&1 || rc=$?
    actual=""
    if [ "$rc" -eq 0 ] && [ -s "$OUTTMP" ]; then
      actual="$(identify -regard-warnings +ping -format '%m %w %h\n' - < "$OUTTMP" 2>/dev/null)" || rc=$?
    fi
    [ "$actual" = "$input_info" ] || rc=1
    if [ "$rc" -eq 0 ]; then
      chmod --reference="$f" "$OUTTMP" || rc=$?
    fi
    interrupted=false
    if progress_cancelled "$dbusRef"; then interrupted=true; fi
    [ "$interrupted" != true ] || rc=1
    if [ "$rc" -eq 0 ] && commit_tmp_to_target "$OUTTMP" "$OUTFILE" "$mode"; then
      report_ok
    else
      report_fail "$f"
    fi
    rm -f -- "$OUTTMP" >/dev/null 2>&1 || true
    [ "$interrupted" != true ] || break

    progress_value "$dbusRef" "$counter"
  done

  progress_close "$dbusRef"
  report_finish_dialog "$(gettext 'Kim')"
  true
}


####################
# Convert images to another format using ImageMagick.
#
# Usage: convert <format> <files...>
#
# Behavior:
# - Prompts for Create vs Overwrite (unless KIM_POLICY forces a mode).
# - Create mode: writes new sibling files next to the originals, never overwriting.
# - overwrite mode: converts to a temporary file in the destination directory, then moves it into place.
# - Uses a progress dialog and supports Cancel.
#
# Policy:
# - KIM_POLICY=create      forces Create mode
# - KIM_POLICY=overwrite   forces overwrite mode
#
# Notes:
# - Overwrite mode does NOT preserve timestamps (conversion produces a new file).
# - Uses `magick` (ImageMagick) for conversion.

####################
# Convert images to another format.
#
# Usage: convert <format> <files...>
#
# Behavior:
# - Prompts for Create vs Overwrite (unless KIM_POLICY forces a mode).
# - Create mode: writes new sibling files next to the originals, never overwriting
#   (adds _1, _2, ... if needed).
# - Overwrite mode: overwrites existing converted destination files if they exist,
#   but DOES NOT delete the original input files (matches upstream kim_convert behavior).
# - Uses a progress dialog and supports Cancel.
#
# Policy:
# - KIM_POLICY=create      forces Create mode
# - KIM_POLICY=overwrite   forces overwrite mode
#
# Notes:
# - Uses ImageMagick `magick` to write explicit outputs.

action_convert() {
  local FORMAT="${1:-}"
  if [ -z "$FORMAT" ]; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Convert: missing format.')"
    return 1
  fi

  # Keep format simple and safe as an extension.
  if ! [[ "$FORMAT" =~ ^[A-Za-z0-9]+$ ]]; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Convert: invalid format.')"
    return 1
  fi

  shift || true

  local -a files=()
  collect_valid_files files "$@"
  local nbfiles="${#files[@]}"
  [ "$nbfiles" -le 0 ] && return 0

  local selected_path
  for selected_path in "${files[@]}"; do
    # split_path uses newline records; refuse an ambiguous destination mapping.
    if [[ "$selected_path" == *$'\n'* ]]; then
      kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Convert: ambiguous filename.')"
      return 1
    fi
  done

  local mode
  mode="$(choose_output_mode \
    "$(gettext 'Kim')" \
    "$(gettext 'Do you want to create new files?')")"

  if [ "$mode" = "cancel" ]; then
    return 1
  fi

  # Resolve parent aliases before comparing destination mappings. Never publish
  # over any selected source, including an inode reached by a different name.
  if [ "$mode" = "overwrite" ]; then
    declare -A _convert_seen=()
    local i dir base stem ext outfile selected
    for i in "${files[@]}"; do
      {
        IFS= read -r dir
        IFS= read -r base
        IFS= read -r stem
        IFS= read -r ext
      } < <(split_path "$i")
      dir="$(cd -P -- "$dir" && pwd)" || return 1
      outfile="$dir/${stem}.${FORMAT}"
      if [[ -n "${_convert_seen["$outfile"]+x}" ]]; then
        kdialog --title "$(gettext 'Kim')" --error \
          "$(gettext 'Convert aborted. Two files would write the same destination:')\n\n$outfile"
        return 1
      fi
      _convert_seen["$outfile"]="$i"
      # Existing same-format overwrite is an intentional no-op.
      if [ -n "$ext" ] && [[ "${ext,,}" == "${FORMAT,,}" ]]; then
        continue
      fi
      for selected in "${files[@]}"; do
        if [ "$outfile" -ef "$selected" ]; then
          kdialog --title "$(gettext 'Kim')" --error \
            "$(gettext 'Convert aborted. Destination aliases a selected source:')\n\n$outfile"
          return 1
        fi
      done
    done
  fi

  report_init

  local dbusRef
  dbusRef="$(progress_open "$nbfiles" "$(gettext 'Kim - Initialising ...')")"

  local counter=0
  local i dir base stem ext OUTFILE OUTTMP publication_mode n rc actual expected frame
  local interrupted

  for i in "${files[@]}"; do
    counter=$((counter + 1))

    {
      IFS= read -r dir
      IFS= read -r base
      IFS= read -r stem
      IFS= read -r ext
    } < <(split_path "$i")

    if ! progress_begin_item "$dbusRef" "$(gettext 'Kim - Converting file: ')$base"; then
      report_fail "$i"
      progress_close "$dbusRef"
      report_finish_dialog "$(gettext 'Kim')"
      return 1
    fi

    if progress_cancelled "$dbusRef"; then
      report_fail "$i"
      break
    fi
    OUTFILE="$dir/${stem}.${FORMAT}"

    # If user "converts" to the same extension, do not try to write input to itself.
    # Create mode will create a copy with suffix, overwrite mode treats as no-op success.
    if [ -n "$ext" ] && [[ "${ext,,}" == "${FORMAT,,}" ]]; then
      if [ "$mode" = "overwrite" ]; then
        report_ok
        progress_value "$dbusRef" "$counter"
        continue
      fi
      n=1
      while [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; do
        OUTFILE="$dir/${stem}_${n}.${FORMAT}"
        n=$((n + 1))
      done
    fi

    if [ "$mode" = "create" ]; then
      n=1
      while [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; do
        OUTFILE="$dir/${stem}_${n}.${FORMAT}"
        n=$((n + 1))
      done
    fi

    {
      # Snapshot absent-vs-authorized-present before producing any output.
      publication_mode=create
      [ "$mode" != overwrite ] || publication_mode=overwrite
      if [ ! -e "$OUTFILE" ] && [ ! -L "$OUTFILE" ]; then
        publication_mode=create
      fi
      if ! OUTTMP="$(tmp_for_target "$OUTFILE")"; then
        report_fail "$i"
        progress_value "$dbusRef" "$counter"
        continue
      fi
      if progress_cancelled "$dbusRef"; then
        report_fail "$i"
        break
      fi
      rc=0
      magick -- "$i" "$OUTTMP" >/dev/null 2>&1 || rc=$?
      # Decode every frame from bytes, without trusting the requested suffix.
      expected="${FORMAT^^}"
      case "$expected" in
        JPG|JPE|JPS) expected=JPEG ;;
        TIF) expected=TIFF ;;
        PNG00|PNG8|PNG24|PNG32|PNG48|PNG64) expected=PNG ;;
        GIF87) expected=GIF ;;
      esac
      actual=""
      if [ "$rc" -eq 0 ] && [ -s "$OUTTMP" ]; then
        actual="$(identify -regard-warnings +ping -format '%m\n' - < "$OUTTMP" 2>/dev/null)" || rc=$?
      fi
      [ -n "$actual" ] || rc=1
      while IFS= read -r frame; do
        if [ "$expected" = PNM ]; then
          case "$frame" in PBM|PGM|PPM|PAM) ;; *) rc=1 ;; esac
        elif [ "$frame" != "$expected" ]; then
          rc=1
        fi
      done <<< "$actual"
      # Direct replacement previously retained an existing target's mode.
      if [ "$rc" -eq 0 ] && [ "$publication_mode" = overwrite ] && [ ! -L "$OUTFILE" ] && [ -f "$OUTFILE" ]; then
        chmod --reference="$OUTFILE" "$OUTTMP" || rc=$?
      fi
      interrupted=false
      if progress_cancelled "$dbusRef"; then interrupted=true; fi
      [ "$interrupted" != true ] || rc=1
      if [ "$rc" -eq 0 ] && commit_tmp_to_target "$OUTTMP" "$OUTFILE" "$publication_mode"; then
        report_ok
      else
        report_fail "$i"
      fi
      rm -f -- "$OUTTMP" >/dev/null 2>&1 || true
      [ "$interrupted" != true ] || break
      progress_value "$dbusRef" "$counter"
      continue
    }
  done

  progress_close "$dbusRef"
  report_finish_dialog "$(gettext 'Kim')"
  true
}


####################
# Flip or flop images in-place using ImageMagick mogrify.
#
# Usage: flipflop <mode> <files...>
#
# Behavior:
# - Accepts flip/flop and -flip/-flop; replaces only the selected originals.
# - Uses a progress dialog and supports Cancel.
# - If no valid files are selected, does nothing.
#
# Notes:
# - This action does not preserve timestamps explicitly.
# - Uses staged ImageMagick output and K12 atomic replacement.

action_flipflop() {
  [ "$#" -ge 2 ] || die "flipflop: missing mode or files"
  local operation="${1#-}"
  shift
  case "$operation" in flip|flop) ;; *) die "flipflop: expected flip or flop" ;; esac
  action_transform_in_place fresh "-$operation" "$@"
}

####################
# Create a static HTML image gallery with copied originals and thumbnails.
#
# Usage: gallery <dir> <files...>
#
# Behavior:
# - Prompts for gallery title, author, and column count.
# - Prompts for a base output directory (chooser starts in <dir> if valid).
# - Creates a timestamped folder:
#     kim-gallery-YYYYMMDD-HHMMSS/
#       images/   (copies of selected files)
#       thumbs/   (generated thumbnails)
#       index.html
# - Avoids overwriting when multiple inputs share the same basename by adding suffixes.
# - Uses a progress dialog and supports Cancel.
# - Opens the generated index.html in the default browser.
#
# Notes:
# - Uses `magick` to generate thumbnails.
# - If index.part1 and index.part2 exist, uses them as templates, otherwise generates a basic HTML page.

####################
# Create an HTML image gallery with resized images and thumbnails.
#
# Usage: gallery <dir> <files...>
#
# Behavior (aligned with upstream kim_galery):
# - Prompts for gallery title, author, and column count.
# - Prompts for an output directory (chooser starts in <dir> if valid).
# - Creates (or reuses) these within the chosen directory:
#     images/
#     thumbs/
#     index.html
# - Resizes images to 800x800 and thumbs to 200x200.
# - Builds a table-based HTML gallery and opens it in the default browser.
# - Uses index.part1 and index.part2 templates if present next to kim_all,
#   otherwise generates a minimal HTML wrapper.
#
# Notes:
# - Uses `magick` to generate images and thumbnails.
# - Uses `identify` to adjust displayed dimensions based on orientation.

action_gallery() {
  local start_dir="${1:-}" base_dir target_dir base_name timestamp number=1
  shift || true
  local -a files=()
  collect_publication_inputs files "$@" || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Gallery: select regular, unambiguous image files.')"
    return 1
  }
  local nbfiles="${#files[@]}" TITLE AUTHOR COLUMNS
  TITLE="$(kdialog --inputbox "$(gettext 'Kim - Title:')" "$(gettext 'My title ...')")" || return 1
  AUTHOR="$(kdialog --inputbox "$(gettext 'Kim - Author:')" "${USER:-}")" || return 1
  COLUMNS="$(kdialog --inputbox "$(gettext 'Kim - Number of columns:')" "4")" || return 1

  if ! [[ "$COLUMNS" =~ ^[0-9]{1,4}$ ]] || [ "$COLUMNS" -le 0 ]; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Gallery: columns must be a positive number.')"
    return 1
  fi
  if [ -z "$start_dir" ] || [ ! -d "$start_dir" ]; then
    start_dir="$PWD"
  fi
  base_dir="$(kdialog --getexistingdirectory "$start_dir")" || return 1
  [ -n "$base_dir" ] || return 1
  base_dir="$(cd -P -- "$base_dir" && pwd -P)" || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Gallery: selected output folder is unavailable.')"
    return 1
  }
  timestamp="$(date +%Y%m%d-%H%M%S)" || return 1
  base_name="kim-gallery-$timestamp"
  target_dir="$base_dir/$base_name"
  while [ -e "$target_dir" ] || [ -L "$target_dir" ]; do
    target_dir="$base_dir/${base_name}_$number"
    number=$((number + 1))
  done

  local ref tmp='' stage_dir gallery_dir index_file script_dir resource_dir tpl1 tpl2
  ref="$(progress_open "$nbfiles" "$(gettext 'Kim - Initialising ...')")"
  if progress_cancelled "$ref"; then progress_close "$ref"; return 1; fi
  # Anchor the owned stage in the existing output parent; the final gallery
  # directory must not exist until its complete tree is atomically renamed.
  tmp="$(tmp_for_target "$base_dir/index.html")" || {
    publication_fail "$ref" '' "$(gettext 'Gallery: cannot create destination-local staging.')"
    return 1
  }
  stage_dir="${tmp%/*}"
  gallery_dir="$stage_dir/gallery"
  index_file="$gallery_dir/index.html"
  if ! mkdir -p -- "$gallery_dir/images" "$gallery_dir/thumbs"; then
    publication_fail "$ref" "$tmp" "$(gettext 'Gallery: failed to create owned staging directories.')"
    return 1
  fi

  local DATE_STR etitle eauthor
  DATE_STR="$(date +%Y%m%d)" || { publication_fail "$ref" "$tmp" "$(gettext 'Gallery: cannot read the current date.')"; return 1; }
  etitle="$(html_escape "$TITLE")"
  eauthor="$(html_escape "$AUTHOR")"
  script_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || {
    publication_fail "$ref" "$tmp" "$(gettext 'Gallery: cannot locate the dispatcher resources.')"
    return 1
  }
  resource_dir="$script_dir/../gallery"
  tpl1="$resource_dir/index.part1"
  tpl2="$resource_dir/index.part2"
  if [ -f "$tpl1" ] && [ -f "$tpl2" ]; then
    cat -- "$tpl1" > "$index_file" || { publication_fail "$ref" "$tmp" "$(gettext 'Gallery: cannot read the HTML template.')"; return 1; }
  else
    cat > "$index_file" <<EOF
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>$etitle</title>
<style>
body { font-family: sans-serif; }
table { border-collapse: collapse; }
td { padding: 10px; vertical-align: top; text-align: center; }
img.photo { display: block; margin: 0 auto; }
</style>
</head>
<body>
EOF
  fi || { publication_fail "$ref" "$tmp" "$(gettext 'Gallery: cannot initialize the HTML page.')"; return 1; }

  if ! {
    printf '<h1>%s</h1>\n' "$etitle"
    printf '<h5>Author: %s<br>Date: %s</h5>\n' "$eauthor" "$DATE_STR"
    printf '<table><tr>\n'
  } >> "$index_file"; then
    publication_fail "$ref" "$tmp" "$(gettext 'Gallery: cannot write the HTML page.')"
    return 1
  fi

  report_init
  local counter=0 col=0 file base info record format width height scenes
  local image_path thumb_path image_records thumb_records image_count thumb_width thumb_height
  local asset_name='' source_format image_url thumb_url escaped_name rc=0 n=0 source_frames
  for file in "${files[@]}"; do
    counter=$((counter + 1))
    asset_name=''
    base="${file##*/}"
    if ! progress_begin_item "$ref" "$(gettext 'Kim - Processing file: ')$base" || progress_cancelled "$ref"; then
      report_fail "$file"
      progress_close "$ref"
      report_finish_dialog "$(gettext 'Kim')"
      return 1
    fi
    info="$(identify -ping -format '%m|%w|%h|%n\n' -- "$file" 2>/dev/null)" || rc=1
    source_frames=0
    if [ "$rc" -eq 0 ]; then
      while IFS= read -r record; do
        IFS='|' read -r format width height scenes <<< "$record"
        [[ "$format" =~ ^[A-Za-z][A-Za-z0-9]{0,11}$ && "$width" =~ ^[1-9][0-9]*$ &&
           "$height" =~ ^[1-9][0-9]*$ && "$scenes" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
        if [ "$source_frames" -eq 0 ]; then source_format="$format"; asset_name="${format,,}"; fi
        [ "$format" = "$source_format" ] || { rc=1; break; }
        source_frames=$((source_frames + 1))
      done <<< "$info"
      [ "$source_frames" -gt 0 ] || rc=1
    fi
    n=$((n + 1))
    image_path="$gallery_dir/images/image_$n.$asset_name"
    thumb_path="$gallery_dir/thumbs/image_$n.png"
    if [ "$rc" -eq 0 ]; then
      magick - -resize 800x800 "$asset_name:$image_path" < "$file" >/dev/null 2>&1 || rc=$?
    fi
    if progress_cancelled "$ref"; then
      report_fail "$file"
      report_finish_dialog "$(gettext 'Kim')"
      publication_fail "$ref" "$tmp" "$(gettext 'Gallery: publication interrupted; no gallery was published.')"
      return 1
    fi
    image_records="$(publication_image_records "$image_path" 2>/dev/null)" || rc=1
    image_count=0
    while IFS= read -r record; do
      IFS='|' read -r format width height _ <<< "$record"
      [ "$format" = "${asset_name^^}" ] && [[ "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
      [ "$width" -le 800 ] && [ "$height" -le 800 ] || { rc=1; break; }
      image_count=$((image_count + 1))
    done <<< "$image_records"
    [ "$image_count" -eq "$source_frames" ] || rc=1
    if [ "$rc" -eq 0 ]; then
      magick -- "${image_path}[0]" -resize 200x200 "PNG:$thumb_path" >/dev/null 2>&1 || rc=$?
    fi
    if progress_cancelled "$ref"; then
      report_fail "$file"
      report_finish_dialog "$(gettext 'Kim')"
      publication_fail "$ref" "$tmp" "$(gettext 'Gallery: publication interrupted; no gallery was published.')"
      return 1
    fi
    thumb_records="$(publication_image_records "$thumb_path" 2>/dev/null)" || rc=1
    image_count=0 thumb_width=0 thumb_height=0
    while IFS= read -r record; do
      IFS='|' read -r format width height _ <<< "$record"
      [ "$format" = PNG ] && [[ "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
      [ "$width" -le 200 ] && [ "$height" -le 200 ] || { rc=1; break; }
      thumb_width="$width" thumb_height="$height"
      image_count=$((image_count + 1))
    done <<< "$thumb_records"
    [ "$image_count" -eq 1 ] || rc=1
    if [ "$rc" -ne 0 ]; then
      report_fail "$file"
      report_finish_dialog "$(gettext 'Kim')"
      publication_fail "$ref" "$tmp" "$(gettext 'Gallery: an image or thumbnail could not be generated and validated.')"
      return 1
    fi
    asset_name="image_$n.$asset_name"
    image_url="images/$asset_name"
    thumb_url="thumbs/image_$n.png"
    image_assets+=("$gallery_dir/$image_url")
    thumb_assets+=("$gallery_dir/$thumb_url")
    escaped_name="$(html_escape "$base")"
    if ! {
      printf '<td align="center"><a href="%s"><img class="photo" src="%s" width="%s" height="%s" alt="%s" title="%s"></a><p>%s</p></td>\n' \
        "$(html_escape "$image_url")" "$(html_escape "$thumb_url")" "$thumb_width" "$thumb_height" \
        "$escaped_name" "$escaped_name" "$escaped_name"
    } >> "$index_file"; then
      report_fail "$file"
      report_finish_dialog "$(gettext 'Kim')"
      publication_fail "$ref" "$tmp" "$(gettext 'Gallery: cannot write the HTML gallery.')"
      return 1
    fi
    report_ok
    col=$((col + 1))
    if [ "$col" -ge "$COLUMNS" ]; then
      printf '</tr><tr>\n' >> "$index_file"
      col=0
    fi
    progress_value "$ref" "$counter"
    if progress_cancelled "$ref"; then
      report_fail "$file"
      report_finish_dialog "$(gettext 'Kim')"
      progress_close "$ref"
      return 1
    fi
  done

  if [ -f "$tpl2" ]; then
    cat -- "$tpl2" >> "$index_file" || { publication_fail "$ref" "$tmp" "$(gettext 'Gallery: cannot finish the HTML template.')"; return 1; }
  else
    cat >> "$index_file" <<EOF
</body>
</html>
EOF
  fi
  [ -s "$index_file" ] || { publication_fail "$ref" "$tmp" "$(gettext 'Gallery: generated HTML is empty.')"; return 1; }
  local asset
  for asset in "${image_assets[@]}" "${thumb_assets[@]}"; do
    [ -f "$asset" ] && [ ! -L "$asset" ] && [ -s "$asset" ] || {
      publication_fail "$ref" "$tmp" "$(gettext 'Gallery: a staged resource is missing or unsafe.')"
      return 1
    }
  done
  rm -f -- "$tmp" || { publication_fail "$ref" '' "$(gettext 'Gallery: cannot finalize the staged output.')"; return 1; }
  if progress_cancelled "$ref"; then
    progress_close "$ref"
    report_finish_dialog "$(gettext 'Kim')"
    return 1
  fi
  if ! publish_gallery_directory "$gallery_dir" "$target_dir"; then
    report_finish_dialog "$(gettext 'Kim')"
    publication_fail "$ref" '' "$(gettext 'Gallery: publication failed; existing directories were preserved.')"
    return 1
  fi
  progress_value "$ref" "$nbfiles"
  progress_close "$ref"
  xdg-open "$target_dir/index.html" >/dev/null 2>&1 || true
  report_finish_dialog "$(gettext 'Kim')"
  true
}

####################
# Build a validated, destination-local print-layout PDF from selected images.

action_print() {
  local dir nb outpdf mode tile geometry page width height capacity frames expected_pages ref tmp='' rc=0
  local file frame_count
  local -a files=()
  dir="${1:-}"
  shift || true
  if ! collect_publication_inputs files "$@"; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Print: select regular, unambiguous image files.')"
    return 1
  fi
  case "$dir" in ''|--*) dir="${files[0]%/*}" ;; esac
  [ -d "$dir" ] || dir="${files[0]%/*}"
  nb="$(kdialog --radiolist "$(gettext 'Kim - Select print layout:')" \
    1 "$(gettext '9x13 cm: 2x2 images, landscape')" off \
    2 "$(gettext '10x15 cm: 1x2 images, portrait')" off \
    3 "$(gettext '11.5x15 cm: 1x2 images, portrait')" on \
    4 "$(gettext '13x18 cm: 1x2 images, portrait')" off \
    5 "$(gettext '20x25 cm: 1 image, landscape')" off \
    6 "$(gettext '3x2 portrait album')" off \
    7 "$(gettext 'Thumbnails: 4x5 images, portrait')" off)" || return 1
  case "$nb" in
    1) tile=2x2; geometry=368x255+5+5; page=842x595; width=842; height=595 ;;
    # Preserve the labelled 15 cm image height; two copies need A3 portrait.
    2) tile=1x2; geometry=283x425+5+5; page=842x1191; width=842; height=1191 ;;
    3) tile=1x2; geometry=326x425+5+5; page=842x1191; width=842; height=1191 ;;
    4) tile=1x2; geometry=369x510+5+5; page=842x1191; width=842; height=1191 ;;
    5) tile=1x1; geometry=709x567+5+5; page=842x595; width=842; height=595 ;;
    6) tile=3x2; geometry=160x300+5+5; page=595x842; width=595; height=842 ;;
    7) tile=4x5; geometry=110x150+5+5; page=595x842; width=595; height=842 ;;
    *) return 1 ;;
  esac
  capacity=$(( ${tile%x*} * ${tile#*x} ))
  frames=0
  for file in "${files[@]}"; do
    frame_count="$(publication_input_frames "$file")" || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Print: an input image could not be inspected.')"; return 1; }
    frames=$((frames + frame_count))
  done
  expected_pages=$(( (frames + capacity - 1) / capacity ))
  mode="$(choose_output_mode "$(gettext 'Kim')" "$(gettext 'Do you want to create a new print PDF?')")"
  [ "$mode" != cancel ] || return 1
  outpdf="$(kdialog --getsavefilename "$dir" "print.pdf")" || return 1
  [ -n "$outpdf" ] || return 1
  prepare_derived_target "$outpdf" pdf "$mode" "${files[@]}" || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Print: invalid or unsafe output destination.')"
    return 1
  }
  outpdf="$DERIVED_TARGET"; mode="$DERIVED_MODE"
  ref="$(progress_open 2 "$(gettext 'Kim - Creating print layout ...')")"
  if progress_cancelled "$ref"; then progress_close "$ref"; return 1; fi
  tmp="$(tmp_for_target "$outpdf")" || { publication_fail "$ref" '' "$(gettext 'Print: cannot create destination-local staging.')"; return 1; }
  if ! magick montage -tile "$tile" -geometry "$geometry" -page "$page" -density 72 \
      -background white -- "${files[@]}" "$tmp" >/dev/null 2>&1; then rc=1; fi
  if [ "$rc" -eq 0 ] && ! validate_publication_pdf "$tmp" "$expected_pages" "$width" "$height"; then rc=1; fi
  if [ "$rc" -ne 0 ]; then publication_fail "$ref" "$tmp" "$(gettext 'Print: ImageMagick failed or produced an invalid PDF.')"; return 1; fi
  if progress_cancelled "$ref"; then publication_fail "$ref" "$tmp" "$(gettext 'Print: publication interrupted; no output was written.')"; return 1; fi
  if ! commit_tmp_to_target "$tmp" "$outpdf" "$mode"; then publication_fail "$ref" "$tmp" "$(gettext 'Print: PDF publication failed; existing files were preserved.')"; return 1; fi
  progress_value "$ref" 2
  progress_close "$ref"
  return 0
}


# Join selected image frames into one ordered multi-page TIFF file.
action_tiffjoin() {
  local requested='' file dir mode output ref tmp='' info record format width height scenes rc=0 frames=0
  local index=0 expected_width expected_height
  local -a files=() source_geometry=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --output) [ "$#" -ge 2 ] || return 1; requested="$2"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  collect_publication_inputs files "$@" || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'TIFF join: select regular, unambiguous image files.')"; return 1; }
  dir="${files[0]%/*}"
  for file in "${files[@]}"; do
    info="$(identify -ping -format '%m|%w|%h|%n\n' -- "$file" 2>/dev/null)" || {
      kdialog --title "$(gettext 'Kim')" --error "$(gettext 'TIFF join: an input image could not be decoded.')"
      return 1
    }
    while IFS= read -r record; do
      IFS='|' read -r format width height scenes <<< "$record"
      [[ "$format" =~ ^[A-Za-z0-9]+$ && "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ ]] || {
        kdialog --title "$(gettext 'Kim')" --error "$(gettext 'TIFF join: an input frame has invalid dimensions or format.')"
        return 1
      }
      source_geometry+=("$width|$height")
      frames=$((frames + 1))
    done <<< "$info"
  done
  [ "$frames" -gt 0 ] || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'TIFF join: no image frames were found.')"; return 1; }
  mode="$(choose_output_mode "$(gettext 'Kim')" "$(gettext 'Do you want to create a new joined TIFF?')")"
  [ "$mode" != cancel ] || return 1
  if [ -z "$requested" ]; then
    requested="$(kdialog --getsavefilename "$dir" "my_images.tiff")" || return 1
  fi
  [ -n "$requested" ] || return 1
  local extension=tiff
  [[ "${requested,,}" == *.tif ]] && extension=tif
  prepare_derived_target "$requested" "$extension" "$mode" "${files[@]}" || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'TIFF join: invalid or unsafe output destination.')"
    return 1
  }
  output="$DERIVED_TARGET"; mode="$DERIVED_MODE"
  ref="$(progress_open 2 "$(gettext 'Kim - Joining TIFF images ...')")"
  if progress_cancelled "$ref"; then progress_close "$ref"; return 1; fi
  tmp="$(tmp_for_target "$output")" || { publication_fail "$ref" '' "$(gettext 'TIFF join: cannot create destination-local staging.')"; return 1; }
  if ! magick -- "${files[@]}" -adjoin "$tmp" >/dev/null 2>&1; then rc=1; fi
  if [ "$rc" -eq 0 ]; then
    info="$(publication_image_records "$tmp" 2>/dev/null)" || rc=1
    if [ "$rc" -eq 0 ]; then
      while IFS= read -r record; do
        IFS='|' read -r format width height _ <<< "$record"
        IFS='|' read -r expected_width expected_height <<< "${source_geometry[$index]:-}"
        [[ "$format" =~ ^(TIFF|TIF)$ && "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ &&
           "$width" = "$expected_width" && "$height" = "$expected_height" ]] || { rc=1; break; }
        index=$((index + 1))
      done <<< "$info"
      [ "$index" -eq "$frames" ] || rc=1
    fi
  fi
  if [ "$rc" -ne 0 ]; then publication_fail "$ref" "$tmp" "$(gettext 'TIFF join: ImageMagick failed or produced an invalid TIFF.')"; return 1; fi
  if progress_cancelled "$ref"; then publication_fail "$ref" "$tmp" "$(gettext 'TIFF join: publication interrupted; no output was written.')"; return 1; fi
  if ! commit_tmp_to_target "$tmp" "$output" "$mode"; then publication_fail "$ref" "$tmp" "$(gettext 'TIFF join: publication failed; existing files were preserved.')"; return 1; fi
  progress_value "$ref" 2
  progress_close "$ref"
}

# Create an ordered animated GIF. Delay is in centiseconds and loop count zero
# repeats forever, matching the historical service-menu command.
action_animate() {
  local requested='' delay='' loops='' file dir mode output ref tmp='' info record format width height scenes
  local rc=0 frames=0
  local -a files=() source_geometry=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --output) [ "$#" -ge 2 ] || return 1; requested="$2"; shift 2 ;;
      --delay) [ "$#" -ge 2 ] || return 1; delay="$2"; shift 2 ;;
      --loop) [ "$#" -ge 2 ] || return 1; loops="$2"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  collect_publication_inputs files "$@" || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Animation: select regular, unambiguous image files.')"; return 1; }
  dir="${files[0]%/*}"
  if [ -z "$delay" ]; then
    delay="$(kdialog --inputbox "$(gettext 'Delay between images in centiseconds (100 is one second):')" "${KIM_GIF_DELAY:-100}")" || return 1
  fi
  if ! [[ "$delay" =~ ^[0-9]{1,5}$ ]] || ((10#$delay > 65535)); then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Animation: delay must be an integer from 0 to 65535 centiseconds.')"
    return 1
  fi
  delay=$((10#$delay))
  if [ -z "$loops" ]; then
    loops="$(kdialog --inputbox "$(gettext 'Animation loop count (0 means infinite):')" 0)" || return 1
  fi
  if ! [[ "$loops" =~ ^[0-9]{1,5}$ ]] || ((10#$loops > 65535)); then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Animation: loop count must be an integer from 0 to 65535.')"
    return 1
  fi
  loops=$((10#$loops))
  for file in "${files[@]}"; do
    info="$(identify -ping -format '%m|%w|%h|%n\n' -- "$file" 2>/dev/null)" || {
      kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Animation: an input image could not be decoded.')"
      return 1
    }
    while IFS= read -r record; do
      IFS='|' read -r format width height scenes <<< "$record"
      [[ "$format" =~ ^[A-Za-z0-9]+$ && "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ ]] || {
        kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Animation: an input frame has invalid dimensions or format.')"
        return 1
      }
      source_geometry+=("$width|$height")
      frames=$((frames + 1))
    done <<< "$info"
  done
  [ "$frames" -gt 0 ] || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Animation: no image frames were found.')"; return 1; }
  mode="$(choose_output_mode "$(gettext 'Kim')" "$(gettext 'Do you want to create a new GIF animation?')")"
  [ "$mode" != cancel ] || return 1
  if [ -z "$requested" ]; then
    requested="$(kdialog --getsavefilename "$dir" "my_animation.gif")" || return 1
  fi
  [ -n "$requested" ] || return 1
  prepare_derived_target "$requested" gif "$mode" "${files[@]}" || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Animation: invalid or unsafe output destination.')"; return 1; }
  output="$DERIVED_TARGET"; mode="$DERIVED_MODE"
  ref="$(progress_open 2 "$(gettext 'Kim - Creating animation ...')")"
  if progress_cancelled "$ref"; then progress_close "$ref"; return 1; fi
  tmp="$(tmp_for_target "$output")" || { publication_fail "$ref" '' "$(gettext 'Animation: cannot create destination-local staging.')"; return 1; }
  if ! magick -- "${files[@]}" -set delay "$delay" -loop "$loops" "$tmp" >/dev/null 2>&1; then rc=1; fi
  if [ "$rc" -eq 0 ] && ! validate_publication_gif "$tmp" "$delay" "$loops" source_geometry "$frames"; then rc=1; fi
  if [ "$rc" -ne 0 ]; then publication_fail "$ref" "$tmp" "$(gettext 'Animation: ImageMagick failed or produced an invalid GIF.')"; return 1; fi
  if progress_cancelled "$ref"; then publication_fail "$ref" "$tmp" "$(gettext 'Animation: publication interrupted; no output was written.')"; return 1; fi
  if ! commit_tmp_to_target "$tmp" "$output" "$mode"; then publication_fail "$ref" "$tmp" "$(gettext 'Animation: publication failed; existing files were preserved.')"; return 1; fi
  progress_value "$ref" 2
  progress_close "$ref"
}


####################
# Rename images using simple filename rules, with Create or overwrite behavior.
#
# Usage: rename <mode> [--output-dir DIR] [--] <files...>
#
# Modes:
# - lowercase, uppercase
# - spacestodash, dashestospace
# - addprefix, addsuffix
# - overwrite (literal text replacement), exifdate, sequential, interactive
#
# Behavior:
# - KIM_POLICY=create copies; overwrite moves; otherwise prompts.
# - Copies or moves within each source directory or an explicit destination.
# - Create mode numbers collisions; EXIF-date and sequential moves also number.
# - overwrite mode safety:
#   - Other move modes reject occupied names and duplicate mappings entirely.
#   - Selected sources are never overwritten; swaps/chains are rejected.
# - Uses a progress dialog and supports Cancel.
#
# Policy:
# - KIM_POLICY=create|overwrite forces the corresponding mode.
# - Otherwise shows the Create vs overwrite prompt.
#
# Notes:
# - Preserves file bytes and filesystem metadata; never re-encodes images.

# Rename transactions differ from generated-image replacement: publish a new
# name without clobbering anything, then unlink the authorized source. There is
# no atomic transaction spanning two names (or filesystems). If removal fails,
# retain BOTH names and report the destination; never roll back by deleting it.
# These checks protect cooperative KIM operations, not arbitrary hostile writers.
rename_source_stamp() {
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  stat -c '%d:%i:%s:%y:%f:%u:%g' -- "$1"
}

rename_abort() {
  kdialog --title "$(gettext 'Kim')" --error "$*" || true
  die "$*"
}

action_rename() {
  [ "$#" -ge 2 ] || rename_abort "rename: missing mode or files"
  local mode="$1" output_dir='' interactive=false
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --output-dir)
        [ "$#" -ge 2 ] || rename_abort "rename: missing destination directory"
        [ -n "$2" ] || rename_abort "rename: empty destination directory"
        [ -z "$output_dir" ] || rename_abort "rename: duplicate destination directory"
        output_dir="$2"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [ "$#" -gt 0 ] || rename_abort "rename: no selected files"
  local prefix='' suffix='' from='' to='' date_format='' preset action_mode
  local number=1 padding=3 sequence_base='' destination_choice
  if [ "$mode" = interactive ]; then
    interactive=true
    mode="$(kdialog --radiolist "$(gettext 'Rename mode:')" \
      sequential "$(gettext 'Sequential numbering')" on \
      exifdate "$(gettext 'EXIF date')" off \
      lowercase "$(gettext 'Lowercase')" off uppercase "$(gettext 'Uppercase')" off \
      spacestodash "$(gettext 'Spaces to dashes')" off dashestospace "$(gettext 'Dashes to spaces')" off \
      addprefix "$(gettext 'Add prefix')" off addsuffix "$(gettext 'Add suffix')" off \
      overwrite "$(gettext 'Replace text')" off)" || return 1
  fi
  case "$mode" in
    addprefix) prefix="$(kdialog --inputbox "$(gettext 'Prefix to add:')" '')" || return 1 ;;
    addsuffix) suffix="$(kdialog --inputbox "$(gettext 'Suffix to add:')" '')" || return 1 ;;
    overwrite)
      from="$(kdialog --inputbox "$(gettext 'Text to overwrite:')" '')" || return 1
      [ -n "$from" ] || rename_abort "rename: replacement text must not be empty"
      to="$(kdialog --inputbox "$(gettext 'Overwrite with:')" '')" || return 1 ;;
    exifdate)
      preset="$(kdialog --radiolist "$(gettext 'EXIF date rename pattern:')" \
        1 'YYYYMMDD_HHMMSS.ext' on \
        2 'YYYY-MM-DD_HH-MM-SS.ext' off \
        3 'YYYY-DD-MM_HH-MM-SS.ext' off \
        4 'IMG-YYYYMMDD_HHMMSS.ext' off)" || return 1
      case "$preset" in
        1) date_format='%Y%m%d_%H%M%S' ;;
        2) date_format='%Y-%m-%d_%H-%M-%S' ;;
        3) date_format='%Y-%d-%m_%H-%M-%S' ;;
        4) date_format='IMG-%Y%m%d_%H%M%S' ;;
        *) rename_abort "rename: invalid date preset" ;;
      esac ;;
    sequential)
      sequence_base="$(kdialog --inputbox "$(gettext 'Filename base:')" wallpaper_)" || return 1
      number="$(kdialog --inputbox "$(gettext 'Starting number:')" 1)" || return 1
      padding="$(kdialog --inputbox "$(gettext 'Minimum number width (1-18):')" 3)" || return 1
      [[ "$number" =~ ^[0-9]+$ && "$padding" =~ ^[0-9]+$ ]] || rename_abort "rename: invalid numbering"
      while [[ "$number" == 0* && ${#number} -gt 1 ]]; do number="${number#0}"; done
      while [[ "$padding" == 0* && ${#padding} -gt 1 ]]; do padding="${padding#0}"; done
      [ "${#number}" -le 18 ] && [ "${#padding}" -le 2 ] || rename_abort "rename: numbering exceeds supported integer range"
      number=$((10#$number)); padding=$((10#$padding))
      (( padding >= 1 && padding <= 18 )) || rename_abort "rename: number width must be 1-18" ;;
    lowercase|uppercase|spacestodash|dashestospace) ;;
    *) rename_abort "rename: unknown mode" ;;
  esac
  action_mode="$(choose_output_mode "$(gettext 'Kim')" "$(gettext 'Do you want to create new files?')")"
  [ "$action_mode" != cancel ] || return 1
  if [ -z "$output_dir" ] && { [ "$interactive" = true ] || [ "$mode" = sequential ]; }; then
    destination_choice="$(kdialog --radiolist "$(gettext 'Rename destination:')" \
      source "$(gettext 'Each source directory')" on \
      directory "$(gettext 'Choose a destination directory')" off)" || return 1
    case "$destination_choice" in
      source) ;;
      directory) output_dir="$(kdialog --getexistingdirectory "$PWD")" || return 1
                 [ -n "$output_dir" ] || return 1 ;;
      *) return 1 ;;
    esac
  fi
  # LF/CR names cannot be represented safely in the existing dialogs and path
  # helper protocol. Reject the ENTIRE selection before any filesystem changes.
  local value
  for value in "$@" "$output_dir" "$prefix" "$suffix" "$from" "$to" "$sequence_base"; do
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || rename_abort "rename: embedded newlines are unsupported"
  done
  if [ -n "$output_dir" ]; then
    output_dir="$(cd -P -- "$output_dir" && printf '%s/.' "$PWD")" || rename_abort "rename: invalid destination directory"
    output_dir="${output_dir%/.}"
    [[ "$output_dir" != *$'\n'* && "$output_dir" != *$'\r'* ]] || rename_abort "rename: embedded newlines are unsupported"
  fi
  local -a sources=() targets=() stamps=() time_refs=()
  local -A selected=() identities=() reserved=()
  local source parent base stem ext newstem target destination stamp identity tag date_value n
  # Normalize every selected path independently; never borrow another image's
  # directory. Reject links and duplicate identities before computing mappings.
  for source in "$@"; do
    [[ "$source" = /* ]] || source="$PWD/$source"
    # Sentinel keeps trailing LF/CR in a physical parent visible for rejection;
    # ordinary $(pwd) could strip it and select an entirely different directory.
    parent="$(cd -P -- "$(dirname -- "$source")" && printf '%s/.' "$PWD")" || rename_abort "rename: invalid source directory"
    parent="${parent%/.}"
    source="$parent/${source##*/}"
    [[ "$source" != *$'\n'* && "$source" != *$'\r'* ]] || rename_abort "rename: embedded newlines are unsupported"
    [ ! -L "$source" ] && [ -f "$source" ] || rename_abort "rename: selected source is not a regular file: $source"
    [ "$(stat -c '%h' -- "$source")" = 1 ] || rename_abort "rename: hardlinked source is ambiguous: $source"
    identity="$(stat -c '%d:%i' -- "$source")" || rename_abort "rename: cannot inspect source: $source"
    [[ -z "${identities[$identity]:-}" ]] || rename_abort "rename: duplicate selected source: $source"
    identities[$identity]=1
    selected[$source]=1
    sources+=("$source")
    stamp="$(rename_source_stamp "$source")" || rename_abort "rename: cannot inspect source: $source"
    stamps+=("$stamp")
    # Metadata-only reference, never a relocated original. Capture before EXIF
    # queries/copy validation can update source access time.
    local time_ref
    time_ref="$(mktemp "$KIMDIR/rename_time_XXXXXX")" || rename_abort "rename: cannot stage timestamps"
    touch -r "$source" -- "$time_ref" || rename_abort "rename: cannot capture source timestamps"
    time_refs+=("$time_ref")
  done
  report_init
  local ref counter=0 index rc tmp source_device target_device interrupted=false published
  ref="$(progress_open "${#sources[@]}" "$(gettext 'Kim - Planning renames ...')")"
  # Complete preflight precedes the first copy/link/removal. EXIF failures are
  # accounted for individually and skipped; all other mapping conflicts abort.
  for source in "${sources[@]}"; do
    if progress_cancelled "$ref"; then report_fail "$source"; progress_close "$ref"; report_finish_dialog "$(gettext 'Kim')"; return 1; fi
    { IFS= read -r parent; IFS= read -r base; IFS= read -r stem; IFS= read -r ext; } < <(split_path "$source")
    case "$mode" in
      lowercase) newstem="$(printf '%s' "$stem" | tr '[:upper:]' '[:lower:]')" ;;
      uppercase) newstem="$(printf '%s' "$stem" | tr '[:lower:]' '[:upper:]')" ;;
      spacestodash) newstem="${stem// /-}" ;;
      dashestospace) newstem="${stem//-/ }" ;;
      addprefix) newstem="$prefix$stem" ;;
      addsuffix) newstem="$stem$suffix" ;;
      overwrite) newstem="${stem//"$from"/"$to"}" ;;
      sequential) printf -v newstem '%s%0*d' "$sequence_base" "$padding" "$number" ;;
      exifdate)
        date_value=''
        for tag in DateTimeOriginal CreateDate ModifyDate; do
          if ! date_value="$(exiftool -s3 "-$tag" -d "$date_format" -- "$source" 2>/dev/null)"; then date_value=''; fi
          [ -z "$date_value" ] || break
        done
        if [ -z "$date_value" ]; then
          report_fail "$source (No EXIF date field found)"; targets+=(''); continue
        fi
        case "$preset" in
          1) [[ "$date_value" =~ ^[0-9]{8}_[0-9]{6}$ ]] || date_value='' ;;
          2|3) [[ "$date_value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$ ]] || date_value='' ;;
          4) [[ "$date_value" =~ ^IMG-[0-9]{8}_[0-9]{6}$ ]] || date_value='' ;;
        esac
        if [ -z "$date_value" ]; then report_fail "$source (Invalid EXIF date)"; targets+=(''); continue; fi
        newstem="$date_value" ;;
    esac
    [[ -n "$newstem" && "$newstem" != . && "$newstem" != .. && "$newstem" != */* && "$newstem" != *$'\n'* && "$newstem" != *$'\r'* ]] || rename_abort "rename: invalid filename stem"
    destination="${output_dir:-$parent}"
    [ -w "$destination" ] && [ -x "$destination" ] || rename_abort "rename: inaccessible destination directory"
    [ -z "$ext" ] || ext=".$ext"
    target="$destination/$newstem$ext"
    if [ "$action_mode" = create ] || [ "$mode" = exifdate ] || [ "$mode" = sequential ]; then
      n=1
      while [ -e "$target" ] || [ -L "$target" ] || [[ -n "${reserved[$target]:-}" ]]; do
        if [ "$action_mode" = overwrite ] && [ "$target" = "$source" ]; then break; fi
        if [ "$mode" = sequential ]; then
          (( number < 999999999999999999 )) || rename_abort "rename: sequence exhausted"
          number=$((number + 1))
          printf -v newstem '%s%0*d' "$sequence_base" "$padding" "$number"
          target="$destination/$newstem$ext"
        else
          target="$destination/${newstem}_${n}$ext"; n=$((n + 1))
        fi
      done
    fi
    if [[ -n "${reserved[$target]:-}" ]] ||
       { [ "$target" != "$source" ] && { [ -e "$target" ] || [ -L "$target" ] || [[ -n "${selected[$target]:-}" ]]; }; }; then
      rename_abort "rename: conflicting destination (no files changed): $target"
    fi
    reserved[$target]=1
    targets+=("$target")
    [ "$mode" != sequential ] || number=$((number + 1))
  done
  for index in "${!sources[@]}"; do
    source="${sources[$index]}"; target="${targets[$index]}"
    counter=$((index + 1))
    if [ -z "$target" ]; then
      progress_value "$ref" "$counter"
      continue
    fi
    if ! progress_begin_item "$ref" "$(gettext 'Kim - Renaming file: ')${source##*/}"; then report_fail "$source"; break; fi
    if progress_cancelled "$ref"; then report_fail "$source"; break; fi
    rc=0; tmp=''; published=false
    stamp="$(rename_source_stamp "$source")" || rc=1
    [ "$stamp" = "${stamps[$index]}" ] || rc=1
    [ "$(stat -c '%h' -- "$source")" = 1 ] || rc=1
    if [ "$rc" -eq 0 ] && [ "$target" = "$source" ] && [ "$action_mode" = overwrite ]; then
      report_ok; progress_value "$ref" "$counter"; continue
    fi
    source_device="$(stat -c '%d' -- "$source")" || rc=1
    target_device="$(stat -c '%d' -- "${target%/*}")" || rc=1
    if [ "$rc" -eq 0 ] && { [ "$action_mode" = create ] || [ "$source_device" != "$target_device" ]; }; then
      if tmp="$(tmp_for_target "$target")"; then
        # A metadata-preserving byte copy, never an image re-encoding. Failure
        # leaves the selected source in place, including across filesystems.
        cp --preserve=mode,ownership,timestamps,xattr -- "$source" "$tmp" || rc=$?
        if [ "$rc" -eq 0 ]; then cmp -s -- "$source" "$tmp" || rc=$?; fi
        if [ "$rc" -eq 0 ]; then
          [ -f "$tmp" ] && [ ! -L "$tmp" ] || rc=1
        fi
        if [ "$rc" -eq 0 ]; then
          chmod --reference="$source" "$tmp" || rc=$?
          if [ "$rc" -eq 0 ]; then touch -r "${time_refs[$index]}" -- "$tmp" || rc=$?; fi
          # Refuse a lossy ownership/permission/mtime transfer, including a
          # destination filesystem that cannot retain source timestamp precision.
          local source_meta target_meta
          source_meta="$(stat -c '%a:%u:%g:%y' -- "$source")" || rc=1
          target_meta="$(stat -c '%a:%u:%g:%y' -- "$tmp")" || rc=1
          [ "$source_meta" = "$target_meta" ] || rc=1
          source_meta="$(stat -c '%x:%y' -- "${time_refs[$index]}")" || rc=1
          target_meta="$(stat -c '%x:%y' -- "$tmp")" || rc=1
          [ "$source_meta" = "$target_meta" ] || rc=1
        fi
      else rc=1; fi
    fi
    stamp="$(rename_source_stamp "$source")" || rc=1
    [ "$stamp" = "${stamps[$index]}" ] || rc=1
    if progress_cancelled "$ref"; then interrupted=true; rc=1; fi
    if [ "$rc" -eq 0 ]; then
      if [ -n "$tmp" ]; then
        if commit_tmp_to_target "$tmp" "$target" create; then published=true; else rc=1; fi
      else
        if ln -T -- "$source" "$target"; then published=true; else rc=1; fi
      fi
    fi
    if [ "$published" = true ] && [ "$action_mode" = overwrite ]; then
      # Cancellation after publication retains both names, never an unsafe
      # rollback. Check source identity again before removing its authorized name.
      if progress_cancelled "$ref"; then interrupted=true; rc=1; fi
      stamp="$(rename_source_stamp "$source")" || rc=1
      [ "$stamp" = "${stamps[$index]}" ] || rc=1
      if [ "$rc" -eq 0 ] && [ -z "$tmp" ]; then
        touch -r "${time_refs[$index]}" -- "$target" || rc=$?
      fi
      if [ "$rc" -eq 0 ]; then rm -- "$source" || rc=$?; fi
    fi
    if [ "$rc" -eq 0 ]; then report_ok
    elif [ "$published" = true ]; then report_fail "$source (Destination retained: $target)"
    else report_fail "$source"; fi
    [ -z "$tmp" ] || rm -f -- "$tmp" || true
    [ "$interrupted" != true ] || break
    progress_value "$ref" "$counter"
  done
  progress_close "$ref"
  report_finish_dialog "$(gettext 'Kim')"
  [ "${REPORT_FAIL:-0}" -eq 0 ]
}

# ---------------------------------------------------------------------------
# action_resize
#
# Resize images using ImageMagick while integrating with kim_all helpers.
#
# Behavior:
# - Prompts for overwrite vs create, consistent with other kim_all actions.
# - Overwrite mode replaces the original file using atomic overwrite logic.
# - Create mode places the resized tag per NAME_AFFIX_POSITION, avoiding collisions.
# - ImageMagick retains image metadata; changed content receives a fresh mtime.
#
# Arguments:
#   $1  SCALE   ImageMagick geometry (e.g. 800x800, 50%)
#   $2  OUTDIR  Optional output directory (Create mode only)
#   $@  FILES   Input files
# ---------------------------------------------------------------------------
action_resize() {
  local SCALE="${1:-}"
  local outdir="${2:-}"
  shift 2 || true

  if [ -z "$SCALE" ]; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Resize: missing scale.')"
    return 1
  fi

  local -a files=()
  collect_valid_files files "$@"
  local nbfiles="${#files[@]}"
  [ "$nbfiles" -le 0 ] && return 0


  local mode
  mode="$(choose_output_mode \
    "$(gettext 'Kim')" \
    "$(gettext 'Do you want to create new files?')")"

  [ "$mode" = "cancel" ] && return 1

  if [ "$mode" = create ] && [ -n "$outdir" ] &&
     { [ ! -d "$outdir" ] || [ ! -w "$outdir" ] || [ ! -x "$outdir" ]; }; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Resize: output directory is unavailable:') $outdir"
    return 1
  fi

  report_init
  local dbusRef
  dbusRef="$(progress_open "$nbfiles" "$(gettext 'Kim - Initialising ...')")"

  local counter=0
  local i dir base stem ext OUTFILE OUTTMP n rc
  local source_info source_frame source_format source_frames produced_frames dimensions expected_dimensions
  local actual actual_dimensions frame format expected_format read_hint decoder_rc
  local interrupted

  for i in "${files[@]}"; do
    counter=$((counter + 1))

    {
      IFS= read -r dir
      IFS= read -r base
      IFS= read -r stem
      IFS= read -r ext
    } < <(split_path "$i")

    if ! progress_begin_item "$dbusRef" "$(gettext 'Kim - Resizing file: ')$base"; then
      report_fail "$i"
      progress_close "$dbusRef"
      report_finish_dialog "$(gettext 'Kim')"
      return 1
    fi

    if progress_cancelled "$dbusRef"; then
      report_fail "$i"
      break
    fi

    rc=0
    source_info=""
    read_hint=""
    case "${ext^^}" in TGA|ICB|VDA|VST) read_hint=TGA ;; esac
    if [[ "$i" != *$'\n'* ]]; then
      source_info="$(identify -regard-warnings +ping -format '%m %w %h\n' - < "$i" 2>/dev/null)" || rc=$?
      if [ "$rc" -ne 0 ] && [ -n "$read_hint" ]; then
        # Targa has no signature. A selected decoder still fully validates its
        # header and pixels; never use a filename alone as evidence of integrity.
        rc=0
        source_info="$(identify -regard-warnings +ping -format '%m %w %h\n' "$read_hint:-" < "$i" 2>/dev/null)" || rc=$?
      fi
    else
      rc=1
    fi
    if [ "$rc" -ne 0 ] || [ -z "$source_info" ]; then
      report_fail "$i"
      progress_value "$dbusRef" "$counter"
      continue
    fi
    if [ "$mode" = "overwrite" ]; then
      OUTFILE="$i"
    else
      local dir2
      dir2="${outdir:-$dir}"
      OUTFILE="$dir2/$(affixed_filename "$stem" resized "$ext")"
      n=1
      while [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; do
        OUTFILE="$dir2/$(affixed_filename "$stem" resized "$ext" "$n")"
        n=$((n + 1))
      done
    fi
    if ! OUTTMP="$(tmp_for_target "$OUTFILE")"; then
      report_fail "$i"
      progress_value "$dbusRef" "$counter"
      continue
    fi
    source_frames=0
    source_format=""
    while IFS= read -r source_frame; do
      if [[ "$source_frame" =~ ^([A-Z0-9]+)\ ([1-9][0-9]*)\ ([1-9][0-9]*)$ ]]; then
        [ -n "$source_format" ] || source_format="${BASH_REMATCH[1]}"
        source_frames=$((source_frames + 1))
      else
        rc=1
        break
      fi
    done <<< "$source_info"
    if [ "$rc" -ne 0 ]; then
      report_fail "$i"
      progress_value "$dbusRef" "$counter"
      continue
    fi
    expected_format="${ext^^}"
    [ -n "$expected_format" ] || expected_format="$source_format"
    case "$expected_format" in
      JPG|JPE|JFIF|JPS|PJPEG) expected_format=JPEG ;;
      TIF|PTIF) expected_format=TIFF ;;
      HEIF) expected_format=HEIC ;;
      ICB|VDA|VST) expected_format=TGA ;;
      J2C|JPC|JPM) expected_format=JP2 ;;
      AI|EPDF|PDFA) expected_format=PDF ;;
      APNG) expected_format=PNG ;;
      PNG00|PNG8|PNG24|PNG32|PNG48|PNG64) expected_format=PNG ;;
      GIF87) expected_format=GIF ;;
    esac

    if progress_cancelled "$dbusRef"; then
      report_fail "$i"
      break
    fi
    rc=0
    # Record dimensions from the sole resize, before encoding. ImageMagick
    # remains responsible for geometry parsing/rounding; no pixel-sized probe
    # or second resize is needed. Validate the encoded file against this stream.
    expected_dimensions="$(magick -- "$i" -resize "$SCALE" -format '%w %h\n' -write info: "$OUTTMP" 2>/dev/null)" || rc=$?
    produced_frames=0
    while IFS= read -r dimensions; do
      if [[ "$dimensions" =~ ^[1-9][0-9]*\ [1-9][0-9]*$ ]]; then
        produced_frames=$((produced_frames + 1))
      else
        rc=1
      fi
    done <<< "$expected_dimensions"
    [ "$produced_frames" -eq "$source_frames" ] || rc=1
    actual=""
    if [ "$rc" -eq 0 ] && [ -s "$OUTTMP" ]; then
      decoder_rc=0
      actual="$(identify -regard-warnings +ping -format '%m %w %h\n' - < "$OUTTMP" 2>/dev/null)" || decoder_rc=$?
      if [ "$decoder_rc" -ne 0 ] && [ "$expected_format" = TGA ]; then
        decoder_rc=0
        actual="$(identify -regard-warnings +ping -format '%m %w %h\n' TGA:- < "$OUTTMP" 2>/dev/null)" || decoder_rc=$?
      fi
      [ "$decoder_rc" -eq 0 ] || rc="$decoder_rc"
    fi
    [ -n "$actual" ] || rc=1
    actual_dimensions=""
    while IFS= read -r frame; do
      if [[ "$frame" =~ ^([A-Z0-9]+)\ ([1-9][0-9]*)\ ([1-9][0-9]*)$ ]]; then
        format="${BASH_REMATCH[1]}"
        actual_dimensions+="${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"$'\n'
        if [ "$expected_format" = PNM ]; then
          case "$format" in PBM|PGM|PPM|PAM) ;; *) rc=1 ;; esac
        elif [ "$format" != "$expected_format" ]; then
          rc=1
        fi
      else
        rc=1
      fi
    done <<< "$actual"
    [ "${actual_dimensions%$'\n'}" = "$expected_dimensions" ] || rc=1
    if [ "$rc" -eq 0 ]; then
      chmod --reference="$i" "$OUTTMP" || rc=$?
    fi
    interrupted=false
    if progress_cancelled "$dbusRef"; then interrupted=true; fi
    [ "$interrupted" != true ] || rc=1
    if [ "$rc" -eq 0 ] && commit_tmp_to_target "$OUTTMP" "$OUTFILE" "$mode"; then
      report_ok
    else
      report_fail "$i"
    fi
    rm -f -- "$OUTTMP" >/dev/null 2>&1 || true
    [ "$interrupted" != true ] || break

    progress_value "$dbusRef" "$counter"
  done

  progress_close "$dbusRef"
  report_finish_dialog "$(gettext 'Kim')"
  true
}

# ---------------------------------------------------------------------------
# action_resizeandsend
#
# Prepare images for email delivery and open a mail client with attachments.
#
# Behavior:
# - Prompts for a target size (full size or common email-friendly dimensions).
# - Resized copies are written to the temporary kim_all workspace.
# - Original files are never modified.
# - Attempts to open an email client with the resized files attached.
#
# Arguments:
#   $@  FILES   Input files
# ---------------------------------------------------------------------------

action_resizeandsend() {
  local size='' i base stem output_ext coder input_info input_format input_frames
  local output_info record actual_format actual_width actual_height output_frames rc counter=0
  local source_width source_height orientation expected_dimensions source_dimensions
  local interrupted=false persistent_dir client='' handoff=0 attachment_csv uri escaped byte
  local -a files=() prepared=() attach_paths=() mail_args=() input_dimensions=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --size)
        [ "$#" -ge 2 ] || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Email resize: --size needs a value.')"; return 2; }
        size="$2"; shift 2 ;;
      --)
        shift; files+=("$@"); break ;;
      --*) kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Email resize: unknown option.')"; return 2 ;;
      *) files+=("$1"); shift ;;
    esac
  done
  if ! collect_publication_inputs files "${files[@]}"; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Email resize: select regular, unambiguous image files.')"
    return 1
  fi
  local nbfiles="${#files[@]}"
  [ "$nbfiles" -gt 0 ] || return 0

  if [ -z "$size" ]; then
    local choice
    choice="$(kdialog --radiolist "$(gettext 'Kim - Send by mail:')" \
      1 "$(gettext 'Full size')" off \
      2 "$(gettext '1600x1600 px')" on \
      3 "$(gettext '1200x1200 px')" off \
      4 "$(gettext '800x800 px')" off \
      5 "$(gettext '600x600 px')" off \
      6 "$(gettext '300x300 px')" off \
      7 "$(gettext 'Custom size...')" off)" || return 0
    case "$choice" in
      1) size=full ;; 2) size=1600x1600 ;; 3) size=1200x1200 ;; 4) size=800x800 ;;
      5) size=600x600 ;; 6) size=300x300 ;;
      7) size="$(kdialog --inputbox "$(gettext 'Enter custom size (WIDTHxHEIGHT):')" '1600x1600')" || return 0 ;;
      *) return 0 ;;
    esac
  fi
  if [ "$size" != full ] && ! [[ "$size" =~ ^([1-9][0-9]{0,8})x([1-9][0-9]{0,8})$ ]]; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Email resize: size must be full or positive WIDTHxHEIGHT.')"
    return 1
  fi
  local max_width=0 max_height=0
  if [ "$size" != full ]; then max_width="${BASH_REMATCH[1]}"; max_height="${BASH_REMATCH[2]}"; fi

  report_init
  local dbusRef
  dbusRef="$(progress_open "$nbfiles" "$(gettext 'Kim - Initialising ...')")"
  local stage_index=0 out
  for i in "${files[@]}"; do
    counter=$((counter + 1))
    if ! progress_begin_item "$dbusRef" "$(gettext 'Kim - Preparing email image: ')${i##*/}"; then
      interrupted=true
      break
    fi
    base="${i##*/}"
    if [[ "$base" == .* && "$base" != *.*.* ]]; then stem="$base"; else stem="${base%.*}"; fi
    rc=0
    input_dimensions=()
    input_info="$(identify -ping -format '%m|%w|%h|%[orientation]|%n\n' - < "$i" 2>/dev/null)" || rc=1
    input_format=''; input_frames=0
    while IFS= read -r record; do
      IFS='|' read -r actual_format source_width source_height orientation _ <<< "$record"
      [[ "$actual_format" =~ ^[A-Za-z0-9]+$ && "$source_width" =~ ^[1-9][0-9]*$ &&
         "$source_height" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
      [ -n "$input_format" ] || input_format="$actual_format"
      [ "$input_format" = "$actual_format" ] || { rc=1; break; }
      source_dimensions="${source_width}x${source_height}"
      [ "$size" = full ] || source_dimensions="$(oriented_image_dimensions "$source_width" "$source_height" "$orientation")"
      input_dimensions+=("$source_dimensions")
      input_frames=$((input_frames + 1))
    done <<< "$input_info"
    [ "$input_frames" -gt 0 ] || rc=1
    coder="$input_format"
    output_ext="$(image_format_extension "$input_format")"
    [ -n "$output_ext" ] || rc=1
    stage_index=$((stage_index + 1))
    out="$KIMDIR/${stem}__send_${stage_index}.${output_ext}"
    if [ "$rc" -eq 0 ] && [ "$size" = full ]; then
      cp -- "$i" "$out" >/dev/null 2>&1 || rc=$?
    elif [ "$rc" -eq 0 ]; then
      magick - -auto-orient -resize "$size" "$coder:$out" < "$i" >/dev/null 2>&1 || rc=$?
    fi
    if progress_cancelled "$dbusRef"; then interrupted=true; rc=1; fi
    output_info=''
    if [ "$rc" -eq 0 ] && [ -s "$out" ]; then
      output_info="$(identify -regard-warnings -format '%m|%w|%h|%T|%n|%#\n' - < "$out" 2>/dev/null)" || rc=1
    else
      rc=1
    fi
    output_frames=0
    while IFS= read -r record; do
      [ "$output_frames" -lt "$input_frames" ] || { rc=1; break; }
      IFS='|' read -r actual_format actual_width actual_height _ _ _ <<< "$record"
      [ "$(image_format_class "$actual_format")" = "$(image_format_class "$input_format")" ] &&
        [[ "$actual_width" =~ ^[1-9][0-9]*$ && "$actual_height" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
      if [ "$size" = full ]; then
        # Full-size mode is an exact byte copy, so each frame keeps dimensions.
        expected_dimensions="${input_dimensions[output_frames]}"
      else
        expected_dimensions="$(resize_fit_dimensions "${input_dimensions[output_frames]}" "$max_width" "$max_height")"
      fi
      [ "${actual_width}x${actual_height}" = "$expected_dimensions" ] || { rc=1; break; }
      output_frames=$((output_frames + 1))
    done <<< "$output_info"
    [ "$output_frames" -eq "$input_frames" ] || rc=1
    if [ "$rc" -eq 0 ] && [ "$interrupted" != true ]; then
      prepared+=("$out")
      report_ok
    else
      rm -f -- "$out" >/dev/null 2>&1 || true
      report_fail "$i"
    fi
    [ "$interrupted" != true ] || break
    progress_value "$dbusRef" "$counter" || { interrupted=true; break; }
  done
  local persistent_base="${XDG_DATA_HOME:-$HOME/.local/share}/kim6/email-attachments"
  if [ "${#prepared[@]}" -eq 0 ]; then
    progress_close "$dbusRef"
    report_finish_dialog "$(gettext 'Kim')"
    return 1
  fi
  if progress_cancelled "$dbusRef"; then interrupted=true; fi
  mkdir -p -- "$persistent_base" || {
    progress_close "$dbusRef"
    report_fail "$(gettext 'email attachment storage')"
    report_finish_dialog "$(gettext 'Kim')"
    return 1
  }
  persistent_dir="$(mktemp -d "$persistent_base/attachments.XXXXXX")" || {
    progress_close "$dbusRef"
    report_fail "$(gettext 'email attachment storage')"
    report_finish_dialog "$(gettext 'Kim')"
    return 1
  }
  for out in "${prepared[@]}"; do
    if ! cp -- "$out" "$persistent_dir/${out##*/}" >/dev/null 2>&1; then
      rm -rf -- "$persistent_dir"
      progress_close "$dbusRef"
      report_fail "$(gettext 'email attachment copy')"
      report_finish_dialog "$(gettext 'Kim')"
      return 1
    fi
    attach_paths+=("$persistent_dir/${out##*/}")
  done
  if progress_cancelled "$dbusRef"; then interrupted=true; fi
  progress_close "$dbusRef"
  if [ "$interrupted" = true ]; then
    kdialog --title "$(gettext 'Kim')" --msgbox "$(gettext 'Processing stopped. Completed attachments were kept here (not attached):') $persistent_dir"
    report_finish_dialog "$(gettext 'Kim')"
    return 1
  fi

  if command -v kmail >/dev/null 2>&1; then
    client=kmail
    for out in "${attach_paths[@]}"; do mail_args+=(--attach "$out"); done
    kmail "${mail_args[@]}" >/dev/null 2>&1 || handoff=$?
  elif command -v thunderbird >/dev/null 2>&1; then
    client=thunderbird
    attachment_csv=''
    local LC_ALL=C char_index char
    for out in "${attach_paths[@]}"; do
      escaped=''
      for ((char_index=0; char_index<${#out}; char_index++)); do
        char="${out:char_index:1}"
        case "$char" in [a-zA-Z0-9/._~-]) escaped+="$char" ;; *) printf -v byte '%02X' "'${char}"; escaped+="%${byte}" ;; esac
      done
      uri="file://$escaped"
      [ -z "$attachment_csv" ] || attachment_csv+=,
      attachment_csv+="$uri"
    done
    thunderbird -compose "attachment='$attachment_csv'" >/dev/null 2>&1 || handoff=$?
  elif command -v xdg-email >/dev/null 2>&1; then
    client=xdg-email
    for out in "${attach_paths[@]}"; do mail_args+=(--attach "$out"); done
    xdg-email "${mail_args[@]}" >/dev/null 2>&1 || handoff=$?
  fi

  if [ -z "$client" ]; then
    kdialog --title "$(gettext 'Kim')" --msgbox "$(gettext "No supported mail client was found. Prepared images are kept here; attach them manually and delete the folder when finished:") $persistent_dir"
  elif [ "$handoff" -ne 0 ]; then
    rm -rf -- "$persistent_dir"
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'The mail client could not accept the prepared attachments.')"
    report_fail "$client"
    report_finish_dialog "$(gettext 'Kim')"
    return 1
  else
    kdialog --title "$(gettext 'Kim')" --msgbox "$(gettext 'The mail client was opened. Prepared attachments remain here until you delete them:') $persistent_dir"
  fi
  report_finish_dialog "$(gettext 'Kim')"
  [ "$interrupted" != true ] && [ "$REPORT_FAIL" -eq 0 ]
}


####################
# Rotate selected originals using validated ImageMagick staging and replacement.
#
# Usage: rotate <angle|EXIF> <files...>
#
# Behavior:
# - If angle is "EXIF", uses -auto-orient (EXIF-based orientation fix).
# - Otherwise accepts signed decimal angles and ImageMagick < / > conditions.
# - Replaces the selected original only after successful output validation.
# - Requires permission and nanosecond timestamp preparation before replacement.
# - Uses a progress dialog and supports Cancel.
#
# Notes:
# - Uses one ImageMagick transformation, full decoding and K12 publication.

# Rotation retains nanosecond mtime; flip/flop retains its historical fresh
# mtime. Both remain explicitly in-place actions, independent of KIM_POLICY.
# All generated bytes stay in a private destination-local stage until validated.
# ImageMagick may duplicate an identical ICC into EXIF and the image container.
# Compare profile contents, not those locations. Conflicting profiles are
# ambiguous: fail safely rather than guess which color interpretation to retain.
transform_icc_records() {
  local json line records=''
  local key='^[[:space:]]*"[A-Za-z0-9_:.-]*ICC_Profile":'
  local value='^[[:space:]]*"([A-Za-z0-9_:.-]*ICC_Profile)":[[:space:]]*"(base64:[A-Za-z0-9+/=]+|-)"[,]?[[:space:]]*$'
  json="$(exiftool -j -b -f -a -G1:4 -ICC_Profile -- "$1" 2>/dev/null)" || return 1
  while IFS= read -r line; do
    if [[ "$line" =~ $key ]]; then
      [[ "$line" =~ $value ]] || return 1
      if [ -n "$records" ] && [ "$records" != "${BASH_REMATCH[2]}" ]; then return 1; fi
      records="${BASH_REMATCH[2]}"
    fi
  done <<< "$json"
  [ -n "$records" ] || return 1
  printf '%s' "$records"
}

action_transform_in_place() {
  local timestamp_policy="$1" operation="$2"
  shift 2
  local -a transform=("$operation") files=()
  if [ "$operation" = -rotate ]; then transform+=("$1"); shift; fi
  collect_valid_files files "$@"
  [ "${#files[@]}" -gt 0 ] || return 0
  report_init
  local ref i tmp rc interrupted counter=0 source_info actual expected frame format count produced
  local dimensions actual_dimensions identity source_icc actual_icc read_hint fixed_dimensions swap
  local -A seen=()
  ref="$(progress_open "${#files[@]}" "$(gettext 'Kim - Transforming images ...')")"
  for i in "${files[@]}"; do
    counter=$((counter + 1))
    if ! progress_begin_item "$ref" "$(gettext 'Kim - Processing file: ')${i##*/}"; then
      report_fail "$i"
      break
    fi
    if progress_cancelled "$ref"; then report_fail "$i"; break; fi
    rc=0
    # Refuse ambiguous ImageMagick filename syntax and destination links.
    # Repeated selections/parent aliases must not transform the same inode twice.
    if [ -L "$i" ] || [[ "$i" == *[$'\n\r[]%:*?\\']* ]]; then rc=1; fi
    identity="$(stat -c '%d:%i' -- "$i")" || rc=1
    [ "$(stat -c '%h' -- "$i")" = 1 ] || rc=1
    if [ -n "$identity" ]; then
      if [[ -n "${seen[$identity]:-}" ]]; then rc=1; fi
      seen[$identity]=1
    else rc=1; fi
    source_info=''
    read_hint='-'
    if [ "$rc" -eq 0 ]; then
      source_info="$(identify -regard-warnings +ping -format '%m %w %h\n' - < "$i" 2>/dev/null)" || rc=$?
      # Targa lacks a signature. As in resize, permit a fully decoded TGA
      # fallback for its established extensions, never an extension-only check.
      case "${i##*.}" in
        tga|TGA|icb|ICB|vda|VDA|vst|VST)
          if [ "$rc" -ne 0 ]; then
            rc=0
            read_hint=TGA:-
            source_info="$(identify -regard-warnings +ping -format '%m %w %h\n' "$read_hint" < "$i" 2>/dev/null)" || rc=$?
          fi ;;
      esac
    fi
    count=0
    format=''
    fixed_dimensions=''
    swap=unknown
    case "$operation" in
      -flip|-flop) swap=false ;;
      -rotate)
        case "${transform[1]#+}" in
          90|-90|270|-270) swap=true ;;
          0|180|-180|360|-360) swap=false ;;
        esac ;;
    esac
    while IFS= read -r frame; do
      if [[ "$frame" =~ ^([A-Z0-9]+)\ ([1-9][0-9]*)\ ([1-9][0-9]*)$ ]]; then
        [ -n "$format" ] || format="${BASH_REMATCH[1]}"
        [ "$format" = "${BASH_REMATCH[1]}" ] || rc=1
        if [ "$swap" = true ]; then
          fixed_dimensions+="${BASH_REMATCH[3]} ${BASH_REMATCH[2]}"$'\n'
        elif [ "$swap" = false ]; then
          fixed_dimensions+="${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"$'\n'
        fi
        count=$((count + 1))
      else rc=1; fi
    done <<< "$source_info"
    if [ "$rc" -ne 0 ]; then report_fail "$i"; progress_value "$ref" "$counter"; continue; fi
    if ! tmp="$(tmp_for_target "$i")"; then
      report_fail "$i"; progress_value "$ref" "$counter"; continue
    fi
    if progress_cancelled "$ref"; then report_fail "$i"; break; fi
    # A single transformation reports its dimensions before encoding. Full
    # decoding below verifies the encoded frames without a second transformation.
    # Explicit encoder retains actual input encoding even for a missing or
    # misleading extension; a rotation must not silently convert the image.
    expected="$(magick -- "$i" "${transform[@]}" -format '%w %h\n' -write info: "$format:$tmp" 2>/dev/null)" || rc=$?
    produced=0
    while IFS= read -r dimensions; do
      if [[ "$dimensions" =~ ^[1-9][0-9]*\ [1-9][0-9]*$ ]]; then
        produced=$((produced + 1))
      else rc=1; fi
    done <<< "$expected"
    [ "$produced" -eq "$count" ] || rc=1
    # Independently check the basic transforms. Arbitrary/conditional angles
    # remain ImageMagick's grammar; real pixel/dimension fixtures cover those.
    if [ "$swap" != unknown ]; then
      [ "$expected" = "${fixed_dimensions%$'\n'}" ] || rc=1
    fi
    actual=''
    if [ "$rc" -eq 0 ] && [ -s "$tmp" ]; then
      actual="$(identify -regard-warnings +ping -format '%m %w %h\n' "$read_hint" < "$tmp" 2>/dev/null)" || rc=$?
    fi
    actual_dimensions=''
    while IFS= read -r frame; do
      if [[ "$frame" =~ ^([A-Z0-9]+)\ ([1-9][0-9]*)\ ([1-9][0-9]*)$ ]]; then
        [ "${BASH_REMATCH[1]}" = "$format" ] || rc=1
        actual_dimensions+="${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"$'\n'
      else rc=1; fi
    done <<< "$actual"
    [ "${actual_dimensions%$'\n'}" = "$expected" ] || rc=1
    if [ "$rc" -eq 0 ]; then
      source_icc="$(transform_icc_records "$i")" || rc=$?
      actual_icc="$(transform_icc_records "$tmp")" || rc=$?
      [ "$source_icc" = "$actual_icc" ] || rc=1
    fi
    if [ "$rc" -eq 0 ]; then
      chmod --reference="$i" "$tmp" || rc=$?
      if [ "$rc" -eq 0 ] && [ "$timestamp_policy" = preserve ]; then
        touch -r "$i" -- "$tmp" || rc=$?
      fi
    fi
    interrupted=false
    if progress_cancelled "$ref"; then interrupted=true; rc=1; fi
    if [ "$rc" -eq 0 ] && commit_tmp_to_target "$tmp" "$i" overwrite; then
      report_ok
      # Atomic replacement changes inode: remember the replacement too so a
      # repeated path or safely resolved parent alias is not transformed again.
      identity="$(stat -c '%d:%i' -- "$i")" && seen[$identity]=1
    else report_fail "$i"; fi
    rm -f -- "$tmp" || true
    [ "$interrupted" != true ] || break
    progress_value "$ref" "$counter"
  done
  progress_close "$ref"
  report_finish_dialog "$(gettext 'Kim')"
  true
}

action_rotate() {
  [ "$#" -ge 2 ] || die "rotate: missing angle or files"
  local angle="$1"
  shift
  if [ "$angle" = EXIF ]; then
    action_transform_in_place preserve -auto-orient "$@"
  else
    # ImageMagick's useful decimal, signed and conditional-angle grammar.
    [[ "$angle" =~ ^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)[\<\>]?$ ]] || die "rotate: invalid angle"
    action_transform_in_place preserve -rotate "$angle" "$@"
  fi
}

####################
# Convenience wrapper for EXIF-based rotation (auto-orient).
#
# Usage: rotatewithexif <files...>
#
# Behavior:
# - Equivalent to: rotate EXIF <files...>

action_rotatewithexif() {
  [ "$#" -ge 1 ] || die "rotatewithexif: missing files"
  action_rotate EXIF "$@"
}

####################
# Strip metadata from images using ExifTool while keeping ICC profile and orientation.
#
# Usage: stripmeta <files...>
#
# Behavior:
# - Create vs overwrite is controlled by:
#   - KIM_POLICY=create   forces create mode
#   - KIM_POLICY=overwrite  forces overwrite mode
#   - otherwise prompts the user (Create new / overwrite existing / Cancel)
# - overwrite mode:
#   - Writes to a temp output file, then overwrites the original if output looks valid.
#   - Preserves original timestamps best-effort.
# - Create mode:
#   - Writes a new sibling file using (suffix default):
#       <name>_stripped.<ext>   (or <name>_stripped if no extension)
#     NAME_AFFIX_POSITION=prefix places stripped before the complete stem.
#     Never overwrites: adds -1, -2, ... if needed.
#   - Preserves original timestamps best-effort.
# - Uses a progress dialog and supports Cancel.
#
# Notes:
# - Uses `exiftool` for metadata stripping, keeping ICC profile and Orientation.

action_stripmeta() {
  local -a files=()
  collect_valid_files files "$@"
  local nbfiles="${#files[@]}"
  [ "$nbfiles" -le 0 ] && return 0

  local mode
  mode="$(choose_output_mode \
    "$(gettext 'Kim')" \
    "$(gettext 'Do you want to create new files?')")"
  [ "$mode" != cancel ] || return 1

  report_init
  local dbusRef interrupted
  dbusRef="$(progress_open "$nbfiles" "$(gettext 'Kim - Initialising ...')")"
  local counter=0 i dir base stem ext OUTFILE OUTTMP n rc source_info actual frame read_hint
  # Compare decoded pixels as well as encoding, dimensions, frame order/count,
  # orientation, colorspace, gamma, frame canvas and timing/disposal.
  # No re-encoding or auto-orientation.
  local candidate profile_json profile_line profile_records source_icc actual_icc
  # ExifTool serializes forced binary values as base64 (or '-' when absent).
  # Compare every ICC occurrence, including duplicate profiles and their container locations.
  local icc_key_pattern='^[[:space:]]*"[A-Za-z0-9_:.-]*ICC_Profile":'
  local icc_value_pattern='^[[:space:]]*"([A-Za-z0-9_:.-]*ICC_Profile)":[[:space:]]*"(base64:[A-Za-z0-9+/=]+|-)"[,]?[[:space:]]*$'
  local image_format='%m %w %h %[orientation] %[colorspace] %[gamma] %g %T %D %#\n'

  for i in "${files[@]}"; do
    counter=$((counter + 1))
    {
      IFS= read -r dir
      IFS= read -r base
      IFS= read -r stem
      IFS= read -r ext
    } < <(split_path "$i")

    if ! progress_begin_item "$dbusRef" "$(gettext 'Kim - Stripping metadata from file: ')$base"; then
      # Preserve stripmeta failure accounting when the shared check stops early.
      report_fail "$i"
      progress_close "$dbusRef"
      report_finish_dialog "$(gettext 'Kim')"
      return 1
    fi
    if progress_cancelled "$dbusRef"; then
      report_fail "$i"
      break
    fi

    read_hint='-'
    rc=0
    source_info="$(identify -regard-warnings +ping -format "$image_format" - < "$i" 2>/dev/null)" || rc=$?
    case "${ext^^}" in
      TGA|ICB|VDA|VST)
        if [ "$rc" -ne 0 ]; then
          read_hint=TGA:-
          rc=0
          source_info="$(identify -regard-warnings +ping -format "$image_format" "$read_hint" < "$i" 2>/dev/null)" || rc=$?
        fi ;;
    esac
    [ -n "$source_info" ] || rc=1
    while IFS= read -r frame; do
      [[ "$frame" =~ ^[A-Z0-9]+\ [1-9][0-9]*\ [1-9][0-9]*\ [A-Za-z]+\ [A-Za-z0-9]+\ [0-9.eE+-]+\ [0-9x+-]+\ [0-9]+\ [A-Za-z]+\ [0-9a-f]{64}$ ]] || rc=1
    done <<< "$source_info"
    if [ "$rc" -ne 0 ]; then
      report_fail "$i"
      progress_value "$dbusRef" "$counter"
      continue
    fi

    if [ "$mode" = overwrite ]; then
      OUTFILE="$i"
    else
      OUTFILE="$dir/$(affixed_filename "$stem" stripped "$ext")"
      n=1
      while [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; do
        OUTFILE="$dir/$(affixed_filename "$stem" stripped "$ext" "$n" "-")"
        n=$((n + 1))
      done
    fi
    if ! OUTTMP="$(tmp_for_target "$OUTFILE")"; then
      report_fail "$i"
      progress_value "$dbusRef" "$counter"
      continue
    fi
    if progress_cancelled "$dbusRef"; then
      report_fail "$i"
      break
    fi
    rc=0
    # Preserve the existing removal policy: restore only ICC and Orientation.
    exiftool -all= -tagsfromfile "$i" -icc_profile -Orientation \
      -o "$OUTTMP" -- "$i" >/dev/null 2>&1 || rc=$?
    actual=''
    if [ "$rc" -eq 0 ] && [ -s "$OUTTMP" ]; then
      actual="$(identify -regard-warnings +ping -format "$image_format" "$read_hint" < "$OUTTMP" 2>/dev/null)" || rc=$?
    fi
    [ -n "$actual" ] && [ "$actual" = "$source_info" ] || rc=1
    if [ "$rc" -eq 0 ]; then
      source_icc=''
      actual_icc=''
      for candidate in "$i" "$OUTTMP"; do
        profile_json="$(exiftool -j -b -f -a -G1:4 -ICC_Profile -- "$candidate" 2>/dev/null)" || rc=$?
        [ "$rc" -eq 0 ] || break
        profile_records=''
        while IFS= read -r profile_line; do
          if [[ "$profile_line" =~ $icc_key_pattern ]]; then
            if [[ "$profile_line" =~ $icc_value_pattern ]]; then
              profile_records+="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"$'\n'
            else
              rc=1
              break
            fi
          fi
        done <<< "$profile_json"
        [ -n "$profile_records" ] || rc=1
        [ "$rc" -eq 0 ] || break
        if [ "$candidate" = "$i" ]; then
          source_icc="$profile_records"
        else
          actual_icc="$profile_records"
        fi
      done
      [ "$source_icc" = "$actual_icc" ] || rc=1
    fi
    if [ "$rc" -eq 0 ]; then
      # Stripping changes metadata only: unlike resize/compression, keep mtime.
      chmod --reference="$i" "$OUTTMP" || rc=$?
      if [ "$rc" -eq 0 ]; then
        touch -r "$i" -- "$OUTTMP" || rc=$?
      fi
    fi
    interrupted=false
    if progress_cancelled "$dbusRef"; then interrupted=true; fi
    [ "$interrupted" != true ] || rc=1
    if [ "$rc" -eq 0 ] && commit_tmp_to_target "$OUTTMP" "$OUTFILE" "$mode"; then
      report_ok
    else
      report_fail "$i"
    fi
    rm -f -- "$OUTTMP" >/dev/null 2>&1 || true
    [ "$interrupted" != true ] || break
    progress_value "$dbusRef" "$counter"
  done
  progress_close "$dbusRef"
  report_finish_dialog "$(gettext 'Kim')"
  true
}

####################
# Export images for web use by resizing and compressing.
#
# Usage: webexport <dir> <files...>
#
# Behavior:
# - Uses <dir> as the export directory, prompting if it is not usable.
# - Prompts for:
#   - Maximum image size (example: 1600x1600)
#   - JPEG quality (1–100), default comes from KIM_WEB_QUALITY (fallback 75)
# - Always creates derived exports, regardless of KIM_POLICY.
# - Writes <name>_web.<ext> by default, or web_<name>.<ext> in prefix mode.
# - Adds _1, _2, ... for existing names.
# - Original images are never replacement targets.
# - Exports do NOT preserve original timestamps.
# - Uses a progress dialog and supports Cancel.
#
# Notes:
# - Uses `magick` for resize and compression.

action_webexport() {
  local outdir='' size='' quality='' fmt='' explicit_dir=false
  local -a files=()
  if [ "${1:-}" = "--" ] || [[ "${1:-}" == --* ]]; then
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --size|--quality|--format|--output-dir)
          [ "$#" -ge 2 ] || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'webexport: option value missing.')"; return 2; }
          case "$1" in
            --size) size="$2" ;; --quality) quality="$2" ;; --format) fmt="$2" ;;
            --output-dir) outdir="$2"; explicit_dir=true ;;
          esac
          shift 2 ;;
        --) shift; files+=("$@"); break ;;
        *) kdialog --title "$(gettext 'Kim')" --error "$(gettext 'webexport: use -- before input files.')"; return 2 ;;
      esac
    done
  elif [ "$#" -gt 0 ]; then
    # Preserve the established dispatcher contract: directory first, then files.
    outdir="$1"
    shift
  fi
  if [ "${#files[@]}" -eq 0 ]; then files+=("$@"); fi
  if ! collect_publication_inputs files "${files[@]}"; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'webexport: select regular, unambiguous image files.')"
    return 1
  fi
  local nbfiles="${#files[@]}"
  [ "$nbfiles" -le 0 ] && return 0

  if [ -z "$size" ]; then
    size="$(kdialog --inputbox "$(gettext 'Max image size (e.g. 1600x1600):')" "1600x1600")" || return 1
  fi
  [[ "$size" =~ ^([1-9][0-9]{0,8})x([1-9][0-9]{0,8})$ ]] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'webexport: size must be positive WIDTHxHEIGHT.')"; return 1;
  }
  local max_width="${BASH_REMATCH[1]}" max_height="${BASH_REMATCH[2]}"

  if [ -z "$quality" ]; then
    quality="$(kdialog --inputbox "$(gettext 'Quality (1-100):')" "${KIM_WEB_QUALITY:-75}")" || return 1
  fi
  [[ "$quality" =~ ^[0-9]{1,3}$ ]] && [ "$quality" -ge 1 ] && [ "$quality" -le 100 ] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'webexport: quality must be between 1 and 100.')"; return 1;
  }

  # Export format is independent of the policy used for image-editing actions.
  fmt="${fmt:-${KIM_WEB_FORMAT:-jpg}}"
  fmt="${fmt,,}"
  case "$fmt" in
    jpeg) fmt="jpg" ;;
  esac

  case "$fmt" in
    jpg|webp|avif|keep) : ;;
    *) die "webexport: invalid KIM_WEB_FORMAT: $fmt" ;;
  esac

  # Always honor the export directory, including under KIM_POLICY=overwrite.
  if [ -z "$outdir" ]; then
    outdir="$(kdialog --getexistingdirectory "${PWD}")" || return 1
    [ -n "$outdir" ] || return 1
  elif [ ! -d "$outdir" ] || [ ! -w "$outdir" ] || [ ! -x "$outdir" ]; then
    if [ "$explicit_dir" = true ]; then
      kdialog --title "$(gettext 'Kim')" --error "$(gettext 'webexport: output directory is not accessible.')"
      return 1
    fi
    outdir="$(kdialog --getexistingdirectory "${PWD}")" || return 1
    [ -n "$outdir" ] || return 1
  fi

  outdir="$(cd -P -- "$outdir" && pwd -P)" || return 1

  report_init

  local dbusRef
  dbusRef="$(progress_open "$nbfiles" "$(gettext 'Kim - Web exporting images ...')")"

  local counter=0
  local i dir2 base stem ext out_ext OUTFILE OUTTMP n rc input_info input_format source_frames
  local output_records record actual_format actual_width actual_height actual_frames
  local expected_format coder
  local source_width source_height orientation expected_dimensions source_dimensions
  local -a input_dimensions=()
  local interrupted=false failures=0 published=false

  for i in "${files[@]}"; do
    counter=$((counter + 1))

    {
      read -r dir2
      read -r base
      read -r stem
      read -r ext
    } < <(split_path "$i")

    if ! progress_begin_item "$dbusRef" "$(gettext 'Kim - Exporting file: ')$base"; then
      progress_close "$dbusRef"
      report_finish_dialog "$(gettext 'Kim')"
      return 1
    fi

    rc=0
    if progress_cancelled "$dbusRef"; then interrupted=true; break; fi

    input_info="$(identify -ping -format '%m|%w|%h|%[orientation]|%n\n' - < "$i" 2>/dev/null)" || rc=1
    input_format=''
    source_frames=0
    input_dimensions=()
    while IFS= read -r record; do
      IFS='|' read -r actual_format source_width source_height orientation _ <<< "$record"
      [[ "$actual_format" =~ ^[A-Za-z0-9]+$ && "$source_width" =~ ^[1-9][0-9]*$ &&
         "$source_height" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
      [ -n "$input_format" ] || input_format="$actual_format"
      [ "$input_format" = "$actual_format" ] || { rc=1; break; }
      input_dimensions+=("$(oriented_image_dimensions "$source_width" "$source_height" "$orientation")")
      source_frames=$((source_frames + 1))
    done <<< "$input_info"
    [ "$source_frames" -gt 0 ] || rc=1
    if [ "$rc" -ne 0 ]; then
      report_fail "$i"
      failures=$((failures + 1))
      progress_value "$dbusRef" "$counter" || { interrupted=true; break; }
      continue
    fi

    # Choose the derived output extension.
    if [ "$fmt" = "keep" ]; then
      coder="$input_format"
      out_ext="$(image_format_extension "$input_format")"
      if image_extension_matches_format "$ext" "$input_format"; then out_ext="$ext"; fi
    else
      out_ext="$fmt"
      case "$fmt" in jpg) coder=JPEG ;; webp) coder=WEBP ;; avif) coder=AVIF ;; esac
    fi
    if [ -z "$coder" ] || [ -z "$out_ext" ]; then
      report_fail "$i"
      failures=$((failures + 1))
      progress_value "$dbusRef" "$counter" || { interrupted=true; break; }
      continue
    fi

    OUTTMP=''
    OUTFILE="$outdir/$(affixed_filename "$stem" web "$out_ext")"

    n=1
    while [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; do
      OUTFILE="$outdir/$(affixed_filename "$stem" web "$out_ext" "$n")"
      n=$((n + 1))
    done

    OUTTMP="$(tmp_for_target "$OUTFILE")" || OUTTMP=""
    if [ -z "$OUTTMP" ]; then
      report_fail "$i"
      progress_value "$dbusRef" "$counter"
      continue
    fi
    rm -f -- "$OUTTMP" >/dev/null 2>&1 || true

    if [ -n "$OUTTMP" ] && [ "$rc" -eq 0 ]; then
      # Keep the established web policy: normalize EXIF orientation, strip
      # metadata, and do not convert color profiles or reinterpret pixels.
      magick - -auto-orient -strip -resize "$size" -quality "$quality" "$coder:$OUTTMP" \
        < "$i" >/dev/null 2>&1 || rc=$?
    else
      rc=1
    fi

    output_records=''
    if [ "$rc" -eq 0 ] && [ -s "$OUTTMP" ]; then
      output_records="$(publication_image_records "$OUTTMP" 2>/dev/null)" || rc=1
    else
      rc=1
    fi
    actual_frames=0
    while IFS= read -r record; do
      [ "$actual_frames" -lt "$source_frames" ] || { rc=1; break; }
      IFS='|' read -r actual_format actual_width actual_height _ _ _ <<< "$record"
      expected_format="$(image_format_class "$coder")"
      actual_format="$(image_format_class "$actual_format")"
      expected_dimensions="$(resize_fit_dimensions "${input_dimensions[actual_frames]}" "$max_width" "$max_height")"
      if [ "$actual_format" != "$expected_format" ] ||
         ! [[ "$actual_width" =~ ^[1-9][0-9]*$ && "$actual_height" =~ ^[1-9][0-9]*$ ]] ||
         [ "${actual_width}x${actual_height}" != "$expected_dimensions" ]; then
        rc=1
        break
      fi
      # -strip is the established web metadata policy, including ICC profiles.
      actual_frames=$((actual_frames + 1))
    done <<< "$output_records"
    [ "$actual_frames" -eq "$source_frames" ] || rc=1

    if progress_cancelled "$dbusRef"; then interrupted=true; rc=1; fi
    published=false
    while [ "$rc" -eq 0 ] && [ "$interrupted" != true ]; do
      if progress_cancelled "$dbusRef"; then interrupted=true; rc=1; break; fi
      if commit_tmp_to_target "$OUTTMP" "$OUTFILE" create >/dev/null 2>&1; then
        published=true
        break
      fi
      # Another KIM6 invocation may have claimed the free candidate after the
      # preflight loop. Keep collision numbering safe and retry only when that
      # exact entry is now occupied; other publication errors fail closed.
      if ! { [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; }; then break; fi
      OUTFILE="$outdir/$(affixed_filename "$stem" web "$out_ext" "$n")"
      n=$((n + 1))
      while [ -e "$OUTFILE" ] || [ -L "$OUTFILE" ]; do
        OUTFILE="$outdir/$(affixed_filename "$stem" web "$out_ext" "$n")"
        n=$((n + 1))
      done
    done
    if [ "$published" = true ]; then
      report_ok
    else
      report_fail "$i"
      failures=$((failures + 1))
    fi
    [ -z "$OUTTMP" ] || rm -f -- "$OUTTMP" >/dev/null 2>&1 || true
    [ "$interrupted" != true ] || break
    progress_value "$dbusRef" "$counter" || { interrupted=true; break; }
  done

  progress_close "$dbusRef"
  report_finish_dialog "$(gettext 'Kim')"
  [ "$interrupted" != true ] && [ "$failures" -eq 0 ]
}




# Create a safe, validated ImageMagick collage from the selected images.
#
# Options are action-local so the eventual Dolphin menu can expose presets
# without changing the dispatcher-wide argument contract.
action_pelemele() {
  local size='' tile='' overlap_percent='' color='' border_ratio='' rotation='' random_rotation=15
  local seed='' shadow=true requested='' mode='' output='' tmp='' ref='' tile_dir=''
  local width height columns rows overlap border angle file index=0 rc=0 record
  local -a files=() tiles=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --size|--tile|--overlap|--background|--border|--rotation|--random-rotation|--seed|--output)
        [ "$#" -ge 2 ] || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: missing option value.')"; return 2; }
        case "$1" in
          --size) size="$2" ;; --tile) tile="$2" ;; --overlap) overlap_percent="$2" ;;
          --background) color="$2" ;; --border) border_ratio="$2" ;; --rotation) rotation="$2" ;;
          --random-rotation) random_rotation="$2" ;; --seed) seed="$2" ;; --output) requested="$2" ;;
        esac
        shift 2 ;;
      --shadow) shadow=true; shift ;;
      --no-shadow) shadow=false; shift ;;
      --) shift; files+=("$@"); break ;;
      -*) kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: unknown option.')"; return 2 ;;
      *) files+=("$@"); break ;;
    esac
  done
  if ! collect_publication_inputs files "${files[@]}"; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: select regular, unambiguous image files.')"
    return 1
  fi
  [ -n "$size" ] || size="$(kdialog --inputbox "$(gettext 'Size of small images:')" '400x400')" || return 1
  [ -n "$tile" ] || tile="$(kdialog --inputbox "$(gettext 'Number of rows and columns:')" '5x4')" || return 1
  [ -n "$overlap_percent" ] || overlap_percent="$(kdialog --inputbox "$(gettext 'Overlapping ratio in percent:')" '15')" || return 1
  [ -n "$color" ] || color="$(kdialog --inputbox "$(gettext 'Background color:')" 'grey')" || return 1
  [ -n "$border_ratio" ] || border_ratio=2
  [[ "$size" =~ ^([1-9][0-9]{0,8})x([1-9][0-9]{0,8})$ ]] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: size must be WIDTHxHEIGHT.')"; return 1;
  }
  width="${BASH_REMATCH[1]}"; height="${BASH_REMATCH[2]}"
  [[ "$tile" =~ ^([1-9][0-9]{0,8})x([1-9][0-9]{0,8})$ ]] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: tile layout must be COLUMNSxROWS.')"; return 1;
  }
  columns="${BASH_REMATCH[1]}"; rows="${BASH_REMATCH[2]}"
  [[ "$overlap_percent" =~ ^[0-9]{1,2}$ && "$overlap_percent" -le 90 ]] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: overlap must be from 0 to 90 percent.')"; return 1;
  }
  [[ "$border_ratio" =~ ^[0-9]{1,2}$ && "$border_ratio" -le 50 ]] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: border must be from 0 to 50 percent.')"; return 1;
  }
  [[ "$random_rotation" =~ ^[0-9]{1,3}$ && "$random_rotation" -le 180 ]] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: random rotation must be from 0 to 180 degrees.')"; return 1;
  }
  if [ -n "$rotation" ]; then
    [[ "$rotation" =~ ^-?[0-9]{1,3}$ ]] && [ "$rotation" -ge -180 ] && [ "$rotation" -le 180 ] || {
      kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: rotation must be from -180 to 180 degrees.')"; return 1;
    }
  fi
  if [ -n "$seed" ]; then
    [[ "$seed" =~ ^[0-9]{1,9}$ ]] || { kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: seed must be an integer.')"; return 1; }
    RANDOM=$((seed % 32768))
  fi
  [[ "$color" != *$'\n'* && "$color" != *$'\r'* &&
     "$color" =~ ^[A-Za-z0-9#(),._%+[:blank:]-]{1,64}$ && "$color" != *'..'* ]] || {
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: invalid background color.')"; return 1;
  }
  if [ -z "$requested" ]; then
    requested="$(kdialog --getsavefilename "$HOME" '*.png')" || return 1
  fi
  [ -n "$requested" ] || return 1
  mode="$(choose_output_mode "$(gettext 'Kim')" "$(gettext 'Do you want to create a new collage?')")" || return 1
  case "$mode" in create|overwrite) ;; *) return 1 ;; esac
  if ! prepare_derived_target "$requested" png "$mode" "${files[@]}"; then
    kdialog --title "$(gettext 'Kim')" --error "$(gettext 'Collage: output destination is invalid or aliases a selected image.')"
    return 1
  fi
  output="$DERIVED_TARGET"; mode="$DERIVED_MODE"
  ref="$(progress_open "${#files[@]}" "$(gettext 'Kim - Initialising ...')")"
  if progress_cancelled "$ref"; then progress_close "$ref"; return 1; fi
  tmp="$(tmp_for_target "$output")" || { publication_fail "$ref" '' "$(gettext 'Collage: cannot create destination-local staging.')"; return 1; }
  tile_dir="${tmp%/*}/tiles"
  mkdir -p -- "$tile_dir" || { publication_fail "$ref" "$tmp" "$(gettext 'Collage: cannot create private staging.')"; return 1; }
  report_init
  overlap=$((width * overlap_percent / 100))
  border=$((width * border_ratio / 100))
  for file in "${files[@]}"; do
    index=$((index + 1))
    if ! progress_begin_item "$ref" "$(gettext 'Kim - Processing file: ')${file##*/}" || progress_cancelled "$ref"; then
      report_fail "$file"; report_finish_dialog "$(gettext 'Kim')"; publication_fail "$ref" "$tmp" "$(gettext 'Collage: interrupted before publication.')"; return 1
    fi
    if [ -n "$rotation" ]; then angle="$rotation"
    else angle=$((RANDOM % (random_rotation * 2 + 1) - random_rotation)); fi
    local tile_path="$tile_dir/tile_$index.png"
    if [ "$shadow" = true ]; then
      magick -- -[0] -resize "$size" -bordercolor white -border "$border" \
        -bordercolor grey60 -border 1 -background none -rotate "$angle" -background black \
        '(' +clone -shadow 60x4+4+4 ')' +swap -background none -flatten -depth 8 -quality 95 "PNG:$tile_path" \
        < "$file" >/dev/null 2>&1 || rc=$?
    else
      magick -- -[0] -resize "$size" -bordercolor white -border "$border" \
        -bordercolor grey60 -border 1 -background none -rotate "$angle" -depth 8 -quality 95 "PNG:$tile_path" \
        < "$file" >/dev/null 2>&1 || rc=$?
    fi
    if progress_cancelled "$ref"; then
      report_fail "$file"; report_finish_dialog "$(gettext 'Kim')"; publication_fail "$ref" "$tmp" "$(gettext 'Collage: interrupted before publication.')"; return 1
    fi
    local tile_records tile_frames=0 tile_format tile_width tile_height
    tile_records="$(publication_image_records "$tile_path" 2>/dev/null)" || rc=1
    while IFS= read -r record; do
      IFS='|' read -r tile_format tile_width tile_height _ <<< "$record"
      [ "$tile_format" = PNG ] && [[ "$tile_width" =~ ^[1-9][0-9]*$ && "$tile_height" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
      tile_frames=$((tile_frames + 1))
    done <<< "$tile_records"
    [ "$tile_frames" -eq 1 ] || rc=1
    if [ "$rc" -ne 0 ]; then
      report_fail "$file"; report_finish_dialog "$(gettext 'Kim')"; publication_fail "$ref" "$tmp" "$(gettext 'Collage: ImageMagick failed or produced an invalid tile.')"; return 1
    fi
    tiles+=("$tile_path")
    dimensions+=("$tile_width|$tile_height")
    report_ok
    progress_value "$ref" "$index"
  done
  if progress_cancelled "$ref"; then
    report_fail "${files[-1]}"; report_finish_dialog "$(gettext 'Kim')"; publication_fail "$ref" "$tmp" "$(gettext 'Collage: interrupted before publication.')"; return 1
  fi
  magick montage -background "$color" -tile "${columns}x${rows}" \
    -geometry "-${overlap}-${overlap}" -- "${tiles[@]}" "PNG:$tmp" >/dev/null 2>&1 || rc=$?
  local output_records output_frames=0 output_format output_width output_height
  output_records="$(publication_image_records "$tmp" 2>/dev/null)" || rc=1
  while IFS= read -r record; do
    IFS='|' read -r output_format output_width output_height _ <<< "$record"
    [ "$output_format" = PNG ] && [[ "$output_width" =~ ^[1-9][0-9]*$ && "$output_height" =~ ^[1-9][0-9]*$ ]] || { rc=1; break; }
    output_frames=$((output_frames + 1))
  done <<< "$output_records"
  [ "$output_frames" -eq 1 ] && [ -s "$tmp" ] || rc=1
  if [ "$rc" -ne 0 ]; then
    report_fail "$output"; report_finish_dialog "$(gettext 'Kim')"; publication_fail "$ref" "$tmp" "$(gettext 'Collage: generated output failed validation.')"; return 1
  fi
  if progress_cancelled "$ref"; then
    report_fail "$output"; report_finish_dialog "$(gettext 'Kim')"; publication_fail "$ref" "$tmp" "$(gettext 'Collage: interrupted before publication.')"; return 1
  fi
  if ! commit_tmp_to_target "$tmp" "$output" "$mode"; then
    report_fail "$output"; report_finish_dialog "$(gettext 'Kim')"; publication_fail "$ref" "$tmp" "$(gettext 'Collage: publication failed; existing files were preserved.')"; return 1
  fi
  progress_close "$ref"
  report_finish_dialog "$(gettext 'Kim')"
  true
}

# ---------------------------------------------------------------------------
# Actions outside the current consolidation packages
# ---------------------------------------------------------------------------

action_multiburst()      { :; }
action_other()           { :; }
action_sortbydate()      { :; }
action_treatment()       { :; }

# Video helpers are kept local to the video action so the shared image
# publication and KDialog contracts remain unchanged.
video_probe() {
  local path="$1" video_info format_info audio_info key value record
  video_info="$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=codec_name,width,height,duration,nb_frames,display_aspect_ratio:stream_tags=rotate:stream_side_data=rotation \
    -of default=noprint_wrappers=1 -i "$path" 2>/dev/null)" || return 1
  format_info="$(ffprobe -v error -show_entries format=format_name,duration \
    -of default=noprint_wrappers=1 -i "$path" 2>/dev/null)" || return 1
  audio_info="$(ffprobe -v error -select_streams a -show_entries stream=codec_name \
    -of default=noprint_wrappers=1:nokey=1 -i "$path" 2>/dev/null)" || return 1

  VIDEO_CODEC='' VIDEO_WIDTH='' VIDEO_HEIGHT='' VIDEO_DURATION='' VIDEO_FRAMES=''
  VIDEO_DAR='' VIDEO_ROTATION='0' VIDEO_FORMATS='' VIDEO_FORMAT_DURATION=''
  VIDEO_AUDIO_COUNT=0
  while IFS='=' read -r key value; do
    case "$key" in
      codec_name) VIDEO_CODEC="$value" ;;
      width) VIDEO_WIDTH="$value" ;;
      height) VIDEO_HEIGHT="$value" ;;
      duration) VIDEO_DURATION="$value" ;;
      nb_frames) VIDEO_FRAMES="$value" ;;
      display_aspect_ratio) VIDEO_DAR="$value" ;;
      TAG:rotate|rotation) VIDEO_ROTATION="$value" ;;
      format_name) VIDEO_FORMATS="$value" ;;
    esac
  done <<< "$video_info"
  while IFS='=' read -r key value; do
    case "$key" in
      format_name) VIDEO_FORMATS="$value" ;;
      duration) VIDEO_FORMAT_DURATION="$value" ;;
    esac
  done <<< "$format_info"
  while IFS= read -r record; do
    [ -n "$record" ] && VIDEO_AUDIO_COUNT=$((VIDEO_AUDIO_COUNT + 1))
  done <<< "$audio_info"

  [[ "$VIDEO_CODEC" =~ ^[A-Za-z0-9_]+$ && "$VIDEO_WIDTH" =~ ^[1-9][0-9]*$ &&
     "$VIDEO_HEIGHT" =~ ^[1-9][0-9]*$ && -n "$VIDEO_FORMATS" ]] || return 1
  [ -n "$VIDEO_FORMAT_DURATION" ] || VIDEO_FORMAT_DURATION="$VIDEO_DURATION"
  [[ "$VIDEO_FORMAT_DURATION" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  awk -v duration="$VIDEO_FORMAT_DURATION" 'BEGIN { exit !(duration > 0) }' || return 1
  if [ -n "$VIDEO_ROTATION" ] && [ "$VIDEO_ROTATION" != "0" ]; then
    if ! awk -v rotation="$VIDEO_ROTATION" 'BEGIN {
      if (rotation !~ /^-?[0-9]+([.][0-9]+)?$/) exit 1
      nearest = int((rotation + (rotation < 0 ? -45 : 45)) / 90)
      exit (rotation - nearest * 90 > 0.01 || rotation - nearest * 90 < -0.01)
    }'; then
      return 1
    fi
  fi
}

video_resolve_container() {
  local path="$1" requested="$2" extension formats="${3,,}"
  VIDEO_MUXER=''
  extension="${path##*.}"
  extension="${extension,,}"
  if [ "$requested" = mp4 ]; then
    VIDEO_MUXER=mp4
    VIDEO_EXTENSION=mp4
    return 0
  fi
  case "$extension" in
    mp4|m4v) [[ ",$formats," == *,mp4,* ]] && VIDEO_MUXER=mp4 ;;
    mov) [[ ",$formats," == *,mov,* ]] && VIDEO_MUXER=mov ;;
    mkv) [[ ",$formats," == *,matroska,* ]] && VIDEO_MUXER=matroska ;;
    webm) [[ ",$formats," == *,webm,* ]] && VIDEO_MUXER=webm ;;
    avi) [[ ",$formats," == *,avi,* ]] && VIDEO_MUXER=avi ;;
    flv) [[ ",$formats," == *,flv,* ]] && VIDEO_MUXER=flv ;;
    asf|wmv) [[ ",$formats," == *,asf,* ]] && VIDEO_MUXER=asf ;;
    ts|mts|m2ts) [[ ",$formats," == *,mpegts,* ]] && VIDEO_MUXER=mpegts ;;
    mpg|mpeg|vob) [[ ",$formats," == *,mpeg,* ]] && VIDEO_MUXER=mpeg ;;
    3gp|3g2) [[ ",$formats," == *,3gp,* ]] && VIDEO_MUXER=3gp ;;
    ogg|ogv) [[ ",$formats," == *,ogg,* ]] && VIDEO_MUXER=ogg ;;
    *) return 1 ;;
  esac
  [ -n "${VIDEO_MUXER:-}" ] || return 1
  VIDEO_EXTENSION="$extension"
  case "$VIDEO_MUXER:$VIDEO_CODEC" in
    webm:*|ogg:*) return 2 ;;
  esac
  return 0
}

video_terminate_owned_process() {
  local pid="$1" attempt
  kill -TERM "$pid" 2>/dev/null || true
  for ((attempt = 0; attempt < 20; attempt++)); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -KILL "$pid" 2>/dev/null || true
}

video_cleanup_owned_process() {
  local pid="${VIDEO_OWNED_FFMPEG_PID:-}"
  [ -n "$pid" ] || return 0
  video_terminate_owned_process "$pid"
  wait "$pid" 2>/dev/null || true
  VIDEO_OWNED_FFMPEG_PID=''
}

# Run one invocation-owned FFmpeg process while polling the shared stop
# predicate. The background command's PID is tracked directly; cleanup never
# searches for or signals other FFmpeg processes.
video_run_monitored() {
  local ref="$1" label="$2" duration="$3" error_file="$4"
  shift 4
  local fd pid key value rc=0 interrupted=0 percent read_rc fifo="${error_file%.stderr}.progress"
  local argument_index
  local -a command=("$@")
  mkfifo -- "$fifo" || return 1
  for ((argument_index = 0; argument_index < ${#command[@]} - 1; argument_index++)); do
    if [ "${command[$argument_index]}" = -progress ]; then
      command[argument_index + 1]="$fifo"
      break
    fi
  done
  ffmpeg "${command[@]}" > /dev/null 2>"$error_file" &
  pid=$!
  VIDEO_OWNED_FFMPEG_PID="$pid"
  exec {fd}< "$fifo"
  while :; do
    if IFS='=' read -r -t 0.2 key value <&"$fd"; then
      case "$key" in
        out_time_ms)
          if [[ "$value" =~ ^[0-9]+$ ]] && awk -v d="$duration" 'BEGIN { exit !(d > 0) }'; then
            percent="$(awk -v t="$value" -v d="$duration" 'BEGIN { p = int(t / 1000000 / d * 100); if (p > 100) p = 100; print p }')"
            if ! progress_label "$ref" "$label — ${percent}%"; then
              interrupted=1
              video_terminate_owned_process "$pid"
              break
            fi
          fi
          ;;
        progress) : ;;
      esac
    else
      read_rc=$?
      if [ "$read_rc" -le 128 ]; then break; fi
    fi
    if progress_cancelled "$ref"; then
      interrupted=1
      video_terminate_owned_process "$pid"
      break
    fi
  done
  exec {fd}<&-
  wait "$pid" || rc=$?
  VIDEO_OWNED_FFMPEG_PID=''
  rm -f -- "$fifo"
  [ "$interrupted" -eq 0 ] || return 130
  return "$rc"
}

video_count_records() {
  local selector="$1" path="$2" records record count=0
  records="$(ffprobe -v error -select_streams "$selector" -show_entries stream=index \
    -of default=noprint_wrappers=1:nokey=1 -i "$path" 2>/dev/null)" || return 1
  while IFS= read -r record; do
    [[ "$record" =~ ^[0-9]+$ ]] && count=$((count + 1))
  done <<< "$records"
  printf '%s\n' "$count"
}

video_format_has_token() {
  local token="$1" formats="${2,,}"
  [[ ",$formats," == *",$token,"* ]]
}

video_validate_output() {
  local output="$1" muxer="$2" codec="$3" max_width="$4" max_height="$5"
  local input_width="$6" input_height="$7" rotation="$8" input_duration="$9"
  local input_audio="${10}" input_dar="${11}" input_frames="${12}" output_formats output_duration
  local output_codec='' output_width='' output_height='' output_dar='' output_frames=''
  local video_count audio_count expected_codec output_extension="${output##*.}"
  video_probe "$output" || return 1
  output_codec="$VIDEO_CODEC" output_width="$VIDEO_WIDTH" output_height="$VIDEO_HEIGHT"
  output_dar="$VIDEO_DAR" output_frames="$VIDEO_FRAMES" output_formats="$VIDEO_FORMATS"
  output_duration="$VIDEO_FORMAT_DURATION"
  video_count="$(video_count_records v "$output")" || return 1
  audio_count="$(video_count_records a "$output")" || return 1
  [ "$video_count" -eq 1 ] || return 1
  [ "$audio_count" -eq "$input_audio" ] || return 1
  case "$codec" in libx264) expected_codec=h264 ;; libx265) expected_codec=hevc ;; *) return 1 ;; esac
  [ "$output_codec" = "$expected_codec" ] || return 1
  case "$muxer" in
    mp4|mov)
      video_format_has_token mp4 "$output_formats" || video_format_has_token mov "$output_formats" || return 1 ;;
    matroska|webm|avi|flv|asf|mpegts|mpeg|ogg)
      video_format_has_token "$muxer" "$output_formats" || return 1 ;;
    3gp)
      video_format_has_token 3gp "$output_formats" || video_format_has_token 3g2 "$output_formats" || return 1 ;;
    *) return 1 ;;
  esac
  case "$muxer:$output_extension" in
    mp4:mp4|mov:mov|mp4:m4v|matroska:mkv|webm:webm|avi:avi|flv:flv|asf:asf|asf:wmv|mpegts:ts|mpegts:mts|mpegts:m2ts|mpeg:mpg|mpeg:mpeg|mpeg:vob|3gp:3gp|3gp:3g2|ogg:ogg|ogg:ogv) ;;
    *) return 1 ;;
  esac
  [[ "$output_width" =~ ^[1-9][0-9]*$ && "$output_height" =~ ^[1-9][0-9]*$ ]] || return 1
  (( output_width <= max_width && output_height <= max_height )) || return 1
  (( output_width <= input_width && output_height <= input_height )) || return 1
  (( output_width % 2 == 0 && output_height % 2 == 0 )) || return 1
  if awk -v input="$input_dar" -v output="$output_dar" -v rotation="$rotation" \
      -v input_width="$input_width" -v input_height="$input_height" \
      -v output_width="$output_width" -v output_height="$output_height" 'BEGIN {
        if (input ~ /^[0-9]+:[0-9]+$/) { split(input, a, ":"); x = a[1] / a[2] }
        else x = input_width / input_height
        if (output ~ /^[0-9]+:[0-9]+$/) { split(output, b, ":"); y = b[1] / b[2] }
        else y = output_width / output_height
        if (rotation == 90 || rotation == -90 || rotation == 270 || rotation == -270) x = 1 / x
        difference = x > y ? x - y : y - x
        exit !(x > 0 && difference <= x * 0.025)
      }'; then :; else return 1; fi
  if [[ "$output_frames" =~ ^[1-9][0-9]*$ ]] && [[ "$input_frames" =~ ^[1-9][0-9]*$ ]]; then
    [ "$output_frames" = "$input_frames" ] || return 1
  fi
  awk -v input="$input_duration" -v output="$output_duration" 'BEGIN {
    if (input !~ /^[0-9]+([.][0-9]+)?$/ || output !~ /^[0-9]+([.][0-9]+)?$/) exit 1
    difference = input - output; if (difference < 0) difference = -difference
    tolerance = input * 0.02; if (tolerance < 0.125) tolerance = 0.125
    exit !(difference <= tolerance)
  }' || return 1
}

video_item_error() {
  local file="$1" detail="$2"
  report_fail "$file — $detail"
}

video_ffmpeg_error_summary() {
  local file="$1" line
  [ -f "$file" ] || return 0
  while IFS= read -r line; do
    case "${line,,}" in
      *error*|*invalid*|*failed*|*unknown*|*not\ supported*|*could\ not*)
        printf '%s' "${line:0:240}"
        return 0
        ;;
    esac
  done < "$file"
  return 0
}

action_video() {
  local size='' crf='' codec='' container='' option='' mode rc=0 ref=''
  local max_width max_height source input_ext muxer ext target stem directory stage error_file
  local source_width source_height display_width display_height rotation duration formats dar
  local audio_count encoder_output label index=0 retry target_number
  local -a raw_files=() files=() ffmpeg_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --size|--crf|--codec|--container)
        [ "$#" -ge 2 ] || { progress_error "$(gettext 'Video options require a value.')"; return 2; }
        option="$1"; shift
        case "$option" in
          --size) [ -z "$size" ] || { progress_error "$(gettext 'Video size was specified more than once.')"; return 2; }; size="$1" ;;
          --crf) [ -z "$crf" ] || { progress_error "$(gettext 'Video CRF was specified more than once.')"; return 2; }; crf="$1" ;;
          --codec) [ -z "$codec" ] || { progress_error "$(gettext 'Video codec was specified more than once.')"; return 2; }; codec="$1" ;;
          --container) [ -z "$container" ] || { progress_error "$(gettext 'Video container was specified more than once.')"; return 2; }; container="$1" ;;
        esac
        shift
        ;;
      --) shift; raw_files+=("$@"); break ;;
      -*) progress_error "$(gettext 'Unknown video option:') $1"; return 2 ;;
      *) raw_files+=("$@"); break ;;
    esac
  done
  case "$size" in hd720) max_width=1280; max_height=720 ;; hd1080) max_width=1920; max_height=1080 ;;
    *) progress_error "$(gettext 'Video size must be hd720 or hd1080.')"; return 2 ;; esac
  case "$crf" in 17|23|29) : ;; *) progress_error "$(gettext 'Video CRF must be 17, 23 or 29.')"; return 2 ;; esac
  case "$codec" in libx264|libx265) : ;; *) progress_error "$(gettext 'Video codec must be libx264 or libx265.')"; return 2 ;; esac
  case "$container" in orig|mp4) : ;; *) progress_error "$(gettext 'Video container must be orig or mp4.')"; return 2 ;; esac
  if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
    progress_error "$(gettext 'FFmpeg and ffprobe are required for video transcoding.')"; return 1
  fi
  if ! encoder_output="$(ffmpeg -hide_banner -encoders 2>/dev/null)" ||
     ! [[ "$encoder_output" =~ [[:space:]]${codec}[[:space:]] ]]; then
    progress_error "$(gettext 'The selected FFmpeg video encoder is unavailable:') $codec"; return 1
  fi
  if ! collect_publication_inputs files "${raw_files[@]}"; then
    progress_error "$(gettext 'Video selection is empty or contains an unsafe, aliased, linked or invalid source.')"; return 1
  fi
  mode="$(choose_output_mode "$(gettext 'Kim — Video')" "$(gettext 'Create transcoded copies or replace the selected videos after validation?')")"
  [ "$mode" != cancel ] || return 1
  report_init
  ref="$(progress_open "${#files[@]}" "$(gettext 'Kim — Initialising video transcode…')")" || return 1
  trap 'video_cleanup_owned_process; exit 130' INT TERM HUP

  for source in "${files[@]}"; do
    index=$((index + 1))
    label="$(gettext 'Kim — Transcoding video:') $index/${#files[@]}: ${source##*/}"
    if ! progress_begin_item "$ref" "$label"; then
      video_item_error "$source" "$(gettext 'interrupted before processing')"
      progress_close "$ref" || true; report_finish_dialog "$(gettext 'Kim')"; return 1
    fi
    if ! video_probe "$source"; then
      video_item_error "$source" "$(gettext 'could not inspect a valid video stream and container')"
      progress_value "$ref" "$index" || { report_finish_dialog "$(gettext 'Kim')"; return 1; }
      continue
    fi
    source_width="$VIDEO_WIDTH" source_height="$VIDEO_HEIGHT" rotation="$VIDEO_ROTATION"
    duration="$VIDEO_FORMAT_DURATION" audio_count="$VIDEO_AUDIO_COUNT" formats="$VIDEO_FORMATS" dar="$VIDEO_DAR"
    if [ "$rotation" = 90 ] || [ "$rotation" = -90 ] || [ "$rotation" = 270 ] || [ "$rotation" = -270 ]; then
      display_width="$source_height"; display_height="$source_width"
    else
      display_width="$source_width"; display_height="$source_height"
    fi
    if video_resolve_container "$source" "$container" "$formats"; then
      rc=0
    else
      rc=$?
      if [ "$rc" -eq 2 ]; then
        video_item_error "$source" "$(gettext 'the selected codec is incompatible with the original container; choose MP4 explicitly')"
      else
        video_item_error "$source" "$(gettext 'the original container cannot be identified safely from the file extension')"
      fi
      progress_value "$ref" "$index" || { report_finish_dialog "$(gettext 'Kim')"; return 1; }
      continue
    fi
    muxer="$VIDEO_MUXER"; ext="$VIDEO_EXTENSION"
    if [ "$mode" = overwrite ] && [ "$container" = mp4 ]; then
      input_ext="${source##*.}"
      input_ext="${input_ext,,}"
      if [ "$input_ext" != mp4 ] && [ "$input_ext" != m4v ]; then
        video_item_error "$source" "$(gettext 'MP4 cannot replace a source with a different filename extension; choose Create new files')"
        progress_value "$ref" "$index" || { report_finish_dialog "$(gettext 'Kim')"; return 1; }
        continue
      fi
    fi
    directory="${source%/*}"; [ "$directory" != "$source" ] || directory="$PWD"
    if [ "$mode" = overwrite ]; then
      target="$source"
    else
      stem="${source##*/}"
      if [[ "$stem" == *.* ]]; then stem="${stem%.*}"; fi
      target="$directory/${stem}-transcoded.$ext"
      target_number=1
      while [ -e "$target" ] || [ -L "$target" ]; do
        target="$directory/${stem}-transcoded_${target_number}.$ext"
        target_number=$((target_number + 1))
      done
    fi
    stage="$(tmp_for_target "$target")" || {
      video_item_error "$source" "$(gettext 'could not create destination-local staging')"
      progress_value "$ref" "$index" || { report_finish_dialog "$(gettext 'Kim')"; return 1; }
      continue
    }
    error_file="${stage%/*}/ffmpeg.stderr"
    if progress_cancelled "$ref"; then
      video_item_error "$source" "$(gettext 'interrupted before encoding')"
      progress_close "$ref" || true; report_finish_dialog "$(gettext 'Kim')"; return 1
    fi
    ffmpeg_args=(-hide_banner -v error -nostdin -n -progress pipe:1 -nostats -i "$source" -map 0:v:0 -map '0:a?' \
      -map_metadata 0 -map_chapters 0 -vf "scale=w='min(iw,$max_width)':h='min(ih,$max_height)':force_original_aspect_ratio=decrease:force_divisible_by=2" \
      -fps_mode passthrough -c:v "$codec" -crf "$crf" -c:a copy)
    if [ "$muxer" = mp4 ]; then ffmpeg_args+=(-movflags +faststart); fi
    ffmpeg_args+=(-f "$muxer" "$stage")
    rc=0
    video_run_monitored "$ref" "$label" "$duration" "$error_file" "${ffmpeg_args[@]}" || rc=$?
    if [ "$rc" -eq 130 ]; then
      video_item_error "$source" "$(gettext 'interrupted during encoding; no output was published')"
      progress_close "$ref" || true; report_finish_dialog "$(gettext 'Kim')"; return 1
    fi
    if [ "$rc" -ne 0 ] || [ ! -s "$stage" ]; then
      local ffmpeg_reason
      ffmpeg_reason="$(video_ffmpeg_error_summary "$error_file")"
      video_item_error "$source" "$(gettext 'FFmpeg failed or produced no complete output')${ffmpeg_reason:+: $ffmpeg_reason}"
      rm -f -- "$stage" "$error_file"
      progress_value "$ref" "$index" || { report_finish_dialog "$(gettext 'Kim')"; return 1; }
      continue
    fi
    if progress_cancelled "$ref"; then
      video_item_error "$source" "$(gettext 'interrupted after encoding; no output was published')"
      progress_close "$ref" || true; report_finish_dialog "$(gettext 'Kim')"; return 1
    fi
    if video_validate_output "$stage" "$muxer" "$codec" "$max_width" "$max_height" \
        "$display_width" "$display_height" "$rotation" "$duration" "$audio_count" "$dar" "$VIDEO_FRAMES"; then rc=0; else rc=1; fi
    if [ "$rc" -ne 0 ]; then
      video_item_error "$source" "$(gettext 'output validation failed: wrong container, codec, dimensions, streams, duration or incomplete decode')"
      rm -f -- "$stage" "$error_file"
      progress_value "$ref" "$index" || { report_finish_dialog "$(gettext 'Kim')"; return 1; }
      continue
    fi
    # Decode each staged stream completely before publication. The same owned
    # process monitor enforces cancellation and targets only this child.
    rc=0
    video_run_monitored "$ref" "$label" "$duration" "$error_file" -hide_banner -v error -xerror -nostdin \
      -progress pipe:1 -nostats -i "$stage" -map 0:v:0 -map '0:a?' -f null - || rc=$?
    if [ "$rc" -eq 130 ]; then
      video_item_error "$source" "$(gettext 'interrupted during output validation; no output was published')"
      progress_close "$ref" || true; report_finish_dialog "$(gettext 'Kim')"; return 1
    fi
    if [ "$rc" -ne 0 ] || progress_cancelled "$ref"; then
      video_item_error "$source" "$(gettext 'output did not fully decode or processing was interrupted')"
      rm -f -- "$stage" "$error_file"
      [ "$rc" -eq 0 ] || { progress_close "$ref" || true; report_finish_dialog "$(gettext 'Kim')"; return 1; }
      progress_close "$ref" || true; report_finish_dialog "$(gettext 'Kim')"; return 1
    fi
    retry=0
    while :; do
      if progress_cancelled "$ref"; then
        video_item_error "$source" "$(gettext 'interrupted immediately before publication')"
        rm -f -- "$stage" "$error_file"; progress_close "$ref" || true
        report_finish_dialog "$(gettext 'Kim')"; return 1
      fi
      if commit_tmp_to_target "$stage" "$target" "$mode"; then
        rm -f -- "$error_file"
        report_ok
        break
      fi
      if [ "$mode" = create ] && { [ -e "$target" ] || [ -L "$target" ]; } && [ "$retry" -lt 1000 ]; then
        retry=$((retry + 1))
        while :; do
          target="$directory/${stem}-transcoded_${target_number}.$ext"
          target_number=$((target_number + 1))
          [ ! -e "$target" ] && [ ! -L "$target" ] && break
        done
        continue
      fi
      video_item_error "$source" "$(gettext 'publication failed; existing files were preserved')"
      rm -f -- "$stage" "$error_file"
      break
    done
    progress_value "$ref" "$index" || { report_finish_dialog "$(gettext 'Kim')"; return 1; }
  done
  progress_close "$ref"
  report_finish_dialog "$(gettext 'Kim')"
  [ "$REPORT_FAIL" -eq 0 ]
}

# ---------------------------------------------------------------------------
# Router
# ---------------------------------------------------------------------------

usage() {
  cat <<EOF
Usage: $PROG <command> [arguments...]

Commands:

  album <dir> <files...>
      Build a validated multi-page PDF from selected images on A4 pages.
      Offers eight portrait/landscape album layouts.

  compress <quality> <dir> <files...>
      Compress images to the given quality (1-100).
      overwrite mode modifies originals.
      Create mode writes *_compressed files into <dir>.

  convert <format> <files...>
      Convert images to another format.
      overwrite mode overwrites existing converted outputs
      but never deletes original source files.

  flipflop <mode> <files...>
      Flip or flop images.

  gallery <dir> <files...>
      Create an HTML image gallery.
      Prompts for an output directory and generates:
        images/   resized images (800x800)
        thumbs/   thumbnails (200x200)
        index.html

  multiburst <files...>
      Not implemented yet.

  other <files...>
      Not implemented yet.

  pelemele <files...>
      Build a validated PNG collage. Options: --size WxH, --tile CxR,
      --overlap PERCENT, --background COLOR, --border PERCENT,
      --rotation DEGREES, --random-rotation DEGREES, --seed INTEGER,
      --shadow|--no-shadow, --output FILE, then -- and image files.

  print <dir> <files...>
      Create a validated multi-page print PDF with seven layouts.
      Uses A3 portrait pages for the 10x15, 11.5x15 and 13x18 cm presets;
      other presets use A4 pages.

  tiffjoin [--output PATH] [--] <files...>
      Join selected image frames in order into a TIFF file.
      Supports destination selection and safe create/overwrite policy.

  animate [--delay CENTISECONDS] [--loop COUNT] [--output PATH] [--] <files...>
      Create an ordered animated GIF. Loop count 0 repeats forever.
      Delay defaults to 100 centiseconds (one second); loop defaults to 0.

  rename <mode> <files...>
      Rename images using filename rules.
      Supports EXIF-based renaming and safety checks.

  resize <scale> <dir> <files...>
      Resize images to the given scale (e.g. 800x800, 50%).
      overwrite mode modifies originals (metadata preserved best-effort).
      Create mode writes *_resized files into <dir>.

  resizeandsend [--size full|WIDTHxHEIGHT] [--] <files...>
      Resize selected images for email and open your mail client
      with validated resized copies attached. Presets: 1600, 1200, 800,
      600 and 300 square bounds. Omit --size to show the existing dialog.
      Successful attachments remain in XDG_DATA_HOME/kim6/email-attachments
      (or ~/.local/share/kim6/email-attachments when XDG_DATA_HOME is unset)
      until you remove them, because mail clients may read them asynchronously.

  rotate <angle|EXIF> <files...>
      Rotate images by a fixed angle, or auto-orient using EXIF.

  rotatewithexif <files...>
      Rotate images using EXIF orientation.

  sortbydate <files...>
      Not implemented yet.

  stripmeta <files...>
      Strip metadata while preserving ICC profile and orientation.

  treatment <mode> <files...>
      Not implemented yet.

  video --size hd720|hd1080 --crf 17|23|29 --codec libx264|libx265
        --container orig|mp4 -- <files...>
      Safely transcode each selected video with FFmpeg. Original-container
      mode fails when the chosen codec/streams are incompatible; it never
      silently changes to MP4. KIM_POLICY or the batch-wide dialog selects
      create versus authorized overwrite.

  webexport <dir> <files...>
      Prepare images for web use.
      Prompts for max size and quality. Existing dispatcher form remains supported.
  webexport [--size WIDTHxHEIGHT] [--quality 1..100] [--format jpg|webp|avif|keep]
            [--output-dir DIR] -- <files...>
      Action-local arguments expose presets for future Dolphin menu routing.
      Web export always creates derived files; KIM_POLICY never replaces originals.
      Always creates distinct *_web files into <dir>, regardless of KIM_POLICY.
      Output format uses KIM_WEB_FORMAT (default: jpg).

Environment:
  KIM_POLICY=create
      Always create new files (no overwrites).

  KIM_POLICY=overwrite
      Overwrite originals (use with care).

  If KIM_POLICY is unset or any other value:
      Prompt for Create vs overwrite (default).

  KIM_WEB_QUALITY=1..100
      Default value for the web-export quality prompt.
      Does not suppress the prompt. Fallback: 75.

  KIM_WEB_FORMAT=jpg|webp|avif|keep
      Output format for webexport. Default: jpg.
      keep uses the source file extension.
EOF
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  load_kim_config
  cmd="$1"
  shift || true

  case "$cmd" in
    album)           mk_workdir; action_album "$@" ;;
    animate)         mk_workdir; action_animate "$@" ;;
    compress)        mk_workdir; action_compress "$@" ;;
    convert)         mk_workdir; action_convert "$@" ;;
    flipflop)        mk_workdir; action_flipflop "$@" ;;
    gallery)         mk_workdir; action_gallery "$@" ;;
    multiburst)      mk_workdir; action_multiburst "$@" ;;
    other)           mk_workdir; action_other "$@" ;;
    pelemele)        mk_workdir; action_pelemele "$@" ;;
    print)           mk_workdir; action_print "$@" ;;
    rename)          mk_workdir; action_rename "$@" ;;
    resize)          mk_workdir; action_resize "$@" ;;
    resizeandsend)   mk_workdir; action_resizeandsend "$@" ;;
    rotate)          mk_workdir; action_rotate "$@" ;;
    rotatewithexif)  mk_workdir; action_rotatewithexif "$@" ;;
    sortbydate)      mk_workdir; action_sortbydate "$@" ;;
    stripmeta)       mk_workdir; action_stripmeta "$@" ;;
    tiffjoin)        mk_workdir; action_tiffjoin "$@" ;;
    treatment)       mk_workdir; action_treatment "$@" ;;
    video)           mk_workdir; action_video "$@" ;;
    webexport)       mk_workdir; action_webexport "$@" ;;
    help|-h|--help)  usage ;;
    *) die "Unknown command: $cmd" ;;
  esac
}

main "$@"

