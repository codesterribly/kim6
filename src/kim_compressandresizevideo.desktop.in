[Desktop Entry]
Icon=video-x-generic
Type=Service
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=video/*;
X-KDE-Protocol=file
Actions=Videohd108017265mp4;Videohd108023265mp4;Videohd108029265mp4;Videohd72017265mp4;Videohd72023265mp4;Videohd72029265mp4;
_X-KDE-Submenu=KIM6 — Convert Video: H.265
X-KIM6-Managed=true

[Desktop Action Videohd108017265mp4]
Icon=image-x-generic
_Name=1080p • High Quality • MP4
Exec=kim_all video --size hd1080 --crf 17 --codec libx265 --container mp4 -- %F

