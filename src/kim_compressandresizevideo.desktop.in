[Desktop Entry]
Type=Service
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=video/*;
X-KDE-Protocol=file
Actions=Videohd72017265orig;Videohd72017265mp4;Videohd72017264orig;Videohd72017264mp4;Videohd72023265orig;Videohd72023265mp4;Videohd72023264orig;Videohd72023264mp4;Videohd72029265orig;Videohd72029265mp4;Videohd72029264orig;Videohd72029264mp4;Videohd108017265orig;Videohd108017265mp4;Videohd108017264orig;Videohd108017264mp4;Videohd108023265orig;Videohd108023265mp4;Videohd108023264orig;Videohd108023264mp4;Videohd108029265orig;Videohd108029265mp4;Videohd108029264orig;Videohd108029264mp4;Manual;License;About;
_X-KDE-Submenu=KIM6 — Video transcoding
X-KIM6-Managed=true

[Desktop Action Videohd72017265orig]
_Name=Transcode 720 good H.265 (original container)
Exec=kim_all video --size hd720 --crf 17 --codec libx265 --container orig -- %F

[Desktop Action Videohd72017265mp4]
_Name=Transcode 720 good H.265 (MP4)
Exec=kim_all video --size hd720 --crf 17 --codec libx265 --container mp4 -- %F

[Desktop Action Videohd72017264orig]
_Name=Transcode 720 good H.264 (original container)
Exec=kim_all video --size hd720 --crf 17 --codec libx264 --container orig -- %F

[Desktop Action Videohd72017264mp4]
_Name=Transcode 720 good H.264 (MP4)
Exec=kim_all video --size hd720 --crf 17 --codec libx264 --container mp4 -- %F

[Desktop Action Videohd72023265orig]
_Name=Transcode 720 medium H.265 (original container)
Exec=kim_all video --size hd720 --crf 23 --codec libx265 --container orig -- %F

[Desktop Action Videohd72023265mp4]
_Name=Transcode 720 medium H.265 (MP4)
Exec=kim_all video --size hd720 --crf 23 --codec libx265 --container mp4 -- %F

[Desktop Action Videohd72023264orig]
_Name=Transcode 720 medium H.264 (original container)
Exec=kim_all video --size hd720 --crf 23 --codec libx264 --container orig -- %F

[Desktop Action Videohd72023264mp4]
_Name=Transcode 720 medium H.264 (MP4)
Exec=kim_all video --size hd720 --crf 23 --codec libx264 --container mp4 -- %F

[Desktop Action Videohd72029265orig]
_Name=Transcode 720 smaller file H.265 (original container)
Exec=kim_all video --size hd720 --crf 29 --codec libx265 --container orig -- %F

[Desktop Action Videohd72029265mp4]
_Name=Transcode 720 smaller file H.265 (MP4)
Exec=kim_all video --size hd720 --crf 29 --codec libx265 --container mp4 -- %F

[Desktop Action Videohd72029264orig]
_Name=Transcode 720 smaller file H.264 (original container)
Exec=kim_all video --size hd720 --crf 29 --codec libx264 --container orig -- %F

[Desktop Action Videohd72029264mp4]
_Name=Transcode 720 smaller file H.264 (MP4)
Exec=kim_all video --size hd720 --crf 29 --codec libx264 --container mp4 -- %F

[Desktop Action Videohd108017265orig]
_Name=Transcode 1080 good H.265 (original container)
Exec=kim_all video --size hd1080 --crf 17 --codec libx265 --container orig -- %F

[Desktop Action Videohd108017265mp4]
