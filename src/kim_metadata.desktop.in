[Desktop Entry]
Type=Service
Icon=document-properties
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;
X-KDE-Protocol=file
Actions=01Rename;02AdjustCaptureTime;03DateSync;04SetCopyright;05StripMetadata;06StripAI;07StripGPS;
_X-KDE-Submenu=KIM6 — Organize/Metadata
X-KIM6-Managed=true

[Desktop Action 01Rename]
_Name=Rename Images…
Exec=kim_all rename interactive -- %F

[Desktop Action 02AdjustCaptureTime]
_Name=Adjust camera timestamps…
Exec=kim_all timeshift --interactive -- %F

[Desktop Action 03DateSync]
_Name=Synchronize photo/file dates…
Exec=kim_all datesync --interactive -- %F

[Desktop Action 04SetCopyright]
_Name=Set creator and copyright…
Exec=kim_all copyright --interactive -- %F

[Desktop Action 06StripAI]
_Name=Strip AI Metadata…
Exec=kim_all stripmeta --mode ai -- %F

[Desktop Action 07StripGPS]
_Name=Strip GPS Metadata…
Exec=kim_all stripmeta --mode gps -- %F

[Desktop Action 05StripMetadata]
_Name=Strip Metadata…
Exec=kim_all stripmeta -- %F
