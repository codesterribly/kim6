[Desktop Entry]
Type=Service
Icon=document-properties
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/*;image/vnd.adobe.photoshop;application/x-photoshop;
X-KDE-Protocol=file
Actions=01Rename;02SetCaptureDate;02AdjustCaptureTime;03DateSync;03CaptureFromFile;04SetCopyright;05StripMetadata;06StripAI;07StripGPS;
_X-KDE-Submenu=KIM6 — Organize/Metadata
X-KIM6-Managed=true

[Desktop Action 01Rename]
Icon=edit-rename
_Name=Rename Images…
Exec=kim_all rename interactive -- %F

[Desktop Action 02AdjustCaptureTime]
Icon=image-x-generic
_Name=Adjust Photo Capture Date…
Exec=kim_all timeshift --interactive -- %F

[Desktop Action 03DateSync]
Icon=view-calendar-day
_Name=Set File Date from Photo Capture Date…
Exec=kim_all datesync --direction exif-to-file --interactive -- %F

[Desktop Action 04SetCopyright]
Icon=document-edit
_Name=Set creator and copyright…
Exec=kim_all copyright --interactive -- %F

[Desktop Action 06StripAI]
Icon=document-properties
_Name=Strip AI Metadata
Exec=kim_all stripmeta --mode ai --interactive -- %F

[Desktop Action 07StripGPS]
Icon=document-properties
_Name=Strip GPS Metadata
Exec=kim_all stripmeta --mode gps --interactive -- %F

[Desktop Action 05StripMetadata]
Icon=document-properties
_Name=Strip Metadata
Exec=kim_all stripmeta --interactive -- %F

[Desktop Action 02SetCaptureDate]
Icon=view-calendar-day
_Name=Set Photo Capture Date…
Exec=kim_all capturedate --interactive -- %F

[Desktop Action 03CaptureFromFile]
Icon=view-calendar-day
_Name=Set Photo Capture Date from File Date…
Exec=kim_all datesync --direction file-to-exif --interactive -- %F
