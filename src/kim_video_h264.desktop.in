[Desktop Entry]
Icon=video-x-generic
Type=Service
Name=KIM6
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=video/*;
X-KDE-Protocol=file
Actions=Videohd108017264mp4;Videohd108023264mp4;Videohd108029264mp4;Videohd72017264mp4;Videohd72023264mp4;Videohd72029264mp4;
_X-KDE-Submenu=KIM6 — Convert Video: H.264
X-KIM6-Managed=true

[Desktop Action Videohd108017264mp4]
Icon=image-x-generic
_Name=1080p • High Quality • MP4
Exec=kim_all video --size hd1080 --crf 17 --codec libx264 --container mp4 -- %F

[Desktop Action Videohd108023264mp4]
